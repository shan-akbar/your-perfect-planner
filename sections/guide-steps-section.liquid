<style>
    .main-container {
        padding: 40px 0;
        overflow: hidden;
        width: 100%;
        background-color: #fdf1f0;
    }

    .carousal-viewport {
        overflow: hidden;
        width: 100%;
        max-width: 1000px; 
        margin: 0 auto;
        position: relative;
    }

    .carousal-container {
        display: flex;
        transition: transform 0.5s ease-in-out;
        width: max-content;
    }

    .inner-container {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        padding: 0 20px;
        flex-shrink: 0;
        width: 100%; 
        box-sizing: border-box;
        gap: 45px;
    }

    #InfiniteSlider-{{ section.id }} .inner-container {
        width: 1000px; 
    }

    .image-area img {
        width: 100%;
        max-width: 180px;
        height: auto;
        object-fit: contain;
        margin-right: 20px;
    }

    .text-area {
        display: flex;
        flex-direction: column;
        text-align: left;
    }

    .text-area .text, .text-area .s-text {
        font-size: 45px;
        color: #ff4545;
        font-weight: 500;
        margin: 0;
        line-height: normal;
    }
    .image-area img "{block.id}"{
        width: 100%;
        max-width: 180px;
        height: auto;
        object-fit: contain;
        margin-right: 20px;
    }

    {% for block in section.blocks %}
        img.img-{{ block.id }} {
            max-width: {{ block.settings.image_width }}px !important; 
        }
    {% endfor %}

    

    @media screen and (max-width: 800px) {
        .carousal-viewport {
            max-width: 100vw;
        }
        #InfiniteSlider-{{ section.id }} .inner-container {
            width: 100vw;
            flex-direction: row;
            text-align: center;
            gap: 30px;
        }
        .image-area img {
            margin-right: 0;
            margin-bottom: 10px;
        }
        .inner-container{
            gap: 13px !important;
        }
    }
    @media screen and (max-width: 1024px){
        .text-area .text, 
        .text-area .s-text {
            font-size: 37px;
            color: #ff4545;
            font-weight: 500;
            margin: 0;  
        }
    }
    @media screen and (max-width: 769px){
        .text-area .text, 
        .text-area .s-text {
            font-size: 35px;
            color: #ff4545;
            font-weight: 500;
            margin: 0;  
        }
    }
    @media screen and (max-width: 600px){
        .text-area .text, 
        .text-area .s-text {
            font-size: 27px;
            color: #ff4545;
            font-weight: 500;
            margin: 0;  
        }
        .inner-container{
            gap: 22px
        }
    }
    @media screen and (max-width: 426px){
        .text-area .text{
            font-size: 21px;
            line-height: normal;
        } 
        .text-area .s-text {
            font-size: 19px;
            font-weight: 500;
            margin: 0;  
            line-height: normal;
        }
        .inner-container{
            gap: 15px
        }
    }
    @media screen and (max-width: 380px){
        .text-area .text{
            font-size: 20px;
            line-height: normal;
        } 
        .text-area .s-text {
            font-size: 18px;
            font-weight: 500;  
            margin: 0;  
            line-height: normal;
        }
    }
</style>
<div class="main-container" style="background-color: #fdf1f0">
    <div class="carousal-viewport">
        <div class="carousal-container" id="InfiniteSlider-{{ section.id }}">
        {% for block in section.blocks %}
            <div class="inner-container">
                <div class="image-area">
                    {%- capture custom_class -%}img-{{ block.id }}{%- endcapture -%}
                                {% if block.settings.image !=blank %}
                                    {{ block.settings.image | image_url: width: 400 | image_tag: class: custom_class, loading: lazy }}
                                {% endif %}
                </div>
                <div class="text-area">
                    <div class="text">
                    {{ block.settings.text }}
                    </div>
                    <div class="s-text">
                        {{ block.settings.text1 }}
                    </div>
                </div>
            </div>
        {% endfor %}
        </div>
    </div>
</div>    
{% schema %}
{
    "name": "Guide-Steps",
    "settings": [],
    "blocks":[
        {
            "type": "Add-Step",
            "name": "Add-Step",
            "settings":[
                {
                    "type": "image_picker",
                    "id": "image",
                    "label": "Image"
                },
                {
                    "type": "text",
                    "id": "text",
                    "label": "Add Step",
                    "default": "STEP Number"
                },
                {
                    "type": "text",
                    "id": "text1",
                    "label": "Add Text",
                    "default": "Description"
                },
                {
                    "type": "range",
                    "id": "image_width",
                    "min": 50,
                    "max": 400,
                    "step": 5,
                    "unit": "px",
                    "label": "Custom Image Width",
                    "default": 180
                }
            ]

        }
    ],
    "presets": [
        {
           "name" : "Guide-Steps"
        }
    ]
}
{% endschema %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const track = document.getElementById('InfiniteSlider-{{ section.id }}');
        const items = track.querySelectorAll('.inner-container');
        if (items.length === 0) return;

        // Clone first and last items for seamless looping
        const firstClone = items[0].cloneNode(true);
        const lastClone = items[items.length - 1].cloneNode(true);
        track.appendChild(firstClone);
        track.prepend(lastClone);

        let counter = 1;
        let size = items[0].clientWidth;

        // Set initial position
        track.style.transform = `translateX(${-size * counter}px)`;

        function startSlider() {
            setInterval(() => {
                if (counter >= items.length + 1) return;
                track.style.transition = "transform 0.5s ease-in-out";
                counter++;
                track.style.transform = `translateX(${-size * counter}px)`;
            }, 3000); // 2 seconds interval
        }

        track.addEventListener('transitionend', () => {
            if (items[counter - 1] && items[counter - 1] === firstClone || counter > items.length) {
                track.style.transition = "none";
                counter = 1;
                track.style.transform = `translateX(${-size * counter}px)`;
            }
        });

        // Re-calculate size on window resize
        window.addEventListener('resize', () => {
            size = items[0].clientWidth; 
            track.style.transition = "none";
            track.style.transform = `translateX(${-size * counter}px)`;
        });

        startSlider();
    });
</script>