<style>
               /* Import both fonts */
               @import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');
               /* @import url('https://fonts.googleapis.com/css2?family=Wild+Mango&display=swap'); */
                @font-face {
                  font-family: WildMango;
                  src: url(https://cdn.shopify.com/s/files/1/0870/1021/4194/files/WildMango_2a057f47-352d-4713-b96b-9e5e49c4fe38.otf?v=1760517120);
                }
               /* Font classes */
               .poppins-font {
                 font-family: "Poppins", sans-serif;
               }

               .wild-mango-font {
                 font-family: "WildMango", serif;
               }

               #new-banner-section {
                 padding: 30px 20px;
               }

               .new-banner-sect-heading h1 {
                 font-size: 50px;
                 
                 margin: 0;
                 text-align: center;
               }

               .new-banner-section-img {
                 display: flex;
                 align-items: center;
                 justify-content: center;
                 width: 100%;
                 max-width: 700px;
                 margin: 0 auto;
               }

               .new-banner-section-img img {
                 width: 100%;
                 object-fit: cover;
                 object-position: center;
               }

               .new-banner-content {
                 display: flex;
                 align-items: center;
                 justify-content: space-between;
                 width: 100%;
                 max-width: 1300px;
                 margin: 0 auto;
               }

               .new-banner-sub-cont1 {
                 display: flex;
                 justify-content: center;
                 align-items: center;
                 flex-direction: column;width:100%;max-width:450px;
               }

               .new-banner-sub-cont1 h1 {

                 color: {{ section.settings.text-color }};
                
                 text-align: center;line-height:normal;    font-size: 40px;
               }

             .new-banner-sub-cont1 a {
                 background: #ff4545;
                 color: #FFFFFF;
                 text-decoration: none;
                 width: 100%;
                 max-width: 350px;
                 padding: 0 3px;
                 text-align: center;
                 font-size: 30px;
                 border-radius: 100px;
                 font-weight: 600;
             }
          .sub-text {
             background: url("https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Untitled_Diagram.drawio.png?v=1760460110");
             background-size: cover;
             background-position: center;
             color: {{ section.settings.text-color }};    display: inline;
            padding: 0 10px;
           }
           .new-banner-section-img2{
        display:none;}


        @media screen and (max-width:650px) {
            .new-banner-section-img{
              display:none;
              }
                  .new-banner-section-img2{
                width:100%;max-width:300px;
                display: flex;
                 align-items: center;
                 justify-content: center;
                 margin:0 auto;
              }

              .new-banner-section-img2 img{
              width: 100%;
          object-fit: cover;
          object-position: center;}
          .new-banner-sub-cont1 h1 {
          color: #ff4545;
          
          text-align: center;
          line-height: normal;
          font-size: 30px;
          margin: 0 2px;
      }.new-banner-sub-cont1 a {
        background: #ff4545;
        color: #FFFFFF;
        text-decoration: none;
        width: 100%;
        max-width: 217px;
        padding: 5px 3px;
        text-align: center;
        font-size: 18px;
        border-radius: 100px;
        font-weight: 600;
        margin-top: 12px;
    }.new-banner-sect-heading h1 {
      font-size: 49px;
     
      margin: 0;
      text-align: center;
      line-height: 45px;
  }
        }
               @media screen and (max-width: 550px) {


                   .new-banner-sub-cont1 h1 {
        color: #ff4545;
        
        text-align: center;
        line-height: normal;
        font-size: 25px;
        margin: 0 2px;
    }    .new-banner-sect-heading h1 {
        font-size: 35px;
      
        margin: 0;
        text-align: center;
        line-height: 45px;
    }

                 .new-banner-sub-cont1 a {
                   max-width: 170px;
                   font-size: 13px;
                 }

              }

              @media screen and (max-width:450px) {
                    .new-banner-sub-cont1 a {
        background: #ff4545;
        color: #FFFFFF;
        text-decoration: none;
        width: 100%;
        max-width: 173px;
        padding: 5px 3px;
        text-align: center;
        font-size: 14px;
        border-radius: 100px;
        font-weight: 600;
        margin-top: 12px;
    }    .new-banner-sub-cont1 h1 {
        color: #ff4545;
     
        text-align: center;
        line-height: normal;
        font-size: 20px;
        margin: 0 2px;
    }
              }
              @media screen and (max-width: 380px) {
                   .new-banner-sub-cont1 a {
                     max-width: 129px;
                     font-size: 9px;
                   }

                      .new-banner-sub-cont1 h1 {
        font-size: 18px;
    }

                      .new-banner-sect-heading h1 {
        font-size: 24px;
    
        margin: 0;
        text-align: center;
        line-height: normal;
    }
                 }
</style>

<div id="new-banner-section" style="background-color:{{ section.settings.bg-color }}">
  <div class="new-banner-section-container">
    <div class="new-banner-sect-heading">
      <h1 class="wild-mango-font  " style="color:{{section.settings.heading-color }}">
        {{ section.settings.heading }}
      </h1>
    </div>
    <div class="new-banner-section-img">
      <img src="https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Hero_banner_Oct25_Desktop_view.png?v=1760467895" alt="">
    </div>
    <div class="new-banner-section-img2">
      <img
        src="https://cdn.shopify.com/s/files/1/0870/1021/4194/files/87772553129-removebg-preview.png?v=1760461230"
        alt=""
      >
    </div>
    <div class="new-banner-content">
      <div class="new-banner-sub-cont1">
        <h1 class="wild-mango-font ">
          {{ section.settings['text-1'] }}
          <span class="sub-text">{{ section.settings['sub-text-1'] }}</span>
          {{ section.settings['sec-text-1'] }}
        </h1>
        <a href="{{ section.settings.btn-url1 }}" class="poppins-semibold ">{{ section.settings['btn-text1'] }}</a>
      </div>
      <div class="new-banner-sub-cont1">
        <h1 class="wild-mango-font ">
          {{ section.settings['text-2'] }}
          <span class="sub-text">{{ section.settings['sub-text-2'] }}</span>
          {{ section.settings['sec-text-2'] }}
        </h1>
        <a href="{{ section.settings.btn-url2 }}" class="poppins-semibold ">{{ section.settings['btn-text2'] }}</a>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "New banner section",
  "tag": "section",
  "settings": [
    { "type": "color", "label": "Choose background color", "id": "bg-color", "default": "#FAD6D6" },
    {
      "type": "text",
      "id": "heading",
      "label": "Enter main Heading",
      "default": "How would you like to plan your year?"
    },
    {
      "type": "color",
      "id": "heading-color",
      "label": "heading color",
      "default": "#ff4545"
    },

    {
      "type": "text",
      "id": "text-1",
      "label": "Enter Text 1",
      "default": "I want to "
    },
    {
      "type": "text",
      "id": "sec-text-1",
      "label": "Enter Text 1",
      "default": "my own planner"
    },
    {
      "type": "text",
      "id": "sub-text-1",
      "label": "Enter Text 1",
      "default": "custom build"
    },
    {
      "type": "text",
      "id": "btn-text1",
      "label": "Enter Button Title",
      "default": "START CUSTOMISING"
    },
    {
      "type": "url",
      "id": "btn-url1",
      "label": "Enter Button Url"
    },
    {
      "type": "text",
      "id": "text-2",
      "label": "Enter Text 1",
      "default": "I want to pick from the"
    },
    {
      "type": "text",
      "id": "sec-text-2",
      "label": "Enter Text 1",
      "default": "options"
    },
    {
      "type": "text",
      "id": "sub-text-2",
      "label": "Enter Text 1",
      "default": " ready-made"
    },
    {
      "type": "text",
      "id": "btn-text2",
      "label": "Enter Button Title",
      "default": "FIND MY MATCH"
    },
    {
      "type": "color",
      "id": "text-color",
      "label": "Text color",
      "default": "#ff4545"
    },
    {
      "type": "url",
      "id": "btn-url2",
      "label": "Enter Button Url"
    },
    {
      "type": "color",
      "id": "button-bg-color",
      "label": "Button Background color",
      "default": "#ff4545"
    },
    {
      "type": "color",
      "id": "button-text-color",
      "label": "Button Text color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "New banner section",
      "settings": {}
    }
  ]
}
{% endschema %}
