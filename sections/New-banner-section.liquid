<style>
               /* Import both fonts */
               @import url('https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap');
               /* @import url('https://fonts.googleapis.com/css2?family=Wild+Mango&display=swap'); */
                @font-face {
                  font-family: WildMango;
                  src: url(https://cdn.shopify.com/s/files/1/0870/1021/4194/files/WildMango_2a057f47-352d-4713-b96b-9e5e49c4fe38.otf?v=1760517120);
                }
               /* Font classes */
               .poppins-font {
                 font-family: "Poppins", sans-serif;
               }

               .wild-mango-font {
                 font-family: "WildMango", serif;
               }

               #new-banner-section {
                 padding: 30px 20px;
               }

               .new-banner-sect-heading h1 {
                 font-size: 50px;
                 
                 margin: 0;
                 text-align: center;
               }

               .new-banner-section-img {
                 display: flex;
                 align-items: center;
                 justify-content: center;
                 width: 100%;
                 max-width: 700px;
                 margin: 0 auto;
               }

               .new-banner-section-img img {
                 width: 100%;
                 object-fit: cover;
                 object-position: center;
               }

               .new-banner-content {
                 display: flex;
                 align-items: center;
                 justify-content: space-between;
                 width: 100%;
                 max-width: 1300px;
                 margin: 0 auto;
               }

               .new-banner-sub-cont1 {
                 display: flex;
                 justify-content: center;
                 align-items: center;
                 flex-direction: column;width:100%;max-width:450px;
               }

               .new-banner-sub-cont1 h1 {

                 color: {{ section.settings.text-color }};
                
                 text-align: center;line-height:normal;    font-size: 40px;
               }

             .new-banner-sub-cont1 a {
                 background: #ff4545;
                 color: #FFFFFF;
                 text-decoration: none;
                 width: 100%;
                 max-width: 350px;
                 padding: 0 3px;
                 text-align: center;
                 font-size: 30px;
                 border-radius: 100px;
                 font-weight: 600;
             }
          .sub-text {
             background: url("https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Untitled_Diagram.drawio.png?v=1760460110");
             background-size: cover;
             background-position: center;
             color: {{ section.settings.text-color }};    display: inline;
            padding: 0 10px;
           }
          .new-banner-section-img2{
            display:none;
          }
              /* The main container needs to be relative so children can be absolute */
    .banner-grid-layout {
      position: relative;
      width: 100%;
      max-width: 1000px;
      margin: 0 auto;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 500px; /* Adjust based on your image height */
    }

    /* Make the girl image fill the container background area */
    .banner-center-column {
      position: relative !important; /* Changed from absolute */
      width: 100%;
      z-index: 1;
      display: block;
      line-height: 0;
    }

    .banner-center-column img {
      width: 100%;
      height: auto;
      display: block;
      object-fit: contain;
    }

    .banner-side-column {
      position: absolute;
      width: 100%;
      height: 100%;
      z-index: 10 !important; 
      pointer-events: none; 
    }

    .feature-item {
      {% comment %} display: flex !important; {% endcomment %}
      align-items: center;
      gap: 15px;
      position: absolute !important;
      width: auto;
      z-index: 2;
    }

    .feature-item.left {
      position: absolute !important;
      left: 5% !important;
      right: auto !important; /* Forces it to the right side */
      width: auto;
    }

    .feature-item.right {
      position: absolute !important;
      right: 5% !important;
      left: auto !important; /* Forces it to the right side */
      width: auto;
    }

    .feature-item.left {
      /* Put arrow first, then text */
      left: 5%;
    }

    .feature-item.left .arrow-img {
      width: 200px;
    }

    .feature-item.right {
      flex-direction: row; 
      right: 5%;
    }

    .feature-item.right .arrow-img {
      transform: none !important; /* Removes the inward flip */
      width: 300px;
      height: auto;
    }

    .feature-item.left:nth-child(1), 
    .feature-item.right:nth-child(1) { 
      top: 30% !important; 
    }

    .feature-item.left:nth-child(2), 
    .feature-item.right:nth-child(2) { 
      top: 55% !important; /* Changed from 'bottom' to 'top' for consistent scaling */
    }
    

    .arrow-img {
      width: 100%;
      max-width: 300px; 
      height: auto;
    }

    .feature-text-left1 {
      display: flex;
      font-size: 29px;
      color: #ff4545;
      width: 100%;
      max-width: 146px;
      line-height: 1.1;
      position: relative;
      left: 100px;
      top: -10px;
    }

    .feature-text-left2 {
      position: relative;
      font-size: 29px;
      color: #ff4545;
      max-width: 214px;
      line-height: 1.1;
      top: 182px;
      left: 71px;
      display: flex;
    }

    .feature-text-right1 {
      font-size: 32px;
      display: flex;
      color: #ff4545;
      max-width: 198px;
      line-height: 1.1;
      position: relative;
      right: -43px;
      bottom: 220px;
      justify-content: flex-start !important;
    }

    .feature-text-right2 {
      font-size: 32px;
      width: 100%;
      color: #ff4545;
      max-width: 140px;
      line-height: 1.1;
      position: relative;
      top: 10px;
      display: flex;
      max-width: 195px;
      right: 23px;
    }

    #new-banner-section{
      width: 100vw;
      position: relative;
      left: 50%;
      right: 50%;
      margin-left: -50vw;
      margin-right: -50vw;
    }
    
    .banner-grid-layout {
      width: 100% !important;
      max-width: 100% !important;
      margin: 0 !important;
      padding: 0 !important;
    } 

    .new-banner-sect-heading {
      position: absolute;
      top: 20px;
      left: 0;
      width: 100%;
      z-index: 20;
    }
    /* Ensure the image occupies real space so the pink area stays below it */


    .banner-side-right-column {
      position: absolute !important;
      top: 0;
      width: 100%;
      height: 100%;
      z-index: 10;
      pointer-events: none; /* Allows interactions with the image if needed */
    }

    /* Positioning the right column side specifically */
    .banner-side-right-column {
      right: 0;
    }

    .arrow-img1{
      position: absolute;
      top: -53px;
      max-width: 281px;
      left: 160px;
      top: 28px;
    }

    .arrow-img2{
      max-width: 182px;
      position: relative;
      left: 199px;
      top: -37px;
      max-width: 270px;
    }

    .arrow-img3{
      width: 100%;
      max-width: 321px;
      position: relative;
      right: 194px;
    }

    .arrow-img4{
      width: 100%;
      max-width: 220px;
      position: relative;
      top: 10px;
      right: 207px;
    }



            


        @media screen and (max-width:650px) {
            .new-banner-section-img{
              display:none;
              }
                  .new-banner-section-img2{
                width:100%;max-width:300px;
                display: flex;
                 align-items: center;
                 justify-content: center;
                 margin:0 auto;
              }

              .new-banner-section-img2 img{
              width: 100%;
