                   }

                      .new-banner-sub-cont1 h1 {
        font-size: 18px;
    }

                      .new-banner-sect-heading h1 {
        font-size: 24px;
    
        margin: 0;
        text-align: center;
        line-height: normal;
    }
                 }
</style>


<div id="new-banner-section" style="padding: 0;">
  {% comment %} <div class="new-banner-section-container" style="background-color: {{ section.settings.bg-color }};"> {% endcomment %}
    
    <div class="banner-grid-layout">
      <div class="new-banner-sect-heading">
        <h1 class="wild-mango-font  " style="color:{{section.settings.heading-color }}">
          {{ section.settings.heading }}
        </h1>
      </div> 
      <div class="banner-side-column">
        <div class="feature-item left">
          <span class="wild-mango-font feature-text-left1">{{ section.settings.text_left_1 }}</span>
          {% if section.settings.arrow_left_1 %}
            <img src="{{ section.settings.arrow_left_1 | img_url: 'master' }}" class="arrow-img1">
          {% endif %}
        </div>
        <div class="feature-item left">
          <span class="wild-mango-font feature-text-left2">{{ section.settings.text_left_2 }}</span>
          {% if section.settings.arrow_left_2 %}
            <img src="{{ section.settings.arrow_left_2 | img_url: 'master' }}" class="arrow-img2" style="m">
          {% endif %}
        </div>
      </div>

      <div class="banner-center-column" style="">
        {% if section.settings.center_image %}
          <img src="{{ section.settings.center_image | img_url: 'master' }}" alt="Planner Model">
        {% endif %}
      </div>
      <div class="banner-side-right-column">
          <div class="feature-item right">
            {% if section.settings.arrow_right_1 %}
              <img src="{{ section.settings.arrow_right_1 | img_url: 'master' }}" class="arrow-img3">
            {% endif %}
            <span class="wild-mango-font feature-text-right1">{{ section.settings.text_right_1 }}</span>
          </div>
        
          <div class="feature-item right">
              {% if section.settings.arrow_right_2 %}
              <img src="{{ section.settings.arrow_right_2 | img_url: 'master' }}" class="arrow-img4">
            {% endif %}
            <span class="wild-mango-font feature-text-right2">{{ section.settings.text_right_2 }}</span>

          </div>
      </div>
    </div>
      
      <div class="new-banner-section-container" style="background-color: {{ section.settings.bg-color }};">
        <div class="new-banner-content">
          <div class="new-banner-sub-cont1">
            <h1 class="wild-mango-font ">
              {{ section.settings['text-1'] }}
              <span class="sub-text">{{ section.settings['sub-text-1'] }}</span>
              {{ section.settings['sec-text-1'] }}
            </h1>
            <a href="{{ section.settings.btn-url1 }}" class="poppins-semibold ">{{ section.settings['btn-text1'] }}</a>
          </div>
          <div class="new-banner-sub-cont1">
            <h1 class="wild-mango-font ">
              {{ section.settings['text-2'] }}
              <span class="sub-text">{{ section.settings['sub-text-2'] }}</span>
              {{ section.settings['sec-text-2'] }}
            </h1>
            <a href="{{ section.settings.btn-url2 }}" class="poppins-semibold ">{{ section.settings['btn-text2'] }}</a>
          </div>
        </div>
      </div>

</div>
