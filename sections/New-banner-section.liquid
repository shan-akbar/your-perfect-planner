    }.new-banner-sect-heading h1 {
      font-size: 49px;
     
      margin: 0;
      text-align: center;
      line-height: 45px;
  }
        }
               @media screen and (max-width: 550px) {


                   .new-banner-sub-cont1 h1 {
        color: #ff4545;
        
        text-align: center;
        line-height: normal;
        font-size: 25px;
        margin: 0 2px;
    }    .new-banner-sect-heading h1 {
        font-size: 35px;
      
        margin: 0;
        text-align: center;
        line-height: 45px;
    }

                 .new-banner-sub-cont1 a {
