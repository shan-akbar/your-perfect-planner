<style>

    .highlights-container {
        padding: 20px 0;
        overflow-x: auto; 
        -webkit-overflow-scrolling: touch;
    }

    @media screen and (min-width: 771px) {
        .highlights-container {
            scrollbar-width: none; 
        }
        .highlights-container::-webkit-scrollbar {
            display: none; 
        }
    }

    .highlights-scroll {
        display: flex;
        gap: 20px;
        padding: 0 20px;
        justify-content: flex-start; 
        flex-wrap: nowrap;
    }

    .highlight-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0;
    }

    .circle-outline {
        width: 185px;
        height: 185px;
        border-radius: 50%;
        border: 2px solid #ff8fa3; 
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3px; 
    }

    .circle-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        overflow: hidden;
        background: #ccc;
        border: 2px solid #fff; 
    }

    .circle-inner video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

  
    @media screen and (max-width: 1024px){
        .circle-outline{
            width: 160px;
            height: 160px;
        }
    }
    
    @media screen and (max-width: 770px){
        .circle-outline{
            width: 150px;
            height: 150px;
        }

        .highlights-container {
            overflow-x: scroll !important; 
            padding-bottom: 25px; 
        }

        .highlights-container::-webkit-scrollbar {
            height: 14px !important; 
            display: block !important;
        }

        .highlights-container::-webkit-scrollbar-track {
            background: #f1f1f1; 
            border-radius: 10px;
        }

        .highlights-container::-webkit-scrollbar-thumb {
            background: rgba(255, 69, 69, 1); 
            border-radius: 10px;
            border: 2px solid #f1f1f1;
        }

      
        .highlights-container::-webkit-scrollbar-button:single-button {
            background-color: #f1f1f1;
            display: block;
            border-style: solid;
            height: 14px;
            width: 16px;
        }

        .highlights-container::-webkit-scrollbar-button:single-button:horizontal:decrement {
            border-width: 6px 8px 6px 0;
            border-color: transparent rgba(255, 69, 69, 1) transparent transparent;
        }

        .highlights-container::-webkit-scrollbar-button:single-button:horizontal:increment {
            border-width: 6px 0 6px 8px;
            border-color: transparent transparent transparent rgba(255, 69, 69, 1);
        }
    }
</style>

<div class="highlights-container">
  <div class="highlights-scroll">
    {% for block in section.blocks %}
      <div class="highlight-item" {{ block.shopify_attributes }}>
        <div class="circle-outline">
          <div class="circle-inner">
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Video Highlights",
  "settings": [],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Select Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Highlights"
    }
  ]
}
{% endschema %}