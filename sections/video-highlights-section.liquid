<style>
    /* 1. THE MAIN CONTAINER */
    .highlights-container {
        padding: 20px 0;
        width: 100%;
        overflow-x: auto; 
        overflow-y: hidden;
        -webkit-overflow-scrolling: touch;
        display: block;
    }

    .highlights-container::-webkit-scrollbar {
        height: 10px; 
        display: block; 
    }
    .highlights-container::-webkit-scrollbar-track {
        background: #f1f1f1; 
        border-radius: 10px;
    }
    .highlights-container::-webkit-scrollbar-thumb {
        background: rgba(255, 69, 69, 1); 
        border-radius: 10px;
        border: 2px solid #f1f1f1;
    }

    .highlights-scroll {
        display: flex;
        gap: 20px;
        padding: 0 20px;
        flex-wrap: nowrap; 
        width: max-content; 
        min-width: 100%;   
    }

    .highlight-item {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex-shrink: 0; 
    }

    .circle-outline {
        width: 185px;
        height: 185px;
        border-radius: 50%;
        border: 2px solid #ff8fa3; 
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 3px; 
    }

    .circle-inner {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        padding: 2px;
        overflow: hidden;
        background: #ccc;
        border: 2px solid #fff; 
    }

    .circle-inner video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    @media screen and (min-width: 1300px){
        .highlights-scroll{
            display: flex;
            justify-content: center;
        }
    }

    @media screen and (max-width: 1024px) {
        .circle-outline { width: 160px; height: 160px; }
    }
    @media screen and (max-width: 770px) {
        .circle-outline { width: 140px; height: 140px; }
        .highlights-container::-webkit-scrollbar { height: 8px; } /* Slimmer for mobile */
    }
</style>

<div class="highlights-container">
  <div class="highlights-scroll">
    {% for block in section.blocks %}
      <div class="highlight-item" {{ block.shopify_attributes }}>
        <div class="circle-outline">
          <div class="circle-inner">
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false }}
            {% endif %}
          </div>
        </div>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Video Highlights",
  "settings": [],
  "blocks": [
    {
      "type": "highlight",
      "name": "Highlight",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Select Video"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Video Highlights"
    }
  ]
}
{% endschema %}