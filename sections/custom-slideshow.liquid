{%- if section.settings.slide_height == 'adapt_image' and section.blocks.first.settings.image != blank -%}
  {%- style -%}
    .banner__media:after, .banner:after {
      display: none;
    }
    #Slider-{{ section.id }} .slideshow__slide {
      cursor: pointer;
    }
    #Slider-{{ section.id }} a {
     text-decoration: none !important;
    }
    #Slider-{{ section.id }} .media a {
      width: 100%;
      height: 100%;
    }
     #Slider-{{ section.id }} .media a img {
      width: 100%;
      height: 100%;
    }
    @media screen and (max-width: 749px) {

      #Slider-{{ section.id }} .banner__content {
        position: absolute;
      }

      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before,
      #Slider-{{ section.id }}:not(.banner--mobile-bottom) .banner__content::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
     
    #Slider-{{ section.id }} .media img {
        display: none;
    }
    
    #Slider-{{ section.id }} .media {
        position: initial !important; 
    }
    
    #Slider-{{ section.id }} .media img.mobile_image {
        display: block !important;
        position: initial !important;
    }

    #Slider-{{ section.id }} .media:before, #Slider-{{ section.id }} .banner__content:before {
        display: none !important;
    }
    }

    @media screen and (min-width: 750px) {
      .slideshow__text.slideshow__text--left {
        padding-left: 0;
      }
      .slideshow__text-wrapper.banner__content {
        position: absolute;
        left: 0;
        right: 0;
      }
      #Slider-{{ section.id }}::before,
      #Slider-{{ section.id }} .media::before {
        padding-bottom: {{ 1 | divided_by: section.blocks.first.settings.image.aspect_ratio | times: 100 }}%;
        content: '';
        display: block;
      }
     #Slider-{{ section.id }} .media .mobile_image {
    display: none;
}
    }
  {%- endstyle -%}
{%- endif -%}

