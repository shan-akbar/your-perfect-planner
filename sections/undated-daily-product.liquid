<script>

  let final_step_number = {{ custom_pages_step | json }};
  
  let planner_building_button = document.getElementById("planner_building_button");

  planner_building_button.addEventListener("click", (event) => {
    let build_step_wrapper = document.querySelector('.build-step__wrapper');
    let diary_preview = document.querySelector(".product__media-wrapper-2.product__media-wrapper");
    build_step_wrapper.appendChild(diary_preview);
    for(let i=1 ; i<(final_step_number + 1) ; ++i){
        let build_step = document.querySelector(`.build-step__${i}`);
        build_step_wrapper.appendChild(build_step);
    }

    step_modal.style.display = "block";

    document.body.style.overflow = 'hidden';

  });



  function processNextStep(){
      let build_step_wrapper = document.querySelector('.build-step__wrapper');
      let current_step = document.querySelector('.build-step__active');
      let current_index = Number(current_step.getAttribute("data-buildstep"));
      let process_next = true;
      let formbtn = document.querySelector(".form-submit__btn");
      if(current_index == 1){
          process_next = false;
          formbtn.click();

          const myInterval = setInterval(() => {
             let formFilled = localStorage.getItem("contactForm");
            if(formFilled == "true" ){
              let loading_spinner = document.querySelector(".klaviyo-form-wrapper .loading__spinner");
              loading_spinner.classList.add('hidden');
              let build_step_wrapper = document.querySelector('.build-step__wrapper');
              let current_step = document.querySelector('.build-step__active');
              let current_index = Number(current_step.getAttribute("data-buildstep"));
              let next_index = current_index + 1;
              let next_step = document.querySelector(`.build-step__${next_index}`);
              next_step.classList.add('build-step__active');
              current_step.classList.remove('build-step__active');
              let step_count = document.querySelector('.step-count');
              step_count.innerHTML = next_index;
              

              if(next_index == final_step_number){
                let diary_preview = document.querySelector(".product__media-wrapper-2.product__media-wrapper");
                diary_preview.classList.add('build-step-media__active');
                let next_btn = document.querySelector(".build-step__next");
                next_btn.classList.add('build-step-button__disabled');
                diary_preview.scrollLeft = diary_preview.scrollWidth;
                let globalPriceWrap = document.querySelector(".global-price");
                globalPriceWrap.classList.add('hidden');
              }
                
              if(current_index == 1){
                let prev_btn = document.querySelector(".build-step__prev");
                prev_btn.classList.remove('build-step-button__disabled');
               
              }
              localStorage.removeItem("contactForm");
              clearInterval(myInterval);
            }

          }, 2000);
      
      }

      if(process_next){
      
        let next_index = current_index + 1;
        let next_step = document.querySelector(`.build-step__${next_index}`);
        next_step.classList.add('build-step__active');
        current_step.classList.remove('build-step__active');
        let step_count = document.querySelector('.step-count');
        step_count.innerHTML = next_index;
        

        if(next_index == final_step_number){
          let diary_preview = document.querySelector(".product__media-wrapper-2.product__media-wrapper");
          diary_preview.classList.add('build-step-media__active');
          let next_btn = document.querySelector(".build-step__next");
          next_btn.classList.add('build-step-button__disabled');
          diary_preview.scrollLeft = diary_preview.scrollWidth;
          let globalPriceWrap = document.querySelector(".global-price");
          globalPriceWrap.classList.add('hidden');
        }
          
        

        if(current_index == 1){
          let prev_btn = document.querySelector(".build-step__prev");
          prev_btn.classList.remove('build-step-button__disabled');
          
        }
      }
  }

  function processPrevStep(){
      let build_step_wrapper = document.querySelector('.build-step__wrapper');
      let current_step = document.querySelector('.build-step__active');
      let current_index = Number(current_step.getAttribute("data-buildstep"));
      let prev_index = current_index - 1;
      if(prev_index > 0){
        let prev_step = document.querySelector(`.build-step__${prev_index}`);
        prev_step.classList.add('build-step__active');
        current_step.classList.remove('build-step__active');
        let step_count = document.querySelector('.step-count');
        step_count.innerHTML = prev_index;
        if(prev_index < final_step_number){
          let diary_preview_active = document.querySelector(".build-step-media__active");
          if(diary_preview_active){
            diary_preview_active.classList.remove('build-step-media__active');
          }
        }
      }

      if(prev_index == final_step_number - 1){
        let next_btn = document.querySelector(".build-step__next");
        next_btn.classList.remove('build-step-button__disabled');
        let globalPriceWrap = document.querySelector(".global-price");
        globalPriceWrap.classList.remove('hidden');
      }

      if(prev_index == 1){
        let prev_btn = document.querySelector(".build-step__prev");
        prev_btn.classList.add('build-step-button__disabled');
      }
  }

  function epSlideNext(){
    let target = this.event.target;
    let ep_wrapper = target.closest(".planner-custom_pages");
    let ep_slider = ep_wrapper.querySelector(".planner-custom-pages_images");
    let slide_width = ep_slider.querySelector('.page_item').offsetWidth;
    ep_slider.scrollBy({ left: slide_width, behavior: "smooth" });
  }        

  function epSlidePrev(){
    let target = this.event.target;
    let ep_wrapper = target.closest(".planner-custom_pages");
    let ep_slider = ep_wrapper.querySelector(".planner-custom-pages_images");
    let slide_width = ep_slider.querySelector('.page_item').offsetWidth;
    ep_slider.scrollBy({ left: (-1 * slide_width), behavior: "smooth" });
  }

</script>

