<div id="myModal" class="modal" data-currentyear="2025">

  <!-- Modal content -->
  <div class="modal-content">
    <span class="close">&times;</span>
    {%- render 'loading-spinner' -%}
    <select class="multiyear__selector invisible" onchange="onyearchange()">
      <option value="2025" selected>2025</option>
      <option value="2026">2026</option>
    </select>
    <img class="main-image" loading="eager" src="">
    <img class="rotate-icon"  src="https://cdn.shopify.com/s/files/1/0870/1021/4194/files/rotate-icon.png?v=1732746382" onclick="alternateImage()">
  </div>

</div>

<script>

const media_wrapper = document.querySelector('.grid__item.product__media-wrapper.product__media-wrapper-2');
media_wrapper.scrollLeft = media_wrapper.scrollWidth;
// Get the modal
var modal = document.getElementById("myModal");
// Get the <span> element that closes the modal
var span = document.getElementsByClassName("close")[0];
// When the user clicks on <span> (x), close the modal
span.onclick = function() {
  modal.style.display = "none";
  resetYearToDefault();
}
// When the user clicks anywhere outside of the modal, close it
window.onclick = function(event) {
  if (event.target == modal) {
    modal.style.display = "none";
    resetYearToDefault();
  }
}

function resetYearToDefault(){
    let year_selector = modal.querySelector('.multiyear__selector');
    year_selector.classList.add('invisible');
    let current_year = modal.getAttribute('data-currentyear');
    let default_year = modal.getAttribute('data-defaultyear');
    if(current_year != default_year){
      let year_selector = modal.querySelector('.multiyear__selector');
      let page_number = year_selector.getAttribute("data-pagenumber");
      let page_type = year_selector.getAttribute("data-pagetype");
      let target_object_index = multiyear_pages.findIndex((item)=> item.page_type==page_type && item.page_number==page_number && item.year==default_year);
      let targetImage = modal.querySelector('img.main-image');
      let current_image = targetImage.getAttribute('src');
      let current_year = modal.getAttribute("data-currentyear");
      targetImage.setAttribute('src', multiyear_pages[target_object_index].front_image);
      multiyear_pages[target_object_index].front_image = current_image;
      modal.setAttribute("data-currentyear", multiyear_pages[target_object_index].year);
      multiyear_pages[target_object_index].year = current_year;
      if(multiyear_pages[target_object_index].back_image){
        let rotateIcon = modal.querySelector('img.rotate-icon');
        let current_back_image = rotateIcon.getAttribute("data-alternateimage");
        rotateIcon.setAttribute("data-alternateimage", multiyear_pages[target_object_index].back_image);
        multiyear_pages[target_object_index].back_image = current_back_image;
      }
      year_selector.selectedIndex = 0;
    }
}

// mouse over and out functions
function bigImg() {

    let target = this.event.target;
    let main_wrapper = target.closest(".planner-custom-pages_wrapper");
    let default_year = main_wrapper.getAttribute('data-defaultyear');
    modal.setAttribute('data-currentyear', default_year);
    modal.setAttribute('data-defaultyear', default_year);
    let imageUrl = this.event.target.closest('.page_item').querySelector('img.extra-image').getAttribute('src');
    let backImage = this.event.target.getAttribute("data-backimage");
    let targetImage = modal.querySelector('img.main-image');
    let rotateIcon = modal.querySelector('img.rotate-icon');
    if(backImage){
      rotateIcon.setAttribute("data-alternateimage", backImage);
      rotateIcon.style.display = "block";
    }else{
      rotateIcon.setAttribute("data-alternateimage", "");
      rotateIcon.style.display = "none";
    }
    
    targetImage.setAttribute('src', imageUrl);
    modal.style.display = "block";

    let enable_multiyear = target.getAttribute('data-multiyear');
    if(enable_multiyear == "true"){
      let year_selector = modal.querySelector('.multiyear__selector');
      let page_number = target.getAttribute('data-pagenumber');
      let page_type = target.getAttribute('data-pagetype');
      year_selector.setAttribute("data-pagenumber", page_number);
      year_selector.setAttribute("data-pagetype", page_type);
      year_selector.classList.remove('invisible');
    }
  }

  function alternateImage(){
    let rotateIcon = this.event.target;
    let secondImage = rotateIcon.getAttribute("data-alternateimage");
    let targetImage = modal.querySelector('img.main-image');
    let firstImage = targetImage.getAttribute("src");
    rotateIcon.setAttribute("data-alternateimage", firstImage);
    targetImage.setAttribute("src", secondImage);
  }

  function updateQty(){
    let updateSign = this.event.target.value;
    let qtyInput = this.event.target.closest(".page_item").querySelector('.page-qty__input');
    let maxValue = Number(qtyInput.getAttribute("max"));
    let minValue = Number(qtyInput.getAttribute("min"));
    var event = new Event('change');

    if(updateSign == "+"){
      if(Number(qtyInput.value) < maxValue){
        qtyInput.value = Number(qtyInput.value) + 1;
        qtyInput.setAttribute("data-updatetype", "plus");
        qtyInput.dispatchEvent(event);
      }
    }else{
      if(Number(qtyInput.value) > minValue){
        qtyInput.value = Number(qtyInput.value) - 1;
        qtyInput.setAttribute("data-updatetype", "minus");
        qtyInput.dispatchEvent(event);
      }
    }
  }

  function onyearchange(){
    let loading_spinner = modal.querySelector(".loading__spinner");
    loading_spinner.classList.remove('hidden');
    let target = this.event.target;
    let year_value = target.value;
    let page_type = target.getAttribute("data-pagetype");
    let page_number = target.getAttribute("data-pagenumber");
    let target_object_index = multiyear_pages.findIndex((item)=> item.page_type==page_type && item.page_number==page_number && item.year==year_value);
    let targetImage = modal.querySelector('img.main-image');
    let current_image = targetImage.getAttribute('src');
    let current_year = modal.getAttribute("data-currentyear");
    targetImage.setAttribute('src', multiyear_pages[target_object_index].front_image);
    multiyear_pages[target_object_index].front_image = current_image;
    modal.setAttribute("data-currentyear", multiyear_pages[target_object_index].year);
    multiyear_pages[target_object_index].year = current_year;
    if(multiyear_pages[target_object_index].back_image){
      let rotateIcon = modal.querySelector('img.rotate-icon');
      let current_back_image = rotateIcon.getAttribute("data-alternateimage");
      rotateIcon.setAttribute("data-alternateimage", multiyear_pages[target_object_index].back_image);
       multiyear_pages[target_object_index].back_image = current_back_image;
    }
    setTimeout(function spinnerTimer(){
      let loading_spinner = modal.querySelector(".loading__spinner");
      loading_spinner.classList.add('hidden');
    }, 1000);
  }

</script> 

