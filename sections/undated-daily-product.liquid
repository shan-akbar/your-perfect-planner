<section
  id="MainProduct-{{ section.id }}"
  class="section-{{ section.id }}-padding gradient color-{{ section.settings.color_scheme }}"
  data-section="{{ section.id }}"
>
  {{ 'section-main-product.css' | asset_url | stylesheet_tag }}
  {{ 'component-accordion.css' | asset_url | stylesheet_tag }}
  {{ 'component-price.css' | asset_url | stylesheet_tag }}
  {{ 'component-slider.css' | asset_url | stylesheet_tag }}
  {{ 'component-rating.css' | asset_url | stylesheet_tag }}
  {{ 'custom-pages.css' | asset_url | stylesheet_tag }}
  {{ 'component-deferred-media.css' | asset_url | stylesheet_tag }}
  {{ 'custom-product-description.css' | asset_url | stylesheet_tag }}
  {% unless product.has_only_default_variant %}
    {{ 'component-product-variant-picker.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch-input.css' | asset_url | stylesheet_tag }}
    {{ 'component-swatch.css' | asset_url | stylesheet_tag }}
  {% endunless %}
  {%- if product.quantity_price_breaks_configured? -%}
    {{ 'component-volume-pricing.css' | asset_url | stylesheet_tag }}
  {%- endif -%}

  {%- style -%}

  product-info .build-step-hide{
    display: none;
  }
  
  @font-face {
      font-family: 'poopins-regular'; 
      src: url('https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Poppins-Regular.ttf?v=1720604392');
  }

    @font-face {
        font-family: 'poopins-bold'; 
        src: url('https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Poppins-Bold.ttf?v=1720611534');
    }
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
    .planner-date__range{
      text-align: center;
    }

    .view-cart__button{
      background: black;
      color: white;
      border-radius: 8px;
      font-weight: bold;
      font-size: 20px;
      text-transform: uppercase;
    }

    .planner-custom-pages_images {
      scrollbar-width: none;        
      -ms-overflow-style: none;     
    }

    .planner-custom-pages_imagess::-webkit-scrollbar {
      display: none;                
    }

    .diary-update__button{
      cursor: pointer;
      background-color: #FF4545;
      color: white;
      border-radius: 3px;
      padding: 8px 15px;
      font-weight: bold;
      border: none;
      font-size: 15px;
    }

    .diary-update__button:hover{
      opacity: 0.7;
    }

    .date-range__note{
      font-size: 14px;
      color: black;
    }

    .hide-custom__element{
      display: none !important;
    }

    .layout-page__checkbox{
      position: absolute;
      top: 0;
      right: 0;
      cursor: pointer;
      height: 30px;
      width: 30px;
    }

    .planner-custom-pages_wrapper{
      max-width: 400px;
    }

    .product__accordion.accordion{
      max-width: 460px;
    }

    .cart-notification__links{
      max-width: 44rem;
      margin: 0 auto;
    }

    #split_diary{
      height: 16px;
      width: 16px;
      accent-color: #FF4545;
      margin-left: 0;
      cursor: pointer;
    }

    .pages-limit__description{
      background-color: hsl(0, 89%, 96%);
      border: 1px solid hsl(0, 90%, 92%);
      padding: 10px 20px;
      border-radius: 10px;
      display: none;
      margin-bottom: 20px;
    }

    .pages-limit__description p{
      margin-top: 0;
    }

    .pages-limit__content p{
      font-weight: bold;
    }

    .pages-limit__content label{
      font-weight: bold;
    }

    .current-pages__number{
      color: rgb(255, 69, 69);
    }

    .danger-icon img{
      max-width: 30px;
    }

    .exclude_weekends{
      margin-bottom: 20px;
    }

    .product-form__input{
      max-width: 14rem;
    }

    .exclude_weekends, .switch_weekends{
      background-color: hsl(0, 89%, 96%);
      border: 1px solid hsl(0, 90%, 92%);
      padding: 10px 20px;
      border-radius: 10px;
    }

    .exclude_weekends h3, .switch_weekends h3{
      font-weight: bold;
      margin: 0;
    }

    .exclude_weekends input, .switch_weekends input{
      height: 16px;
      width: 16px;
      accent-color: #FF4545;
      margin-left: 0;
      cursor: pointer;
    }

    .exclude_weekends p, .switch_weekends p{
      display: inline-block;
      margin: 0;
      margin-top: 10px;
    }

    .exclude-weekends__checkbox, .switch-weekends__checkbox{
      display: flex;
      align-items: center;
      column-gap: 10px;
    }

    .exclude-weekends__description, .switch-weekends__description{
      display: flex;
      column-gap: 10px;
    }

    .exclude-weekends__description span, .switch-weekends__description span{
      margin-top: 10px;
    }

    .multiyear__selector{
      position: absolute;
      bottom: 43px;
      left: 43px;
      cursor: pointer;
    }

    .multiyear__selector.invisible{
      display: none;
    }

    .additional-information{
      color: #FF4545 !important;
    }

    .step-price__wrapper{
      display: flex;
      column-gap: 20px;
      align-items: center;
      justify-content: center;
      margin-bottom: 10px;
    }

    .price-label{
      color: black;
      font-size: 19px;
    }

    .extra-pages__navigation{
      position: absolute;
      top: 50%;
      width: 100%;
      left: 13%;
      display: flex;
      justify-content: space-between;
      max-width: 600px;
    }

    .ep-nav__button{
      background: transparent;
      border: unset;
      cursor: pointer;
    }

    .ep-nav__button img{
      max-width: 50px;
    }

    .build-step__wrapper{
      position: relative;
    }

    .page-width .product .product__media-wrapper-2{
      display: none;
    }

    .product__media-wrapper-3 .product-media-container .product__media img{
      object-fit: contain !important;
    }

    .product__media-wrapper-3 .product-media-container{
      border: unset !important;
    }

    .grid__item.product__media-wrapper-3{
      height: unset !important;
    }

    @media(min-width: 536px){
      .global-price{
        position: relative;
        top: 22px;
      }
    }
    

    @media(max-width: 769px){
      .extra-pages__navigation{
        left: 0;

      }
    }

    @media screen and (min-width: 750px) {
      .section-{{ section.id }}-padding {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }
  {%- endstyle -%}

  <style>
    .coverage-container {
      max-width: 400px;
      margin: 20px auto;
      font-family: Arial, sans-serif;
    }

    .coverage-title {
      font-size: 18px;
      font-weight: bold;
      margin-bottom: 15px;
    }

    .coverage-options {
      display: flex;
      gap: 15px;
      justify-content: center;
    }

    .coverage-option {
      border: 1px solid #ddd;
      padding: 12px 10px;
      font-size: 15px;
      border-radius: 6px;
      cursor: pointer;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .coverage-option:hover {
      border-color: #333;
    }

    #selectedCoverage {
      margin-top: 15px;
      font-weight: bold;
    }
    </style>
  
  <script src="{{ 'custom-pages.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-info.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>

  
  {%- if product.quantity_price_breaks_configured? -%}
    <script src="{{ 'show-more.js' | asset_url }}" defer="defer"></script>
    <script src="{{ 'price-per-item.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {% if section.settings.image_zoom == 'hover' %}
    <script id="EnableZoomOnHover-main" src="{{ 'magnify.js' | asset_url }}" defer="defer"></script>
  {% endif %}
  {%- if request.design_mode -%}
    <script src="{{ 'theme-editor.js' | asset_url }}" defer="defer"></script>
  {%- endif -%}

  {%- assign first_3d_model = product.media | where: 'media_type', 'model' | first -%}
  {%- if first_3d_model -%}
    {{ 'component-product-model.css' | asset_url | stylesheet_tag }}
    <link
      id="ModelViewerStyle"
      rel="stylesheet"
      href="https://cdn.shopify.com/shopifycloud/model-viewer-ui/assets/v1.0/model-viewer-ui.css"
      media="print"
      onload="this.media='all'"
    >
    <link
      id="ModelViewerOverride"
      rel="stylesheet"
      href="{{ 'component-model-viewer-ui.css' | asset_url }}"
      media="print"
      onload="this.media='all'"
    >
  {%- endif -%}



  <script>
    let monthly_double_pages = [];
    let multiyear_pages = [];
  </script>

  {% assign switch_weekends_block = blank %}

  {% for block in section.blocks %}
    {% if block.type == 'switch_weekends_pages' %}
      {% assign switch_weekends_block = block %}
    {% endif %}
  {% endfor %}

  {% assign custom_pages_step =  1 %}

  {% assign split_planner_price =  0 %}

  {% assign variant_images = product.images | where: 'attached_to_variant?', true | map: 'src' %}
  <div class="page-width">
    <div class="product product--{{ section.settings.media_size }} product--{{ section.settings.media_position }} product--{{ section.settings.gallery_layout }} product--mobile-{{ section.settings.mobile_thumbnails }} grid grid--1-col {% if product.media.size > 0 %}grid--2-col-tablet{% else %}product--no-media{% endif %}">
      <div class="grid__item product__media-wrapper-2 product__media-wrapper{% if section.settings.media_position == 'right' %} medium-hide large-up-hide{% endif %}">
        {% render 'undated-daily-preview', blocks: section.blocks %}
      </div>
      <div class="grid__item product__media-wrapper-3 product__media-wrapper{% if section.settings.media_position == 'right' %} medium-hide large-up-hide{% endif %}">
        {% render 'product-media-gallery', variant_images: variant_images %}
      </div>
      <div class="product__info-wrapper grid__item{% if settings.page_width > 1400 and section.settings.media_size == "small" %} product__info-wrapper--extra-padding{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <product-info
          id="ProductInfo-{{ section.id }}"
          data-section="{{ section.id }}"
          data-url="{{ product.url }}"
          class="product__info-container{% if section.settings.enable_sticky_info %} product__column-sticky{% endif %}"
        >
          {%- assign product_form_id = 'product-form-' | append: section.id -%}

          
          {%- for block in section.blocks -%}
            {%- case block.type -%}

            {% when 'form' %}

              <div class="contact__form build-step__{{ custom_pages_step }} build-step-hide build-step__active" data-buildstep="{{ custom_pages_step }}">
              <style>
                .klaviyo-form-wrapper {
                  max-width: 420px;
                  margin: 40px auto;
                  padding: 28px;
                  border-radius: 18px;
                  background: #ffffff;
                  box-shadow: 0 12px 35px rgba(0,0,0,0.08);
                  font-family: -apple-system, BlinkMacSystemFont, sans-serif;
                }

                .klaviyo-form-wrapper h2 {
                  margin-bottom: 20px;
                  font-size: 15px;
                  text-align: center;
                  font-weight: 600;
                }

                .klaviyo-field {
                  position: relative;
                  margin-bottom: 18px;
                }

                .klaviyo-field input {
                  width: 100%;
                  padding: 16px 14px;
                  border-radius: 12px;
                  border: 1px solid #ddd;
                  font-size: 14px;
                  outline: none;
                  transition: all 0.25s ease;
                  background: #fafafa;
                }

                .klaviyo-field input:focus {
                  border-color: #000;
                  background: #fff;
                  box-shadow: 0 0 0 3px rgba(0,0,0,0.05);
                }

                .klaviyo-field label {
                  position: absolute;
                  top: 50%;
                  left: 14px;
                  transform: translateY(-50%);
                  font-size: 13px;
                  color: #777;
                  background: #fff;
                  padding: 0 6px;
                  transition: 0.2s ease;
                  pointer-events: none;
                }

                .klaviyo-field input:focus + label,
                .klaviyo-field input:not(:placeholder-shown) + label {
                  top: -8px;
                  font-size: 11px;
                  color: #000;
                }

                .klaviyo-form-wrapper button {
                  width: 100%;
                  padding: 14px;
                  border: none;
                  border-radius: 12px;
                  background: #000;
                  color: #fff;
                  font-size: 15px;
                  font-weight: 500;
                  cursor: pointer;
                  transition: all 0.25s ease;
                }

                .klaviyo-form-wrapper button:hover {
                  background: #333;
                }

                .klaviyo-form-wrapper button:active {
                  transform: scale(0.98);
                }

                #form-message {
                  margin-top: 14px;
                  font-size: 13px;
                  text-align: center;
                }

                @media (max-width: 480px) {
                  .klaviyo-form-wrapper {
                    margin: 20px;
                    padding: 20px;
                  }
                }
              </style>

              <div class="klaviyo-form-wrapper">
                {%- render 'loading-spinner' -%}
                <h2>Pop in your details below so we can help you if you get stuck. (This does not subscribe you to email or SMS marketing)</h2>

                <form id="klaviyo-form">
                  
                  <div class="klaviyo-field">
                    <input type="text" id="name" placeholder=" " required>
                    <label>Your Name</label>
                  </div>

                  <div class="klaviyo-field">
                    <input type="email" id="email" placeholder=" " required>
                    <label>Your Email</label>
                  </div>

                  <div class="klaviyo-field">
                    <input type="tel" id="phone" placeholder=" ">
                    <label>Your Phone (optional)</label>
                  </div>

                  <button type="submit" class="form-submit__btn" style="display: none;">Send Message</button>
                </form>

                <div id="form-message" style="display:none;"></div>
              </div>
              </div>

              <script>
                document.getElementById("klaviyo-form").addEventListener("submit", async function(e) {
                e.preventDefault();

                const name = document.getElementById("name").value.trim();
                const email = document.getElementById("email").value.trim();
                const phone = document.getElementById("phone").value.trim();
              

                const msgBox = document.getElementById("form-message");
                // msgBox.innerHTML = "Submitting...";

                try {
                  let loading_spinner = document.querySelector(".klaviyo-form-wrapper .loading__spinner");
                  loading_spinner.classList.remove('hidden');
                  const response = await fetch("https://a.klaviyo.com/client/subscriptions/?company_id=WL27eL", {
                    method: "POST",
                    headers: {
                      "Content-Type": "application/json",
                      "revision": "2023-10-15"
                    },
                    body: JSON.stringify({
                      data: {
                        type: "subscription",
                        attributes: {
                          profile: {
                            data: {
                              type: "profile",
                              attributes: {
                                email: email,
                                first_name: name,
                                phone_number: phone || undefined,
                              
                              }
                            }
                          }
                        },
                        relationships: {
                          list: {
                            data: {
                              type: "list",
                              id: "X4rhnz" // 👈 replace this
                            }
                          }
                        }
                      }
                    })
                  });

                  if (response.status === 202) {
                    msgBox.innerHTML = "true";
                    localStorage.setItem('contactForm', 'true');
                    
                 
                  } else {
                    const err = await response.text();
                    throw new Error(err);
                  }

                } catch (error) {
                  console.error(error);
                  msgBox.innerHTML = "false";
                }
              });
               
              </script>
              
              {% assign custom_pages_step = custom_pages_step | plus: 1 %}

              {% when 'disclaimer_text' %}
                <div class="disclaimer-text__wrapper build-step__{{ custom_pages_step }} build-step-hide" data-buildstep="{{ custom_pages_step }}">
                  <div class="disclaimer-text disclaimer-text-info__1">{{ block.settings.info_1 }}</div>
                  <div class="disclaimer-text disclaimer-text-info__2">{{ block.settings.info_2 }}</div>
                  <div class="disclaimer-text disclaimer-text-info__3">{{ block.settings.info_3 }}</div>
                </div>
                {% assign custom_pages_step = custom_pages_step | plus: 1 %}
              {% when 'planner_range' %}
                <div class="planner-date__range build-step__{{ custom_pages_step }} build-step-hide " data-buildstep="{{ custom_pages_step }}" data-startdate="2025-01-01" data-enddate="2026-12-31" >
                  <div class="additional-information">{{ block.settings.additional_information }}</div>
                  <div class="coverage-container">

                    <div class="coverage-title">
                      Choose your coverage
                    </div>

                    <div class="coverage-options">

                      
                      <label class="coverage-option">
                        <input type="radio" name="coverage" value="6" checked>
                        6 Months
                      </label>

                      <label class="coverage-option">
                        <input type="radio" name="coverage" value="12">
                        12 Months
                      </label>

                    </div>

                    <div id="selectedCoverage">
                      Selected: 6 Months
                    </div>

                  </div>
                  
                </div>
                {% assign custom_pages_step = custom_pages_step | plus: 1 %}
              
                 <script>
                  const radios = document.querySelectorAll('input[name="coverage"]');
                  const display = document.getElementById('selectedCoverage');

                function updateCoverage(months){
 
                  display.textContent = "Selected: " + months + " Months";

                  const pagesPerMonth = 30;
                  const requiredInnerPages = months * pagesPerMonth;

                  // get all day page indexes
                  const dayIndexes = diary_pages
                    .map((p, i) => p.page_type === "day" ? i : -1)
                    .filter(i => i !== -1);

                  const currentInnerCount = dayIndexes.length;

                  if (requiredInnerPages > currentInnerCount) {

                    const pagesToAdd = requiredInnerPages - currentInnerCount;

                    // insert before the last day page
                    const insertIndex = dayIndexes[dayIndexes.length - 1] + 1;

                    const layoutUrl = diary_pages[dayIndexes[0]].page_url;

                    for (let i = 0; i < pagesToAdd; i++) {
                      diary_pages.splice(insertIndex + i, 0, {
                        page_url: layoutUrl,
                        page_type: "day"
                      });
                    }

                  } 
                  else if (requiredInnerPages < currentInnerCount) {

                    const pagesToRemove = currentInnerCount - requiredInnerPages;

                    for (let i = 0; i < pagesToRemove; i++) {
                      const indexToRemove = dayIndexes[dayIndexes.length - 1 - i];
                      diary_pages.splice(indexToRemove, 1);
                    }

                  }

                  renderPages();
                }

                  radios.forEach(radio => {
                    radio.addEventListener('change', function() {
                      updateCoverage(this.value);
                    });
                  });

                  // Ensure default selection shows on load
                  document.addEventListener("DOMContentLoaded", () => {
                    const selected = document.querySelector('input[name="coverage"]:checked');
                    if(selected){
                      updateCoverage(selected.value);
                    }
                  });
                  </script>

                
              {%- when 'exclude_weekends' -%}
                <div class="build-step__{{ custom_pages_step }} build-step-hide" data-buildstep="{{ custom_pages_step }}">
                  <div class="exclude_weekends">
                    {% if block.settings.heading != blank %}
                      <h3>{{ block.settings.heading }}</h3>
                    {% endif %}
                    <div class="exclude-weekends__checkbox">
                      <input type="checkbox" id="exclude_weekends" name="exclude_weekends" value="false" autocomplete='off' onclick="excludeWeekends()">
                      <label for="exclude_weekends">{{ block.settings.checkbox_label }}</label><br>
                    </div>
                    {% if block.settings.other_note != blank %}
                      <div class="exclude-weekends__description">
                        <span>&#62;</span> {{ block.settings.other_note }}
                      </div>
                    {% endif %}
                  </div>
                    {% if switch_weekends_block != blank %}
                       <div class="switch_weekends build-step__{{ custom_pages_step }} build-step-hide" data-buildstep="{{ custom_pages_step }}">
                        {% if switch_weekends_block.settings.heading != blank %}
                          <h3>{{ switch_weekends_block.settings.heading }}</h3>
                        {% endif %}
                        <div class="switch-weekends__checkbox">
                          <input type="checkbox" id="switch_weekends" name="switch_weekends" value="false" autocomplete='off' onclick="switchWeekendsPages()">
                          <label for="switch_weekends">{{ switch_weekends_block.settings.checkbox_label }}</label><br>
                        </div>
                        {% if switch_weekends_block.settings.other_note != blank %}
                          <div class="switch-weekends__description">
                            <span>&#62;</span> {{ switch_weekends_block.settings.other_note }}
                          </div>
                        {% endif %}
                      </div>
                    {% endif %}
                    </div>
                  {% assign custom_pages_step = custom_pages_step | plus: 1 %}
                  {%- when 'switch_weekends_pages' -%}
                    {% comment %} <div class="switch_weekends build-step__{{ custom_pages_step }} build-step-hide" data-buildstep="{{ custom_pages_step }}">
                      {% if block.settings.heading != blank %}
                        <h3>{{ block.settings.heading }}</h3>
                      {% endif %}
                      <div class="switch-weekends__checkbox">
                        <input type="checkbox" id="switch_weekends" name="switch_weekends" value="false" autocomplete='off' onclick="switchWeekendsPages()">
                        <label for="switch_weekends">{{ block.settings.checkbox_label }}</label><br>
                      </div>
                      {% if block.settings.other_note != blank %}
                        <div class="switch-weekends__description">
                          <span>&#62;</span> {{ block.settings.other_note }}
                        </div>
                      {% endif %}
                    </div> {% endcomment %}

                    {% comment %} {% assign custom_pages_step = custom_pages_step | plus: 1 %} {% endcomment %}
                  
                {% when 'planner_custom_pages' %}
                  <div class="planner-custom-pages_wrapper build-step__{{ custom_pages_step }} build-step-hide" data-buildstep="{{ custom_pages_step }}" data-pagetype="{{ block.settings.page_type }}" data-defaultyear="2025">
                   <div class="additional-information">{{ block.settings.additional_information }}</div>
                    <div class="planner-custom_pages">
                        <h2>{{ block.settings.title }}</h2>
                        {% if block.settings.page_type == "layout_page" %}
                          <label for="layout-page"></label>
                        {% endif %}
                        
                        <div class="planner-custom-pages_images">
                            {% if block.settings.page_1_image %}
                            <div class="page_item" data-index="0">
                                
                                {{ block.settings.page_1_image |  image_url: width: block.settings.page_1_image.width | image_tag : class: 'extra-image'}}
                            
                                {% if block.settings.page_type == "layout_page" %}
                                    <input type="radio" name="layout-page" class="layout-page__checkbox" onclick="changePageLayout()" checked="checked" data-layoutposition="1" />
                                {% endif %}
                                <input class="plus-button page-qty-input__button {% if block.settings.page_type == 'layout_page' %}hide-custom__element{% endif %}" type="button" value="+" onclick="updateQty()">
                                <input class="page-qty__input {% if block.settings.page_type == 'layout_page' %}hide-custom__element{% endif %}" type="number" value="0" max="12"  data-numberindex="1" min="0" readonly onchange="extraPages()">
                                <input class="minus-button page-qty-input__button {% if block.settings.page_type == 'layout_page' %}hide-custom__element{% endif %}" type="button" value="-" onclick="updateQty()">
                                <img class="preview-icon" src="https://cdn.shopify.com/s/files/1/0870/1021/4194/files/icons8-preview-30.png?v=1732746232" onclick="bigImg()" {% if block.settings.page_1_image_back %} data-backimage="{{ block.settings.page_1_image_back |  image_url: width: block.settings.page_1_image_back.width }}" {% endif %} data-multiyear="{{ block.settings.has_more_than_1_year_pages_1 }}" data-pagenumber="1" data-pagetype="{{ block.settings.page_type }}">
                                
                              </div>
                            {% endif %}   
                            {% if block.settings.page_2_image %}
                              <div class="page_item" data-index="1">
                                  
