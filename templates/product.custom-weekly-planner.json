        "custom_liquid": "<section class=\"ypp-comparison\">\n  <p class=\"ypp-comp-label\">Why Custom?</p>\n  <h2 class=\"ypp-comp-title\">How We Stack Up</h2>\n  <p class=\"ypp-comp-sub\">Not all planners are created equal. Here's the honest comparison.</p>\n\n  <div class=\"ypp-comp-wrap\">\n    <table class=\"ypp-comp-table\">\n      <thead>\n        <tr>\n          <th class=\"ypp-col-feature\">Feature</th>\n          <th class=\"ypp-col-ours\">Your Perfect<br>Planner</th>\n          <th class=\"ypp-col-generic\">Generic<br>Planner</th>\n        </tr>\n      </thead>\n      <tbody>\n        <tr>\n          <td class=\"ypp-row-label\">Custom date range</td>\n          <td class=\"ypp-col-ours-cell\"><span class=\"ypp-check\">✔</span></td>\n          <td class=\"ypp-col-generic-cell\"><span class=\"ypp-cross\">✗</span></td>\n        </tr>\n        <tr>\n          <td class=\"ypp-row-label\">Choose your layout</td>\n          <td class=\"ypp-col-ours-cell\"><span class=\"ypp-check\">✔</span></td>\n          <td class=\"ypp-col-generic-cell\"><span class=\"ypp-cross\">✗</span></td>\n        </tr>\n        <tr>\n          <td class=\"ypp-row-label\">Only the pages you need</td>\n          <td class=\"ypp-col-ours-cell\"><span class=\"ypp-check\">✔</span></td>\n          <td class=\"ypp-col-generic-cell\"><span class=\"ypp-cross\">✗</span></td>\n        </tr>\n        <tr>\n          <td class=\"ypp-row-label\">Australian made</td>\n          <td class=\"ypp-col-ours-cell\"><span class=\"ypp-check\">✔</span></td>\n          <td class=\"ypp-col-generic-cell\"><span class=\"ypp-cross\">✗</span></td>\n        </tr>\n        <tr>\n          <td class=\"ypp-row-label\">30-day money back guarantee</td>\n          <td class=\"ypp-col-ours-cell\"><span class=\"ypp-check\">✔</span></td>\n          <td class=\"ypp-col-generic-cell\"><span class=\"ypp-cross\">✗</span></td>\n        </tr>\n      </tbody>\n    </table>\n  </div>\n</section>\n\n<style>\n.ypp-comparison {\n  background-color: #fdf1f0;\n  padding: 64px 40px;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-comp-label {\n  font-size: 12px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  color: #ff9cae;\n  text-align: center;\n  margin: 0 0 8px 0;\n}\n\n.ypp-comp-title {\n  font-size: 30px;\n  font-weight: 700;\n  text-align: center;\n  color: #2d1a1a;\n  margin: 0 0 8px 0;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-comp-sub {\n  font-size: 15px;\n  color: #7a5a5a;\n  text-align: center;\n  margin: 0 0 40px 0;\n}\n\n.ypp-comp-wrap {\n  max-width: 620px;\n  margin: 0 auto;\n  border-radius: 16px;\n  overflow: hidden;\n  border: 1px solid #fad8da;\n}\n\n.ypp-comp-table {\n  width: 100%;\n  border-collapse: collapse;\n  table-layout: fixed;\n}\n\n.ypp-col-feature {\n  padding: 18px 24px;\n  text-align: left;\n  font-size: 13px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  background-color: #fdf1f0;\n  color: #2d1a1a;\n  width: 50%;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-col-ours {\n  padding: 18px 16px;\n  text-align: center;\n  font-size: 13px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  background-color: #ff4545;\n  color: #ffffff;\n  width: 25%;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-col-generic {\n  padding: 18px 16px;\n  text-align: center;\n  font-size: 13px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  background-color: #fdf1f0;\n  color: #7a5a5a;\n  width: 25%;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-row-label {\n  padding: 16px 24px;\n  font-size: 14px;\n  font-weight: 700;\n  color: #2d1a1a;\n  background-color: #fdf1f0;\n  border-top: 1px solid #fad8da;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-col-ours-cell {\n  padding: 16px;\n  text-align: center;\n  background-color: #fff8f8;\n  border-top: 1px solid #fad8da;\n}\n\n.ypp-col-generic-cell {\n  padding: 16px;\n  text-align: center;\n  background