        "custom_liquid": "<!--\n  Perfect Planner — \"back soon\" page\n  Paste this whole block into your Shopify password page code\n  (Theme editor → Edit code → sections/main-password-header.liquid or\n  password.liquid, depending on your theme). It's self-contained and\n  scoped under .pp-soon, so it won't leak styles into the rest of your\n  theme even if pasted somewhere else by mistake.\n\n  Countdown targets 6:30 PM in each visitor's own local time.\n-->\n<div class=\"pp-soon\">\n\n  <style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Poppins:wght@400;500;600;700&display=swap');\n\n    .pp-soon {\n      --pp-bg: #fad8da;      /* Perfect Light Pink */\n      --pp-red: #ff4545;     /* Perfect Red */\n      --pp-pink: #ff9cae;    /* Perfect Pink */\n      --pp-ink: #4a1712;     /* readable dark neutral for body copy */\n      --pp-white: #ffffff;\n\n      box-sizing: border-box;\n      min-height: 100vh;\n      width: 100%;\n      margin: 0;\n      padding: 1.5rem 1.5rem;\n      background: var(--pp-bg);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      font-family: 'Poppins', Arial, sans-serif;\n    }\n    .pp-soon *, .pp-soon *::before, .pp-soon *::after { box-sizing: border-box; }\n\n    .pp-soon .pp-card {\n      width: 100%;\n      max-width: 34rem;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      text-align: center;\n      gap: 1.5rem;\n    }\n\n    .pp-soon .pp-headline {\n      font-family: 'DM Serif Display', Georgia, serif;\n      font-style: italic;\n      font-weight: 400;\n      font-size: clamp(1.3rem, 3.4vw, 1.7rem);\n      line-height: 1.3;\n      color: var(--pp-red);\n      margin: 0;\n      max-width: 26rem;\n    }\n\n    .pp-soon .pp-subhead {\n      font-weight: 400;\n      font-size: 1rem;\n      line-height: 1.65;\n      color: var(--pp-ink);\n      margin: 0;\n      max-width: 27rem;\n    }\n    .pp-soon .pp-subhead strong { font-weight: 600; }\n\n    .pp-soon .pp-products {\n      display: flex;\n      flex-wrap: wrap;\n      align-items: center;\n      justify-content: center;\n      gap: .5rem .9rem;\n      font-weight: 500;\n      font-size: .78rem;\n      letter-spacing: .06em;\n      text-transform: uppercase;\n      color: var(--pp-red);\n      margin: 0;\n    }\n    .pp-soon .pp-products .pp-sep { color: var(--pp-pink); font-size: .6rem; }\n\n    .pp-soon .pp-divider {\n      width: 3.5rem;\n      height: 1px;\n      background: var(--pp-pink);\n      border: none;\n      margin: 0;\n    }\n\n    .pp-soon .pp-countdown-block {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: .5rem;\n    }\n    .pp-soon .pp-countdown-label {\n      font-weight: 600;\n      font-size: .72rem;\n      letter-spacing: .3em;\n      text-transform: uppercase;\n      color: var(--pp-ink);\n      margin: 0;\n    }\n    .pp-soon .pp-countdown {\n      font-weight: 700;\n      font-variant-numeric: tabular-nums;\n      font-size: clamp(2.4rem, 8vw, 3.4rem);\n      color: var(--pp-red);\n      line-height: 1;\n      display: flex;\n      align-items: flex-start;\n    }\n    .pp-soon .pp-countdown .pp-unit {\n      display: inline-flex;\n      flex-direction: column;\n      align-items: center;\n      gap: .3rem;\n    }\n    .pp-soon .pp-countdown .pp-sep2 {\n      padding: 0 .12em;\n      opacity: .5;\n      transform: translateY(-.08em);\n    }\n    .pp-soon .pp-countdown .pp-num { display: inline-block; min-width: 1.3ch; text-align: center; }\n    .pp-soon .pp-unit-label {\n      font-weight: 500;\n      font-size: .58rem;\n      letter-spacing: .18em;\n      text-transform: uppercase;\n      color: var(--pp-ink);\n      opacity: .7;\n    }\n\n    .pp-soon .pp-reopen {\n      font-weight: 400;\n      font-size: .85rem;\n      color: var(--pp-ink);\n      margin: 0;\n    }\n    .pp-soon .pp-reopen strong { font-weight: 600; }\n\n    @media (max-width: 30rem) {\n      .pp-soon { padding: 1.25rem 1.25rem; }\n      .pp-soon .pp-card { gap: 1.2rem; }\n      .pp-soon .pp-products { font-size: .7rem; }\n    }\n  </style>\n\n  <main class=\"pp-card\">\n    <h1 class=\"pp-headline\">We're putting the finishing touches on something perfect.</h1>\n\n    <p class=\"pp-subhead\">\n      Our <strong>biggest launch yet</strong> is almost here. We've closed the shop\n      for a little while to get everything ready — thank you for your patience.\n    </p>\n\n    <p class=\"pp-products\" aria-hidden=\"true\">\n      <span>New Cover Designs</span><span class=\"pp-sep\">&#10022;</span>\n      <span>Phone Cases</span><span class=\"pp-sep\">&#10022;</span>\n      <span>AirPod Cases</span><span class=\"pp-sep\">&#10022;</span>\n      <span>AirTag Cases</span><span class=\"pp-sep\">&#10022;</span>\n      <span>2027 Planners</span>\n    </p>\n\n    <hr class=\"pp-divider\">\n\n    <div class=\"pp-countdown-block\">\n      <p class=\"pp-countdown-label\" id=\"ppCountdownLabel\">Back online in</p>\n      <div class=\"pp-countdown\" id=\"ppCountdown\" role=\"timer\" aria-live=\"polite\">\n        <span class=\"pp-unit\"><span class=\"pp-num\" id=\"pp-h\">0</span><span class=\"pp-unit-label\">hr</span></span>\n        <span class=\"pp-sep2\" id=\"pp-sep-h\">:</span>\n        <span class=\"pp-unit\"><span class=\"pp-num\" id=\"pp-m\">00</span><span class=\"pp-unit-label\">min</span></span>\n        <span class=\"pp-sep2\">:</span>\n        <span class=\"pp-unit\"><span class=\"pp-num\" id=\"pp-s\">00</span><span class=\"pp-unit-label\">sec</span></span>\n      </div>\n      <p class=\"pp-reopen\" id=\"ppReopen\">Reopening at <strong>6:30&nbsp;PM</strong> tonight</p>\n    </div>\n  </main>\n</div>\n\n<script>\n(function () {\n  var target = new Date();\n  target.setHours(18, 30, 0, 0);\n\n  var hEl = document.getElementById('pp-h');\n  var mEl = document.getElementById('pp-m');\n  var sEl = document.getElementById('pp-s');\n  var sepH = document.getElementById('pp-sep-h');\n  var label = document.getElementById('ppCountdownLabel');\n  var block = document.getElementById('ppCountdown');\n  var reopen = document.getElementById('ppReopen');\n\n  function pad(n) { return String(n).padStart(2, '0'); }\n\n  function tick() {\n    var now = new Date();\n    var diff = target - now;\n\n    if (diff <= 0) {\n      label.textContent = \"We're back!\";\n      block.innerHTML = '<span class=\"pp-unit\"><span class=\"pp-num\">&#10022;</span></span>';\n      reopen.textContent = 'Thanks so much for your patience.';\n      return;\n    }\n\n    var totalSeconds = Math.floor(diff / 1000);\n    var h = Math.floor(totalSeconds / 3600);\n    var m = Math.floor((totalSeconds % 3600) / 60);\n    var s = totalSeconds % 60;\n\n    if (h > 0) {\n      sepH.style.display = '';\n      hEl.parentElement.style.display = '';\n      hEl.textContent = h;\n    } else {\n      sepH.style.display = 'none';\n      hEl.parentElement.style.display = 'none';\n    }\n    mEl.textContent = pad(m);\n    sEl.textContent = pad(s);\n\n    setTimeout(tick, 250);\n  }\n\n  tick();\n})();\n</script>",
