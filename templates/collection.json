    "custom_liquid_6z7Yzw": {
      "type": "custom-liquid",
      "name": "Collapsible product description",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-desc-toggle {\n    display: inline;\n    margin-left: 4px;\n    color: #ff9cae;\n    font-family: 'Poppins', sans-serif;\n    font-weight: 700;\n    text-transform: uppercase;\n    font-size: 12px;\n    letter-spacing: 0.5px;\n    text-decoration: underline;\n    cursor: pointer;\n    background: none;\n    border: none;\n    outline: none;\n    padding: 0;\n    -webkit-appearance: none;\n    appearance: none;\n  }\n  .ypp-desc-toggle:hover {\n    color: #ff4545;\n  }\n</style>\n\n<script>\n  (function() {\n    var descriptionEl = document.querySelector('.collection-hero__description .rte')\n      || document.querySelector('.collection-description .rte')\n      || document.querySelector('.rte');\n\n    if (!descriptionEl) return;\n\n    // Remove Dawn's auto-applied section padding on THIS Custom Liquid section\n    var thisSection = document.currentScript.closest('[class$=\"-padding\"]');\n    if (thisSection) {\n      thisSection.style.setProperty('padding-top', '0px', 'important');\n      thisSection.style.setProperty('padding-bottom', '0px', 'important');\n    }\n\n    var fullHTML = descriptionEl.innerHTML;\n    var fullText = descriptionEl.textContent.trim();\n\n    var match = fullText.match(/^.*?[.?!]/);\n    var previewText = match ? match[0] : fullText;\n\n    function showPreview() {\n      descriptionEl.innerHTML = '<p>' + previewText +\n        ' <button class=\"ypp-desc-toggle\" id=\"ypp-desc-btn\">Read More</button></p>';\n      document.getElementById('ypp-desc-btn').addEventListener('click', showFull);\n    }\n\n    function showFull() {\n      descriptionEl.innerHTML = fullHTML +\n        '<p><button class=\"ypp-desc-toggle\" id=\"ypp-desc-btn\">Read Less</button></p>';\n      document.getElementById('ypp-desc-btn').addEventListener('click', showPreview);\n    }\n\n    showPreview();\n  })();\n</script>",
