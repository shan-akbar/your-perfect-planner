rder-sublabel {\n    font-size: 1.2rem;\n    color: #666;\n    margin: 0 0 10px 0;\n  }\n\n  .nb-order-input {\n    width: 100%;\n    padding: 10px 12px;\n    font-size: 1.3rem;\n    border: 1px solid #ccc;\n    border-radius: 4px;\n    box-sizing: border-box;\n    font-family: 'Poppins', sans-serif;\n  }\n\n  .nb-order-input:focus {\n    outline: none;\n    border-color: #333;\n  }\n\n  .nb-error {\n    color: #c0392b;\n    font-size: 1.2rem;\n    margin-top: 6px;\n    display: none;\n  }\n\n  .nb-error.visible {\n    display: block;\n  }\n</style>\n\n<div class=\"nb-builder\">\n\n  <p class=\"nb-description\">Build a notebook that's uniquely yours. Choose the pages you want, set the order they repeat, and we'll print and bind it exactly like that.</p>\n\n  <p class=\"nb-heading\">Choose your pages</p>\n  <p class=\"nb-intro\">To view each page, refer to the product images.</p>\n\n  <div class=\"nb-category\">\n    <p class=\"nb-cat-label\">Notes &amp; Journaling</p>\n    <div class=\"nb-checkboxes\">\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Blank\"> Blank</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Brain Dump\"> Brain Dump</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Bullet Journal\"> Bullet Journal</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Meeting Notes\"> Meeting Notes</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Monthly Reflection\"> Monthly Reflection</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Notes\"> Notes</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Wins\"> Wins</label>\n    </div>\n  </div>\n\n  <div class=\"nb-category\">\n    <p class=\"nb-cat-label\">Planning &amp; Tasks</p>\n    <div class=\"nb-checkboxes\">\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Daily Plan\"> Daily Plan</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Focus & Future Tasks To-Do List\"> Focus &amp; Future Tasks To-Do List</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Home & Work To-Do List\"> Home &amp; Work To-Do List</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Monthly Tasks\"> Monthly Tasks</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"The Eisenhower Matrix (Priority Planner)\"> The Eisenhower Matrix (Priority Planner)</label>\n    </div>\n  </div>\n\n  <div class=\"nb-category\">\n    <p class=\"nb-cat-label\">Home &amp; Life</p>\n    <div class=\"nb-checkboxes\">\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Birthday Planner\"> Birthday Planner</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Cleaning Planner\"> Cleaning Planner</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Contacts\"> Contacts</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Gift Planner\"> Gift Planner</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Login Details\"> Login Details</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Packing List\"> Packing List</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Reading Log\"> Reading Log</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Shopping List\"> Shopping List</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Trip Overview\"> Trip Overview</label>\n    </div>\n  </div>\n\n  <div class=\"nb-category\">\n    <p class=\"nb-cat-label\">Health &amp; Wellness</p>\n    <div class=\"nb-checkboxes\">\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Body Measurements\"> Body Measurements</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Monthly Habit Tracker\"> Monthly Habit Tracker</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Mood Tracker\"> Mood Tracker</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Yearly Habit Tracker\"> Yearly Habit Tracker</label>\n    </div>\n  </div>\n\n  <div class=\"nb-category\">\n    <p class=\"nb-cat-label\">Food</p>\n    <div class=\"nb-checkboxes\">\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Meal Ideas\"> Meal Ideas</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Meal Plan\"> Meal Plan</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Recipe\"> Recipe</label>\n    </div>\n  </div>\n\n  <div class=\"nb-category\">\n    <p class=\"nb-cat-label\">Finance &amp; Business</p>\n    <div class=\"nb-checkboxes\">\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Business Monthly Overview\"> Business Monthly Overview</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Communication Log\"> Communication Log</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Monthly Budget\"> Monthly Budget</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Yearly Bills\"> Yearly Bills</label>\n    </div>\n  </div>\n\n  <div class=\"nb-category\">\n    <p class=\"nb-cat-label\">Study &amp; School</p>\n    <div class=\"nb-checkboxes\">\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Assessment Checklist\"> Assessment Checklist</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Assignment Planner\"> Assignment Planner</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Assignment Tracker\"> Assignment Tracker</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Semester Timetable\"> Semester Timetable</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Term Planner\"> Term Planner</label>\n      <label><input type=\"checkbox\" class=\"nb-page-check\" value=\"Weekly Study Schedule\"> Weekly Study Schedule</label>\n    </div>\n  </div>\n\n  <div class=\"nb-banner\" id=\"nb-banner\">\n    Each page type will repeat <strong><span id=\"nb-repeat-count\">—</span> times</strong>\n    <div class=\"nb-warning\" id=\"nb-uneven-warning\">\n      Note: 200 pages doesn't divide evenly into your selection. We'll round to the nearest whole repeat.\n    </div>\n  </div>\n\n  <label class=\"nb-order-label\" for=\"nb-order-input\">Specify your page order</label>\n  <p class=\"nb-order-sublabel\">List your selected pages in the order you'd like them to repeat, separated by commas.</p>\n  <input\n    type=\"text\"\n    id=\"nb-order-input\"\n    class=\"nb-order-input\"\n    name=\"properties[Page Order]\"\n    placeholder=\"e.g. Notes, Budget, Habit Tracker\"\n    autocomplete=\"off\"\n  >\n  <p class=\"nb-error\" id=\"nb-error-pages\">Please select at least one page type before adding to cart.</p>\n  <p class=\"nb-error\" id=\"nb-error-order\">Please specify your page order before adding to cart.</p>\n\n  <input type=\"hidden\" name=\"properties[Pages Selected]\" id=\"nb-pages-prop\">\n  <input type=\"hidden\" name=\"properties[Repeats Per Page]\" id=\"nb-repeats-prop\">\n  <input type=\"hidden\" name=\"properties[Total Pages]\" value=\"200\">\n\n</div>\n\n<script>\n  (function () {\n    var TOTAL_PAGES = 200;\n\n    var checkboxes   = document.querySelectorAll('.nb-page-check');\n    var banner       = document.getElementById('nb-banner');\n    var repeatCount  = document.getElementById('nb-repeat-count');\n    var unevenWarn   = document.getElementById('nb-uneven-warning');\n    var pagesProp    = document.getElementById('nb-pages-prop');\n    var repeatsProp  = document.getElementById('nb-repeats-prop');\n    var orderInput   = document.getElementById('nb-order-input');\n    var errorPages   = document.getElementById('nb-error-pages');\n    var errorOrder   = document.getElementById('nb-error-order');\n\n    function getChecked() {\n      return Array.from(checkboxes).filter(function (cb) { return cb.checked; });\n    }\n\n    function updateBanner() {\n      var checked = getChecked();\n      var count   = checked.length;\n\n      if (count === 0) {\n        banner.classList.remove('visible');\n        pagesProp.value   = '';\n        repeatsProp.value = '';\n        return;\n      }\n\n      var repeats      = TOTAL_PAGES / count;\n      var isEven       = Number.isInteger(repeats);\n      var displayReps  = isEven ? repeats : Math.round(repeats);\n\n      repeatCount.textContent = displayReps;\n      banner.classList.add('visible');\n      unevenWarn.classList.toggle('visible', !isEven);\n\n      pagesProp.value   = checked.map(function (cb) { return cb.value; }).join(', ');\n      repeatsProp.value = displayReps + 'x';\n    }\n\n    checkboxes.forEach(function (cb) {\n      cb.addEventListener('change', updateBanner);\n    });\n\n    var form = document.querySelector('form[action=\"/cart/add\"]');\n    if (form) {\n      form.addEventListener('submit', function (e) {\n        var checked      = getChecked();\n        var orderVal     = orderInput.value.trim();\n        var pagesOk      = checked.length > 0;\n        var orderOk      = orderVal.length > 0;\n\n        errorPages.classList.toggle('visible', !pagesOk);\n        errorOrder.classList.toggle('visible', !orderOk);\n\n        if (!pagesOk || !orderOk) {\n          e.preventDefault();\n          e.stopImmediatePropagation();\n        }\n      });\n    }\n\n    updateBanner();\n  })();\n</script>"
