bel\">Finance &amp; Business</p>\n    <div class=\"nb-checkboxes\">\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Business Monthly Overview\"><span class=\"nb-page-name\">Business Monthly Overview</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Communication Log\"><span class=\"nb-page-name\">Communication Log</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Debt Payoff Tracker\"><span class=\"nb-page-name\">Debt Payoff Tracker</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Monthly Budget\"><span class=\"nb-page-name\">Monthly Budget</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Subscription Tracker\"><span class=\"nb-page-name\">Subscription Tracker</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Yearly Bills\"><span class=\"nb-page-name\">Yearly Bills</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"52 Week Savings Challenge\"><span class=\"nb-page-name\">52 Week Savings Challenge</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n    </div>\n  </div>\n\n  <div class=\"nb-category\">\n    <p class=\"nb-cat-label\">Study &amp; School</p>\n    <div class=\"nb-checkboxes\">\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Assignment Planner\"><span class=\"nb-page-name\">Assignment Planner</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Assessment Tracker\"><span class=\"nb-page-name\">Assessment Tracker</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Semester Timetable\"><span class=\"nb-page-name\">Semester Timetable</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Term Planner\"><span class=\"nb-page-name\">Term Planner</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n      <label class=\"nb-page-label\"><input type=\"checkbox\" class=\"nb-page-check\" value=\"Weekly Study Schedule\"><span class=\"nb-page-name\">Weekly Study Schedule</span><div class=\"nb-qty-wrap\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"-1\">−</button><input type=\"number\" class=\"nb-qty-val\" value=\"1\" min=\"1\" max=\"150\"><button type=\"button\" class=\"nb-qty-btn\" data-dir=\"1\">+</button></div></label>\n    </div>\n  </div>\n\n  <!-- Repeated sequence UI -->\n  <div id=\"nb-repeated-ui\">\n    <div class=\"nb-banner\" id=\"nb-banner\">\n      Each page type will repeat <strong><span id=\"nb-repeat-count\">—</span> times</strong>\n      <div class=\"nb-warning\" id=\"nb-uneven-warning\">\n        Note: 150 pages doesn't divide evenly into your selection. We'll round to the nearest whole repeat.\n      </div>\n    </div>\n    <label class=\"nb-order-label\" for=\"nb-order-input\">Specify your page order</label>\n    <p class=\"nb-order-sublabel\">List your selected pages in the order you'd like them to repeat, separated by commas.</p>\n    <input type=\"text\" id=\"nb-order-input\" class=\"nb-order-input\" placeholder=\"e.g. Lined Notes, Daily Plan, Monthly Budget\" autocomplete=\"off\">\n  </div>\n\n  <!-- Grouped pages UI -->\n  <div id=\"nb-grouped-ui\" style=\"display:none\">\n    <div class=\"nb-total-wrap\">\n      <div class=\"nb-total-display\" id=\"nb-total-display\">0 / 150 pages selected</div>\n      <div class=\"nb-total-bar-wrap\">\n        <div class=\"nb-total-bar\" id=\"nb-total-bar\"></div>\n      </div>\n    </div>\n    <label class=\"nb-order-label\" for=\"nb-grouped-order-input\">Specify your page order</label>\n    <p class=\"nb-order-sublabel\">List your selected pages in the order you'd like them arranged, separated by commas.</p>\n    <input type=\"text\" id=\"nb-grouped-order-input\" class=\"nb-order-input\" placeholder=\"e.g. Daily Plan, Lined Notes, Monthly Budget\" autocomplete=\"off\">\n  </div>\n\n  <!-- Errors -->\n  <p class=\"nb-error\" id=\"nb-error-pages\">Please select at least one page type before adding to cart.</p>\n  <p class=\"nb-error\" id=\"nb-error-order\">Please specify your page order before adding to cart.</p>\n  <p class=\"nb-error\" id=\"nb-error-total\">Your page total must equal exactly 150. Please adjust your quantities.</p>\n\n  <!-- Hidden Shopify order properties -->\n  <input type=\"hidden\" name=\"properties[Notebook Structure]\" id=\"nb-type-prop\">\n  <input type=\"hidden\" name=\"properties[Pages Selected]\" id=\"nb-pages-prop\">\n  <input type=\"hidden\" name=\"properties[Page Order]\" id=\"nb-order-prop\">\n  <input type=\"hidden\" name=\"properties[Page Breakdown]\" id=\"nb-breakdown-prop\">\n  <input type=\"hidden\" name=\"properties[Repeats Per Page]\" id=\"nb-repeats-prop\">\n  <input type=\"hidden\" name=\"properties[Total Pages]\" value=\"150\">\n\n</div>\n\n<script>\n  (function () {\n    var TOTAL_PAGES  = 150;\n    var currentMode  = 'repeated';\n\n    var builder      = document.getElementById('nb-builder');\n    var modeBtns     = document.querySelectorAll('.nb-mode-btn');\n    var checkboxes   = document.querySelectorAll('.nb-page-check');\n\n    var banner       = document.getElementById('nb-banner');\n    var repeatCount  = document.getElementById('nb-repeat-count');\n    var unevenWarn   = document.getElementById('nb-uneven-warning');\n    var repeatedUI   = document.getElementById('nb-repeated-ui');\n    var orderInput   = document.getElementById('nb-order-input');\n\n    var groupedUI         = document.getElementById('nb-grouped-ui');\n    var groupedOrderInput = document.getElementById('nb-grouped-order-input');\n    var totalDisplay = document.getElementById('nb-total-display');\n    var totalBar     = document.getElementById('nb-total-bar');\n\n    var typeProp      = document.getElementById('nb-type-prop');\n    var pagesProp     = document.getElementById('nb-pages-prop');\n    var orderProp     = document.getElementById('nb-order-prop');\n    var breakdownProp = document.getElementById('nb-breakdown-prop');\n    var repeatsProp   = document.getElementById('nb-repeats-prop');\n\n    var errorPages = document.getElementById('nb-error-pages');\n    var errorOrder = document.getElementById('nb-error-order');\n    var errorTotal = document.getElementById('nb-error-total');\n\n    function getChecked() {\n      return Array.from(checkboxes).filter(function (cb) { return cb.checked; });\n    }\n\n    function getQty(cb) {\n      var input = cb.closest('.nb-page-label').querySelector('.nb-qty-val');\n      var val   = input ? parseInt(input.value, 10) : 1;\n      return isNaN(val) || val < 1 ? 1 : val;\n    }\n\n    function switchMode(mode) {\n      currentMode = mode;\n      typeProp.value = mode === 'repeated' ? 'Repeated Sequence' : 'Grouped Pages';\n\n      modeBtns.forEach(function (btn) {\n        btn.classList.toggle('active', btn.dataset.mode === mode);\n      });\n\n      errorPages.classList.remove('visible');\n      errorOrder.classList.remove('visible');\n      errorTotal.classList.remove('visible');\n\n      if (mode === 'repeated') {\n        repeatedUI.style.display = '';\n        groupedUI.style.display = 'none';\n        builder.classList.remove('nb-grouped-active');\n        document.querySelectorAll('.nb-qty-wrap').forEach(function (w) {\n          w.style.display = 'none';\n        });\n        updateRepeated();\n      } else {\n        repeatedUI.style.display = 'none';\n        groupedUI.style.display = '';\n        builder.classList.add('nb-grouped-active');\n        checkboxes.forEach(function (cb) {\n          var wrap = cb.closest('.nb-page-label').querySelector('.nb-qty-wrap');\n          if (wrap) wrap.style.display = cb.checked ? 'flex' : 'none';\n        });\n        updateGrouped();\n      }\n    }\n\n    function updateRepeated() {\n      var checked = getChecked();\n      var count   = checked.length;\n\n      if (count === 0) {\n        banner.classList.remove('visible');\n        pagesProp.value   = '';\n        repeatsProp.value = '';\n        return;\n      }\n\n      var repeats     = TOTAL_PAGES / count;\n      var isEven      = Number.isInteger(repeats);\n      var displayReps = isEven ? repeats : Math.round(repeats);\n\n      repeatCount.textContent = displayReps;\n      banner.classList.add('visible');\n      unevenWarn.classList.toggle('visible', !isEven);\n\n      pagesProp.value   = checked.map(function (cb) { return cb.value; }).join(', ');\n      repeatsProp.value = displayReps + 'x';\n    }\n\n    function updateGrouped() {\n      var checked = getChecked();\n      var total   = checked.reduce(function (sum, cb) { return sum + getQty(cb); }, 0);\n      var pct     = Math.min(100, (total / TOTAL_PAGES) * 100);\n\n      totalDisplay.textContent = total + ' / ' + TOTAL_PAGES + ' pages selected';\n      totalDisplay.className = 'nb-total-display';\n\n      if (total === TOTAL_PAGES) {\n        totalDisplay.classList.add('nb-total-exact');\n      } else if (total > TOTAL_PAGES) {\n        totalDisplay.classList.add('nb-total-over');\n      } else if (total > 0) {\n        totalDisplay.classList.add('nb-total-under');\n      }\n\n      totalBar.style.width = pct + '%';\n\n      if (checked.length > 0) {\n        breakdownProp.value = checked.map(function (cb) {\n          return cb.value + ' \\xd7' + getQty(cb);\n        }).join(', ');\n        pagesProp.value = checked.map(function (cb) { return cb.value; }).join(', ');\n      } else {\n        breakdownProp.value = '';\n        pagesProp.value     = '';\n      }\n    }\n\n    modeBtns.forEach(function (btn) {\n      btn.addEventListener('click', function () { switchMode(btn.dataset.mode); });\n    });\n\n    checkboxes.forEach(function (cb) {\n      cb.addEventListener('change', function () {\n        var wrap = this.closest('.nb-page-label').querySelector('.nb-qty-wrap');\n\n        if (currentMode === 'grouped' && wrap) {\n          wrap.style.display = this.checked ? 'flex' : 'none';\n        }\n\n        if (currentMode === 'repeated') { updateRepeated(); } else { updateGrouped(); }\n        errorPages.classList.remove('visible');\n      });\n    });\n\n    document.querySelectorAll('.nb-qty-btn').forEach(function (btn) {\n      btn.addEventListener('click', function () {\n        var label   = this.closest('.nb-page-label');\n        var valEl   = label.querySelector('.nb-qty-val');\n        var dir     = parseInt(this.dataset.dir, 10);\n        var current = parseInt(valEl.value, 10) || 1;\n        var newVal  = Math.max(1, Math.min(TOTAL_PAGES, current + dir));\n        valEl.value = newVal;\n        updateGrouped();\n        errorTotal.classList.remove('visible');\n      });\n    });\n\n    document.querySelectorAll('.nb-qty-val').forEach(function (input) {\n      input.addEventListener('input', function () {\n        var val = parseInt(this.value, 10);\n        if (isNaN(val) || val < 1) { this.value = 1; }\n        if (val > TOTAL_PAGES)     { this.value = TOTAL_PAGES; }\n        updateGrouped();\n        errorTotal.classList.remove('visible');\n      });\n    });\n\n    if (orderInput) {\n      orderInput.addEventListener('input', function () {\n        orderProp.value = this.value;\n      });\n    }\n\n    if (groupedOrderInput) {\n      groupedOrderInput.addEventListener('input', function () {\n        orderProp.value = this.value;\n      });\n    }\n\n    var form = document.querySelector('form[action=\"/cart/add\"]');\n    if (form) {\n      form.addEventListener('submit', function (e) {\n        var checked  = getChecked();\n        /* Sync order inputs one final time in case AJAX cart fires before input event */\n        if (currentMode === 'repeated' && orderInput) orderProp.value = orderInput.value;\n        if (currentMode === 'grouped' && groupedOrderInput) orderProp.value = groupedOrderInput.value;\n        var pagesOk  = checked.length > 0;\n        var valid    = true;\n\n        errorPages.classList.toggle('visible', !pagesOk);\n        if (!pagesOk) valid = false;\n\n        if (currentMode === 'repeated') {\n          typeProp.value = 'Repeated Sequence';\n          var orderVal   = orderInput ? orderInput.value.trim() : '';\n          var orderOk    = orderVal.length > 0;\n          errorOrder.classList.toggle('visible', !orderOk);\n          errorTotal.classList.remove('visible');\n          if (orderProp) orderProp.value = orderVal;\n          if (!orderOk) valid = false;\n        } else {\n          typeProp.value = 'Grouped Pages';\n          var total      = checked.reduce(function (s, cb) { return s + getQty(cb); }, 0);\n          var totalOk    = total === TOTAL_PAGES;\n          var gOrderVal  = groupedOrderInput ? groupedOrderInput.value.trim() : '';\n          var gOrderOk   = gOrderVal.length > 0;\n          errorTotal.classList.toggle('visible', !totalOk);\n          errorOrder.classList.toggle('visible', !gOrderOk);\n          if (orderProp) orderProp.value = gOrderVal;\n          if (!totalOk || !gOrderOk) valid = false;\n        }\n\n        if (!valid) {\n          e.preventDefault();\n          e.stopImmediatePropagation();\n        }\n      }, true); /* capture phase — fires before theme's AJAX cart listener */\n    }\n\n    /* Inject our properties directly into the cart/add fetch request.\n       Shopify's theme builds FormData manually rather than using new FormData(form),\n       so hidden inputs in the DOM are bypassed. We intercept the fetch and append\n       our values before the request is sent. On success we redirect to the cover\n       page so the customer can select their notebook cover. */\n    (function () {\n      var COVER_URL = 'https://yourperfectplanner.com.au/products/planner-cover?_pos=1&_psq=planner+cover&_psid=350e4bd9f&_ss=e&_v=1.0';\n      var origFetch = window.fetch;\n      window.fetch = function (url, options) {\n        if (typeof url === 'string' && url.indexOf('cart/add') > -1 &&\n            options && options.body instanceof FormData) {\n          var fd = options.body;\n          var props = [typeProp, pagesProp, orderProp, breakdownProp, repeatsProp];\n          props.forEach(function (inp) {\n            if (inp && inp.name && inp.value) fd.append(inp.name, inp.value);\n          });\n          fd.append('properties[Total Pages]', '150');\n          return origFetch.apply(this, arguments).then(function (response) {\n            if (response.ok) {\n              window.location.href = COVER_URL;\n            }\n            return response;\n          });\n        }\n        return origFetch.apply(this, arguments);\n      };\n    })();\n\n    typeProp.value = 'Repeated Sequence';\n  })();\n</script>"
          }
        },
