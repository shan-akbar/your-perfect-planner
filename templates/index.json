    "custom_liquid_qmhHEJ": {
      "type": "custom-liquid",
      "name": "Reviews",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-reviews { padding: 6rem 5rem; background: #ffffff; }\n  .ypp-reviews-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem; margin-top: 3rem; }\n  .ypp-review-card {\n    border: 1.5px solid #f0d4d4; padding: 2rem; border-radius: 20px;\n    background: #fdf1f0; transition: transform 0.2s, box-shadow 0.2s;\n  }\n  .ypp-review-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(255,156,174,0.2); }\n  .ypp-review-stars { color: #f6b78a; font-size: 1.4rem; margin-bottom: 1rem; letter-spacing: 0.1em; }\n  .ypp-review-text {\n    font-family: 'Poppins', sans-serif; font-size: 1.2rem;\n    line-height: 1.8; color: #2d1f1f; margin-bottom: 1.5rem; font-weight: 300;\n  }\n  .ypp-review-author {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.85rem; color: #7a5c5c; font-weight: 700;\n    text-transform: uppercase; letter-spacing: 0.1em;\n  }\n  .ypp-review-tag {\n    display: inline-block; margin-top: 0.5rem;\n    background: #fad8da; color: #ff4545;\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.72rem; padding: 0.25rem 0.75rem; border-radius: 999px;\n    letter-spacing: 0.08em; text-transform: uppercase; font-weight: 700;\n  }\n  @media (max-width: 768px) {\n    .ypp-reviews { padding: 4rem 1.5rem; }\n    .ypp-reviews-grid { grid-template-columns: 1fr; }\n  }\n</style>\n\n<section class=\"ypp-reviews\">\n  <div class=\"ypp-section-label\">Real customers, real results</div>\n  <h2 class=\"ypp-section-heading\">They couldn't find the right planner either. <em>Until now.</em></h2>\n  <div class=\"ypp-reviews-grid\">\n    <div class=\"ypp-review-card\">\n      <div class=\"ypp-review-stars\">★★★★★</div>\n      <div class=\"ypp-review-text\">This diary is the only thing that has really helped me stay on top of my appointments and schedule. With my ADHD, any time I try to keep a diary I always stop a couple of months in, but not this one.</div>\n      <div class=\"ypp-review-author\">Tara G.</div>\n      <div class=\"ypp-review-tag\">Custom Weekly Planner</div>\n    </div>\n    <div class=\"ypp-review-card\">\n      <div class=\"ypp-review-stars\">★★★★★</div>\n      <div class=\"ypp-review-text\">I was so impressed with my work planner I did something I haven't done for years: bought one for personal use too. Express really meant express, it arrived in two days. Jess couldn't have been more accommodating.</div>\n      <div class=\"ypp-review-author\">Kylie B.</div>\n      <div class=\"ypp-review-tag\">Custom Weekly Planner</div>\n    </div>\n    <div class=\"ypp-review-card\">\n      <div class=\"ypp-review-stars\">★★★★★</div>\n      <div class=\"ypp-review-text\">Not only is this the most stunning planner I've ever owned, it's so well thought out with unique and useful features. If you're on the fence just buy it. You'll be supporting the sweetest small business owner too.</div>\n      <div class=\"ypp-review-author\">Gina U.</div>\n      <div class=\"ypp-review-tag\">2026 Business Planner</div>\n    </div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_FAGPQJ": {
      "type": "custom-liquid",
      "name": "Notebooks",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-carousel { padding: 4rem 0 4rem 5rem; background: #ffffff; }\n  .ypp-carousel.bg-base { background: #fdf1f0; }\n  .ypp-carousel-header {\n    display: flex; align-items: center; justify-content: space-between;\n    padding-right: 5rem; margin-bottom: 1.5rem;\n  }\n  .ypp-carousel-heading {\n    font-family: 'Poppins', sans-serif; font-size: 1.4rem;\n    font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #2d1f1f;\n  }\n  .ypp-carousel-view-all {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.8rem; font-weight: 700; text-transform: uppercase;\n    letter-spacing: 0.1em; color: #ff4545; text-decoration: none;\n    border-bottom: 2px solid #ff9cae; padding-bottom: 2px; white-space: nowrap;\n  }\n  .ypp-carousel-track {\n    display: flex; gap: 1.25rem;\n    overflow-x: auto; scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    padding-right: 5rem; padding-bottom: 1rem;\n    scrollbar-width: none;\n  }\n  .ypp-carousel-track::-webkit-scrollbar { display: none; }\n  .ypp-product-card {\n    flex: 0 0 240px; scroll-snap-align: start;\n    border-radius: 16px; overflow: hidden;\n    border: 1.5px solid #f0d4d4; background: #ffffff;\n    text-decoration: none; color: #2d1f1f;\n    transition: transform 0.2s, box-shadow 0.2s; display: block;\n  }\n  .ypp-product-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(255,156,174,0.2); }\n  .ypp-product-img {\n    width: 100%; height: 220px; background: #fad8da;\n    overflow: hidden; display: flex; align-items: center; justify-content: center;\n  }\n  .ypp-product-img img { width: 100%; height: 100%; object-fit: cover; }\n  .ypp-product-info { padding: 1rem 1.1rem 1.1rem; }\n  .ypp-product-name {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.95rem; font-weight: 700; text-transform: uppercase;\n    letter-spacing: 0.05em; color: #2d1f1f; margin-bottom: 0.4rem; line-height: 1.4;\n  }\n  .ypp-product-price {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.95rem; font-weight: 700;\n    color: #ff4545;\n  }\n  @media (max-width: 768px) {\n    .ypp-carousel { padding: 3rem 0 3rem 1.5rem; }\n    .ypp-carousel-header { padding-right: 1.5rem; }\n    .ypp-carousel-track { padding-right: 1.5rem; }\n  }\n</style>\n\n{% assign notebook_collection = collections['notebooks'] %}\n<section class=\"ypp-carousel bg-base\">\n  <div class=\"ypp-carousel-header\">\n    <h2 class=\"ypp-carousel-heading\">Notebooks</h2>\n    <a href=\"{{ notebook_collection.url }}\" class=\"ypp-carousel-view-all\">View all →</a>\n  </div>\n  <div class=\"ypp-carousel-track\">\n    {% for product in notebook_collection.products %}\n    <a href=\"{{ product.url }}\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img\n          src=\"{{ product.featured_image | image_url: width: 600 }}\"\n          srcset=\"\n            {{ product.featured_image | image_url: width: 300 }} 300w,\n            {{ product.featured_image | image_url: width: 600 }} 600w,\n            {{ product.featured_image | image_url: width: 900 }} 900w\n          \"\n          sizes=\"(max-width: 768px) 100vw, 417px\"\n          width=\"417\"\n          height=\"555\"\n          loading=\"lazy\"\n          alt=\"{{ product.featured_image.alt | default: product.title }}\"\n          style=\"max-width:100%; height:auto; display:block;\">\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">{{ product.title }}</div>\n        <div class=\"ypp-product-price\">\n          {% if product.price_varies %}\n            From {{ product.price_min | money }}\n          {% else %}\n            {{ product.price | money }}\n          {% endif %}\n        </div>\n      </div>\n    </a>\n    {% endfor %}\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_PcdfK3": {
      "type": "custom-liquid",
      "name": "Emotional Strip",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-emotion {\n    background: #ff9cae;\n    padding: 4rem 5rem;\n    display: flex;\n    flex-direction: row;\n    align-items: flex-start;\n    box-sizing: border-box;\n    width: 100%;\n  }\n  .ypp-emotion-item {\n    flex: 1 1 0;\n    min-width: 0;\n    text-align: center;\n    padding: 0 2rem;\n  }\n  .ypp-emotion-divider {\n    flex: 0 0 1px;\n    background: rgba(255,255,255,0.35);\n    align-self: stretch;\n    min-height: 120px;\n  }\n  .ypp-emotion-icon {\n    font-size: 1.8rem;\n    margin-bottom: 1rem;\n    width: 60px; height: 60px; border-radius: 50%;\n    background: white;\n    display: flex; align-items: center; justify-content: center;\n    margin-left: auto; margin-right: auto;\n  }\n  .ypp-emotion-heading {\n    font-family: 'Wild Mango', cursive;\n    font-size: 1.6rem; color: #ffffff;\n    margin-bottom: 0.6rem; font-weight: normal; line-height: 1.3;\n    word-wrap: break-word;\n  }\n  .ypp-emotion-body {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.1rem; color: #ffffff; line-height: 1.7; font-weight: 400;\n    word-wrap: break-word;\n  }\n  @media (max-width: 768px) {\n    .ypp-emotion {\n      flex-direction: column;\n      padding: 3rem 1.5rem;\n    }\n    .ypp-emotion-item {\n      padding: 1.5rem 0;\n      border-bottom: 1px solid rgba(255,255,255,0.3);\n      text-align: center;\n      width: 100%;\n    }\n    .ypp-emotion-item:last-child { border-bottom: none; }\n    .ypp-emotion-divider { display: none; }\n  }\n</style>\n\n<div class=\"ypp-emotion\">\n  <div class=\"ypp-emotion-item\">\n    <div class=\"ypp-emotion-icon\">🧠</div>\n    <div class=\"ypp-emotion-heading\">Stop carrying it all in your head</div>\n    <div class=\"ypp-emotion-body\">Free up mental space for the things that actually matter. Your planner holds the rest.</div>\n  </div>\n  <div class=\"ypp-emotion-divider\"></div>\n  <div class=\"ypp-emotion-item\">\n    <div class=\"ypp-emotion-icon\">✨</div>\n    <div class=\"ypp-emotion-heading\">Feel in control every single day</div>\n    <div class=\"ypp-emotion-body\">Start each morning knowing exactly what's ahead and end each day with a real sense of progress.</div>\n  </div>\n  <div class=\"ypp-emotion-divider\"></div>\n  <div class=\"ypp-emotion-item\">\n    <div class=\"ypp-emotion-icon\">📖</div>\n    <div class=\"ypp-emotion-heading\">A planner you'll actually use</div>\n    <div class=\"ypp-emotion-body\">Because it's built around your life. Not the other way around.</div>\n  </div>\n</div>",
