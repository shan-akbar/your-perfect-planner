        "custom_liquid": "<section class=\"ypp-carousel\">\n  <div class=\"ypp-carousel-header\">\n    <h2 class=\"ypp-carousel-heading\">Undated Planners</h2>\n    <a href=\"/collections/custom-undated-planners\" class=\"ypp-carousel-view-all\">View all →</a>\n  </div>\n  <div class=\"ypp-carousel-track\">\n    <a href=\"/products/undated-weekly-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Undated_weekly_vertical_unlined_2_1.webp?v=1784205119\" alt=\"Custom Undated Weekly Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">Custom Undated Weekly Planner</div>\n        <div class=\"ypp-product-price\">From $32.48</div>\n      </div>\n    </a>\n    <a href=\"/products/undated-daily-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Undated_biz_daily_1.webp?v=1784202161\" alt=\"Custom Undated Daily Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">Custom Undated Daily Planner</div>\n        <div class=\"ypp-product-price\">From $45.86</div>\n      </div>\n    </a>\n  </div>\n</section>",
