{
  "sections": {
    "custom_liquid_C8wq6B": {
      "type": "custom-liquid",
      "name": "Collection Menu",
      "settings": {
        "custom_liquid": "{% comment %}\n  Your Perfect Planner — Collection Menu (Custom Liquid version)\n\n  HOW TO EDIT THE LIST OF COLLECTIONS\n  Edit the handles below. A handle is the last part of a collection's URL.\n  e.g. if the collection URL is /collections/custom-planners, the handle is \"custom-planners\".\n  Order here = order shown on the site. Add or remove handles as needed (comma separated, no spaces around commas).\n\n  Each circle automatically pulls its image, title and link straight from that collection in Shopify\n  (Products > Collections > [collection] > Image). Nothing else to upload or configure.\n{% endcomment %}\n{% assign ypp_handles = \"planners,adhd-planner,phone-airpod-airtag-cases,built-by-us,notebooks,accessories,custom-undated-planners,journals\" | split: \",\" %}\n\n{% comment %}\n  LINK OVERRIDES\n  Use this if you want a specific circle to link to a PRODUCT instead of its collection page\n  (the circle image and label still come from the collection above, only the click destination changes).\n  List the collection handle on the left, the product handle it should link to on the right, separated by a colon.\n  Multiple overrides are comma separated, e.g. \"adhd-planner:adhd-planner-2026,accessories:some-product-handle\"\n  Leave blank (\"\") if you don't need this.\n{% endcomment %}\n{% assign ypp_link_overrides = \"adhd-planner:adhd-planner\" | split: \",\" %}\n\n<style>\n  @font-face {\n    font-family: 'Wild Mango';\n    src: url('https://cdn.shopify.com/s/files/1/0870/1021/4194/files/WildMango.otf?v=1732748528') format('opentype');\n    font-display: swap;\n  }\n\n  .ypp-collection-menu {\n    background: #ffffff;\n    padding: 0;\n  }\n  .ypp-collection-menu__inner {\n    max-width: 1200px;\n    margin: 0 auto;\n    padding: 0 1.5rem;\n  }\n  .ypp-collection-menu__heading {\n    font-family: 'Wild Mango', serif;\n    font-weight: 400;\n    font-size: 2rem;\n    text-align: center;\n    color: #3a2e2e;\n    margin: 0 0 1.5rem;\n  }\n  .ypp-collection-menu__list {\n    display: flex;\n    align-items: flex-start;\n    justify-content: flex-start;\n    gap: 1.75rem;\n    margin: 0;\n    padding: 0.25rem 0 0.5rem;\n    list-style: none;\n    overflow-x: auto;\n    scroll-snap-type: x proximity;\n    -webkit-overflow-scrolling: touch;\n    scrollbar-width: none;\n  }\n  .ypp-collection-menu__list::-webkit-scrollbar { display: none; }\n  @media screen and (min-width: 990px) {\n    .ypp-collection-menu__list { justify-content: center; gap: 2.5rem; }\n  }\n  .ypp-collection-menu__item { flex: 0 0 auto; scroll-snap-align: start; }\n  .ypp-collection-menu__link {\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    gap: 0.6rem;\n    text-decoration: none;\n    width: 76px;\n  }\n  @media screen and (min-width: 990px) {\n    .ypp-collection-menu__link { width: 110px; }\n  }\n  .ypp-collection-menu__circle {\n    display: block;\n    width: 76px;\n    height: 76px;\n    border-radius: 50%;\n    overflow: hidden;\n    background: #ff9cae;\n    border: 2px solid transparent;\n    transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;\n  }\n  @media screen and (min-width: 990px) {\n    .ypp-collection-menu__circle { width: 110px; height: 110px; }\n  }\n  .ypp-collection-menu__circle img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n    display: block;\n  }\n  .ypp-collection-menu__fallback {\n    width: 100%;\n    height: 100%;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-family: 'Wild Mango', serif;\n    font-size: 1.75rem;\n    color: #ff4545;\n    background: #fdf1f0;\n  }\n  .ypp-collection-menu__link:hover .ypp-collection-menu__circle,\n  .ypp-collection-menu__link:focus-visible .ypp-collection-menu__circle {\n    border-color: #ff4545;\n    transform: translateY(-3px);\n    box-shadow: 0 6px 14px rgba(0, 0, 0, 0.08);\n  }\n  .ypp-collection-menu__item.is-active .ypp-collection-menu__circle {\n    border-color: #ff4545;\n    box-shadow: 0 0 0 3px rgba(255, 69, 69, 0.15);\n  }\n  .ypp-collection-menu__label {\n    font-family: 'Poppins', sans-serif;\n    font-weight: 700;\n    text-transform: uppercase;\n    font-size: 0.85rem;\n    letter-spacing: 0.04em;\n    text-align: center;\n    color: #3a2e2e;\n    line-height: 1.25;\n  }\n  @media screen and (min-width: 990px) {\n    .ypp-collection-menu__label { font-size: 1rem; }\n  }\n  .ypp-collection-menu__item.is-active .ypp-collection-menu__label { color: #ff4545; }\n\n  @media (prefers-reduced-motion: reduce) {\n    .ypp-collection-menu__circle { transition: none; }\n  }\n</style>\n\n<div class=\"ypp-collection-menu\">\n  <div class=\"ypp-collection-menu__inner\">\n    <ul class=\"ypp-collection-menu__list\" role=\"list\">\n      {%- for handle in ypp_handles -%}\n        {%- assign coll = collections[handle] -%}\n        {%- if coll != blank -%}\n          {%- assign menu_link = coll.url -%}\n          {%- for override in ypp_link_overrides -%}\n            {%- assign override_parts = override | split: ':' -%}\n            {%- if override_parts[0] == handle and override_parts[1] != blank -%}\n              {%- assign override_product = all_products[override_parts[1]] -%}\n              {%- if override_product != blank -%}\n                {%- assign menu_link = override_product.url -%}\n              {%- endif -%}\n            {%- endif -%}\n          {%- endfor -%}\n          {%- assign is_active = false -%}\n          {%- if collection != blank and collection.handle == coll.handle -%}\n            {%- assign is_active = true -%}\n          {%- endif -%}\n          <li class=\"ypp-collection-menu__item {% if is_active %}is-active{% endif %}\">\n            <a href=\"{{ menu_link }}\" class=\"ypp-collection-menu__link\">\n              <span class=\"ypp-collection-menu__circle\">\n                {%- if coll.image -%}\n                  <img\n                    src=\"{{ coll.image | image_url: width: 300 }}\"\n                    srcset=\"{{ coll.image | image_url: width: 150 }} 150w, {{ coll.image | image_url: width: 300 }} 300w\"\n                    sizes=\"(max-width: 749px) 76px, 110px\"\n                    alt=\"{{ coll.image.alt | default: coll.title }}\"\n                    width=\"300\"\n                    height=\"300\"\n                    loading=\"lazy\"\n                  >\n                {%- else -%}\n                  <span class=\"ypp-collection-menu__fallback\">{{ coll.title | slice: 0, 1 }}</span>\n                {%- endif -%}\n              </span>\n              <span class=\"ypp-collection-menu__label\">{{ coll.title }}</span>\n            </a>\n          </li>\n        {%- endif -%}\n      {%- endfor -%}\n    </ul>\n  </div>\n</div>\n\n<script>\n  (function () {\n    var wrapper = document.currentScript.closest('[class$=\"-padding\"]');\n    if (wrapper) {\n      wrapper.style.paddingTop = '16px';\n      wrapper.style.paddingBottom = '16px';\n    }\n  })();\n</script>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_LYTCzi": {
      "type": "custom-liquid",
      "name": "Hero banner",
      "settings": {
        "custom_liquid": "<style>\n  @font-face {\n    font-family: 'Wild Mango';\n    src: url('https://cdn.shopify.com/s/files/1/0870/1021/4194/files/WildMango.otf?v=1732748528') format('opentype');\n    font-weight: normal; font-style: normal;\n  }\n  .ypp-hero {\n    position: relative;\n    min-height: 90vh;\n    display: flex; flex-direction: column; justify-content: flex-start;\n    overflow: hidden;\n  }\n  .ypp-hero-bg {\n    position: absolute; inset: 0; z-index: 0;\n    width: 100%; height: 100%;\n    object-fit: cover; object-position: center 18%;\n  }\n  .ypp-hero-bg-desktop { display: none; }\n  .ypp-hero-bg-mobile { display: block; }\n  .ypp-hero-left {\n    position: relative; z-index: 2;\n    display: flex; flex-direction: column; align-items: flex-start;\n    padding: 3.5rem 5rem 3rem 5rem; max-width: 640px;\n  }\n  .ypp-trust-bar {\n    position: absolute; bottom: 2.5rem; left: 5rem; z-index: 3;\n  }\n  @media (min-width: 769px) {\n    .ypp-hero {\n      min-height: 85vh; max-height: 85vh;\n      display: grid; grid-template-columns: 1fr 1fr;\n      align-items: stretch;\n    }\n    .ypp-hero-bg-mobile { display: none; }\n    .ypp-hero-bg-desktop {\n      display: block;\n      position: relative; inset: auto;\n      width: 100%; height: 100%;\n      object-fit: cover; object-position: center center;\n      grid-column: 2; grid-row: 1;\n    }\n    .ypp-hero-left {\n      grid-column: 1; grid-row: 1;\n      display: flex; flex-direction: column; justify-content: flex-start;\n      padding: 3.5rem 3rem 6rem 4rem;\n      max-width: 100%;\n      background: #fdf1f0;\n    }\n    .ypp-trust-bar {\n      grid-column: 1; grid-row: 1;\n      position: absolute;\n      bottom: 2.5rem; left: 4rem;\n    }\n    .ypp-subheading { font-size: 1.3rem !important; }\n    .ypp-h1 { font-size: clamp(3.2rem, 4.6vw, 5rem); margin-bottom: 0.6rem; }\n    .ypp-sub { font-size: 1.45rem !important; line-height: 1.3 !important; margin-bottom: 2.5rem !important; max-width: 100% !important; }\n    .ypp-actions { margin-bottom: 2.5rem !important; gap: 1.25rem !important; }\n    .ypp-btn-primary, .ypp-btn-secondary { font-size: 1.1rem !important; padding: 1.2rem 2.8rem !important; }\n    .ypp-trust { gap: 2.5rem !important; padding: 1.5rem 2.5rem !important; border-radius: 18px !important; }\n    .ypp-trust-num { font-size: 2.2rem !important; }\n    .ypp-trust-label { font-size: 0.8rem !important; }\n  }\n  .ypp-subheading {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.1rem; font-weight: 700; letter-spacing: 0.1em;\n    text-transform: uppercase; color: #ff4545;\n    margin-bottom: 0.1rem;\n  }\n  .ypp-h1 {\n    font-family: 'Wild Mango', cursive;\n    font-size: clamp(3.2rem, 6vw, 5.2rem);\n    line-height: 1.1; color: #2d1f1f;\n    margin-bottom: 0.6rem; font-weight: normal;\n  }\n  .ypp-h1 em { font-style: normal; color: #ff4545; }\n  .ypp-sub {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.15rem; color: #7a5c5c; line-height: 1.3;\n    max-width: 420px; margin-bottom: 2.5rem; font-weight: 300;\n  }\n  .ypp-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem; }\n  .ypp-btn-primary {\n    background: #ff4545; color: white;\n    padding: 0.9rem 2rem; border-radius: 999px;\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase;\n    text-decoration: none; font-weight: 700;\n    transition: background 0.2s; display: inline-block;\n  }\n  .ypp-btn-primary:hover { background: #e03030; }\n  .ypp-btn-secondary {\n    background: transparent; color: #ff4545;\n    padding: 0.9rem 2rem; border-radius: 999px;\n    border: 2px solid #ff4545;\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.9rem; letter-spacing: 0.08em; text-transform: uppercase;\n    text-decoration: none; font-weight: 700;\n    transition: background 0.2s, color 0.2s; display: inline-block;\n  }\n  .ypp-btn-secondary:hover { background: #ff4545; color: white; }\n  .ypp-trust {\n    display: flex; gap: 1.5rem;\n    background: rgba(253,241,240,0.88);\n    backdrop-filter: blur(8px);\n    padding: 1rem 1.5rem; border-radius: 14px;\n    border: 1px solid #f0d4d4; flex-wrap: wrap;\n  }\n  .ypp-trust-item { text-align: center; }\n  .ypp-trust-num {\n    font-family: 'Wild Mango', cursive;\n    font-size: 1.4rem; color: #ff4545; display: block;\n    font-weight: normal; line-height: 1; margin-bottom: 2px;\n  }\n  .ypp-trust-label {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.6rem; color: #7a5c5c;\n    letter-spacing: 0.08em; text-transform: uppercase; font-weight: 600;\n    display: block; line-height: 1;\n  }\n\n  @media (max-width: 768px) {\n    .ypp-hero-left { padding: 2.5rem 1.5rem; }\n    .ypp-trust-bar { left: 1.5rem; bottom: 2rem; }\n    .ypp-trust { gap: 1rem; padding: 0.9rem 1.2rem; }\n  }\n</style>\n\n<section class=\"ypp-hero\">\n  <img \n  class=\"ypp-hero-bg ypp-hero-bg-mobile\" \n  src=\"https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Mobile_hero_banner.png?v=1786691728\" \n  srcset=\"\n    https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Mobile_hero_banner.png?v=1786691728 1x,\n    https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Mobile_hero_banner.png?v=1786691728 2x\n  \"\n  width=\"544\"\n  height=\"815\"\n  alt=\"New planner covers with matching phone, AirPod and AirTag cases\"\n  loading=\"lazy\"\n/>\n\n  <img class=\"ypp-hero-bg ypp-hero-bg-desktop\" src=\"https://cdn.shopify.com/s/files/1/0870/1021/4194/files/Desktop_hero_banner.png?v=1786691754\" alt=\"New planner covers with matching phone, AirPod and AirTag cases\" />\n  <div class=\"ypp-hero-left\">\n    <span class=\"ypp-subheading\">New Covers Just Landed</span>\n    <h1 class=\"ypp-h1\">Custom Planners Built Around <em>Your</em> Life</h1>\n    <p class=\"ypp-sub\">Now with matching phone, AirPod and AirTag cases.</p>\n    <div class=\"ypp-actions\">\n      <a href=\"https://yourperfectplanner.com.au/products/daily-planner\" class=\"ypp-btn-primary\">Build Daily</a>\n      <a href=\"https://yourperfectplanner.com.au/products/weekly-planner\" class=\"ypp-btn-primary\">Build Weekly</a>\n    </div>\n  </div>\n  <div class=\"ypp-trust-bar\">\n    <div class=\"ypp-trust\">\n      <div class=\"ypp-trust-item\">\n        <span class=\"ypp-trust-num\">100+</span>\n        <span class=\"ypp-trust-label\">5-star reviews</span>\n      </div>\n      <div class=\"ypp-trust-item\">\n        <span class=\"ypp-trust-num\">100%</span>\n        <span class=\"ypp-trust-label\">Customisable</span>\n      </div>\n      <div class=\"ypp-trust-item\">\n        <span class=\"ypp-trust-num\">30-day</span>\n        <span class=\"ypp-trust-label\">Money back</span>\n      </div>\n      <div class=\"ypp-trust-item\">\n        <span class=\"ypp-trust-num\">AUS</span>\n        <span class=\"ypp-trust-label\">Made</span>\n      </div>\n    </div>\n  </div>\n</section>",
