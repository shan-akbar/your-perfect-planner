    "custom_liquid_xJG6bx": {
      "type": "custom-liquid",
      "name": "Custom Planners",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-carousel { padding: 4rem 0 4rem 5rem; background: #ffffff; }\n  .ypp-carousel.bg-base { background: #fdf1f0; }\n  .ypp-carousel-header {\n    display: flex; align-items: center; justify-content: space-between;\n    padding-right: 5rem; margin-bottom: 1.5rem;\n  }\n  .ypp-carousel-heading {\n    font-family: 'Poppins', sans-serif; font-size: 1.4rem;\n    font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em; color: #2d1f1f;\n  }\n  .ypp-carousel-view-all {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.8rem; font-weight: 700; text-transform: uppercase;\n    letter-spacing: 0.1em; color: #ff4545; text-decoration: none;\n    border-bottom: 2px solid #ff9cae; padding-bottom: 2px; white-space: nowrap;\n  }\n  .ypp-carousel-track {\n    display: flex; gap: 1.25rem;\n    overflow-x: auto; scroll-snap-type: x mandatory;\n    -webkit-overflow-scrolling: touch;\n    padding-right: 5rem; padding-bottom: 1rem;\n    scrollbar-width: none;\n  }\n  .ypp-carousel-track::-webkit-scrollbar { display: none; }\n  .ypp-product-card {\n    flex: 0 0 240px; scroll-snap-align: start;\n    border-radius: 16px; overflow: hidden;\n    border: 1.5px solid #f0d4d4; background: #ffffff;\n    text-decoration: none; color: #2d1f1f;\n    transition: transform 0.2s, box-shadow 0.2s; display: block;\n  }\n  .ypp-product-card:hover { transform: translateY(-4px); box-shadow: 0 12px 32px rgba(255,156,174,0.2); }\n  .ypp-product-img {\n    width: 100%; height: 220px; background: #fad8da;\n    overflow: hidden; display: flex; align-items: center; justify-content: center;\n  }\n  .ypp-product-img img { width: 100%; height: 100%; object-fit: cover; }\n  .ypp-product-info { padding: 1rem 1.1rem 1.1rem; }\n  .ypp-product-name {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.95rem; font-weight: 700; text-transform: uppercase;\n    letter-spacing: 0.05em; color: #2d1f1f; margin-bottom: 0.4rem; line-height: 1.4;\n  }\n  @media (max-width: 768px) {\n    .ypp-carousel { padding: 3rem 0 3rem 1.5rem; }\n    .ypp-carousel-header { padding-right: 1.5rem; }\n    .ypp-carousel-track { padding-right: 1.5rem; }\n  }\n</style>\n\n<section class=\"ypp-carousel\">\n  <div class=\"ypp-carousel-header\">\n    <h2 class=\"ypp-carousel-heading\">Custom Planners</h2>\n    <a href=\"/collections/planners\" class=\"ypp-carousel-view-all\">View all →</a>\n  </div>\n  <div class=\"ypp-carousel-track\">\n\n    {% assign weekly = all_products['weekly-planner'] %}\n    <a href=\"/products/weekly-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"{{ weekly.featured_image | image_url: width: 480 }}\" alt=\"Custom Weekly Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">Custom Weekly Planner</div>\n      </div>\n    </a>\n\n    {% assign daily = all_products['daily-planner'] %}\n    <a href=\"/products/daily-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"{{ daily.featured_image | image_url: width: 480 }}\" alt=\"Custom Daily Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">Custom Daily Planner</div>\n      </div>\n    </a>\n\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_LJhQNM": {
      "type": "custom-liquid",
      "name": "Steps",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-usp { padding: 6rem 5rem; background: #ffffff; }\n  .ypp-section-label {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase;\n    color: #ff4545; margin-bottom: 1rem; font-weight: 700;\n    display: flex; align-items: center; gap: 0.75rem;\n  }\n  .ypp-section-label::before {\n    content: ''; display: block; width: 2rem; height: 2px;\n    background: #ff9cae; border-radius: 999px;\n  }\n  .ypp-section-heading {\n    font-family: 'Wild Mango', cursive; font-size: clamp(2.6rem, 4vw, 3.4rem);\n    line-height: 1.15; max-width: 600px; margin-bottom: 4rem; font-weight: normal;\n    color: #2d1f1f;\n  }\n  .ypp-section-heading em { font-style: normal; color: #ff4545; }\n  .ypp-usp-grid {\n    display: grid; grid-template-columns: repeat(4, 1fr); gap: 1.5rem;\n  }\n  .ypp-usp-card {\n    background: #fdf1f0; padding: 2.5rem; border-radius: 20px;\n    position: relative; overflow: hidden;\n    transition: background 0.3s, transform 0.2s;\n    border: 1px solid #f0d4d4;\n  }\n  .ypp-usp-card:hover { background: #fad8da; transform: translateY(-4px); }\n  .ypp-usp-num {\n    font-family: 'Wild Mango', cursive; font-size: 4rem; color: #f0d4d4;\n    position: absolute; top: 1rem; right: 1.5rem; line-height: 1; font-weight: normal;\n  }\n  .ypp-usp-card-title {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.3rem; color: #2d1f1f; margin-bottom: 0.75rem; margin-top: 1rem;\n    font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em;\n  }\n  .ypp-usp-card-body {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.1rem; color: #7a5c5c; line-height: 1.75; font-weight: 300;\n  }\n  @media (max-width: 768px) {\n    .ypp-usp { padding: 4rem 1.5rem; }\n    .ypp-usp-grid { grid-template-columns: 1fr; }\n  }\n</style>\n\n<section class=\"ypp-usp\">\n  <div class=\"ypp-section-label\">Why Your Perfect Planner</div>\n  <h2 class=\"ypp-section-heading\">Not a generic planner. <em>Yours.</em></h2>\n  <div class=\"ypp-usp-grid\">\n    <div class=\"ypp-usp-card\">\n      <div class=\"ypp-usp-num\">01</div>\n      <div class=\"ypp-usp-card-title\">Choose your date range</div>\n      <div class=\"ypp-usp-card-body\">Start any month you like. Calendar year, financial year, school year — you decide.</div>\n    </div>\n    <div class=\"ypp-usp-card\">\n      <div class=\"ypp-usp-num\">02</div>\n      <div class=\"ypp-usp-card-title\">Pick your layout</div>\n      <div class=\"ypp-usp-card-body\">Daily pages for busy, detailed planners. Weekly spreads for those who like to see the big picture. Choose what suits how your mind works.</div>\n    </div>\n    <div class=\"ypp-usp-card\">\n      <div class=\"ypp-usp-num\">03</div>\n      <div class=\"ypp-usp-card-title\">Add only what you need</div>\n      <div class=\"ypp-usp-card-body\">Habit trackers. Meal planners. Goal pages. Budget spreads. Add the pages that serve your life, skip the ones that don't.</div>\n    </div>\n    <div class=\"ypp-usp-card\">\n      <div class=\"ypp-usp-num\">04</div>\n      <div class=\"ypp-usp-card-title\">Choose your cover</div>\n      <div class=\"ypp-usp-card-body\">Pick a cover you'll love pulling out every single day. Because a planner you're excited about is a planner you'll actually use.</div>\n    </div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_Vcj8zt": {
      "type": "custom-liquid",
      "name": "Ready-Made Planners",
      "settings": {
        "custom_liquid": "<section class=\"ypp-carousel bg-base\">\n  <div class=\"ypp-carousel-header\">\n    <h2 class=\"ypp-carousel-heading\">Ready-Made Planners</h2>\n    <a href=\"/collections/built-by-us\" class=\"ypp-carousel-view-all\">View all →</a>\n  </div>\n  <div class=\"ypp-carousel-track\">\n    <a href=\"/products/2026-business-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://yourperfectplanner.com.au/cdn/shop/files/Business_blank.png?v=1762466055\" alt=\"2026 Business Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">2026 Business Planner</div>\n        <div class=\"ypp-product-price\">$87.95</div>\n      </div>\n    </a>\n    <a href=\"/products/2026-everyday-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://yourperfectplanner.com.au/cdn/shop/files/Everyday_blank.png?v=1762465720\" alt=\"2026 Everyday Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">2026 Everyday Planner</div>\n        <div class=\"ypp-product-price\">$60.50</div>\n      </div>\n    </a>\n    <a href=\"/products/2026-health-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://yourperfectplanner.com.au/cdn/shop/files/Health_blank.png?v=1762465646\" alt=\"2026 Health Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">2026 Health Planner</div>\n        <div class=\"ypp-product-price\">$87.95</div>\n      </div>\n    </a>\n    <a href=\"/products/2026-minimalist-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://yourperfectplanner.com.au/cdn/shop/files/Minimalist_blank.png?v=1762465800\" alt=\"2026 Minimalist Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">2026 Minimalist Planner</div>\n        <div class=\"ypp-product-price\">$60.50</div>\n      </div>\n    </a>\n    <a href=\"/products/2026-student-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://yourperfectplanner.com.au/cdn/shop/files/Student_blank.png?v=1762465991\" alt=\"2026 Student Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">2026 Student Planner</div>\n        <div class=\"ypp-product-price\">$60.50</div>\n      </div>\n    </a>\n    <a href=\"/products/2026-teacher-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://yourperfectplanner.com.au/cdn/shop/files/Teacher_blank.png?v=1762465573\" alt=\"2026 Teacher Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">2026 Teacher Planner</div>\n        <div class=\"ypp-product-price\">$60.50</div>\n      </div>\n    </a>\n    <a href=\"/products/2026-ultimate-planner\" class=\"ypp-product-card\">\n      <div class=\"ypp-product-img\">\n        <img src=\"https://yourperfectplanner.com.au/cdn/shop/files/Ultimate_blank.png?v=1762465947\" alt=\"2026 Ultimate Planner\" />\n      </div>\n      <div class=\"ypp-product-info\">\n        <div class=\"ypp-product-name\">2026 Ultimate Planner</div>\n        <div class=\"ypp-product-price\">$71.50</div>\n      </div>\n    </a>\n  </div>\n</section>",
