    "custom_liquid_nD3xFF": {
      "type": "custom-liquid",
      "name": "About Us",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-founder {\n    padding: 6rem 5rem; background: #ffffff;\n    display: grid; grid-template-columns: 1fr 2fr;\n    gap: 5rem; align-items: center;\n    box-sizing: border-box; width: 100%;\n  }\n  .ypp-founder-img {\n    aspect-ratio: 3/4; background: #fad8da; border-radius: 24px;\n    display: flex; align-items: center; justify-content: center;\n    border: 2px solid #f0d4d4; overflow: hidden;\n  }\n  .ypp-founder-img img { width: 100%; height: 100%; object-fit: cover; }\n  .ypp-founder-quote {\n    font-family: 'Wild Mango', cursive; font-size: clamp(1.7rem, 2.5vw, 1.9rem);\n    line-height: 1.4; color: #2d1f1f; margin-bottom: 1.5rem;\n  }\n  .ypp-founder-quote::before { content: '\\201C'; color: #ff9cae; }\n  .ypp-founder-quote::after { content: '\\201D'; color: #ff9cae; }\n  .ypp-founder-body {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.2rem; color: #7a5c5c; line-height: 1.85; font-weight: 300; margin-bottom: 1.5rem;\n  }\n  .ypp-founder-name {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.1rem; letter-spacing: 0.15em; text-transform: uppercase;\n    color: #ff4545; font-weight: 700;\n  }\n  @media (max-width: 768px) {\n    .ypp-founder { grid-template-columns: 1fr; padding: 4rem 1.5rem; gap: 2rem; }\n  }\n</style>\n\n<section class=\"ypp-founder\">\n  <div class=\"ypp-founder-img\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0870/1021/4194/files/DSCF4132_1.webp?v=1784201687\" alt=\"Jess, founder of Your Perfect Planner\" />\n  </div>\n  <div>\n    <div class=\"ypp-section-label\">Meet Jess</div>\n    <div class=\"ypp-founder-quote\">I started this business because I couldn't find a planner that perfectly suited my life.</div>\n    <p class=\"ypp-founder-body\">Every planner I tried had pages I didn't use and was missing pages I actually wanted. So I built one myself and then realised I probably wasn't the only one who felt this way.</p>\n    <p class=\"ypp-founder-body\">Your Perfect Planner exists so that nobody has to settle for a planner that's almost right. Because the right planner changes things. It quiets the mental noise, creates calm, and helps you show up as the best version of yourself.</p>\n    <div class=\"ypp-founder-name\">— Jess, Founder</div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_CdUiri": {
      "type": "custom-liquid",
      "name": "CTA",
      "settings": {
