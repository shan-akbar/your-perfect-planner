    "custom_liquid_Vmt8kK": {
      "type": "custom-liquid",
      "name": "Quiz",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-quiz {\n    background: #fdf1f0;\n    padding: 5rem;\n    text-align: center;\n    border-top: 2px solid #f0d4d4;\n    box-sizing: border-box;\n  }\n  .ypp-quiz-eyebrow {\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.75rem; letter-spacing: 0.2em; text-transform: uppercase;\n    color: #ff4545; font-weight: 700;\n    display: flex; align-items: center; justify-content: center; gap: 0.75rem;\n    margin-bottom: 1.25rem;\n  }\n  .ypp-quiz-eyebrow::before, .ypp-quiz-eyebrow::after {\n    content: ''; display: block; width: 2rem; height: 2px;\n    background: #ff9cae; border-radius: 999px;\n  }\n  .ypp-quiz-heading {\n    font-family: 'Wild Mango', cursive;\n    font-size: clamp(2rem, 3.5vw, 3rem);\n    color: #2d1f1f; line-height: 1.2;\n    font-weight: normal; margin-bottom: 1rem;\n    max-width: 640px; margin-left: auto; margin-right: auto;\n  }\n  .ypp-quiz-heading em { font-style: normal; color: #ff4545; }\n  .ypp-quiz-sub {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1rem; color: #7a5c5c; line-height: 1.7;\n    font-weight: 300; margin-bottom: 2.5rem;\n    max-width: 480px; margin-left: auto; margin-right: auto;\n  }\n  .ypp-quiz-btn {\n    background: #ff4545; color: white;\n    padding: 1rem 2.5rem; border-radius: 999px;\n    font-family: 'Poppins', sans-serif;\n    font-size: 0.95rem; letter-spacing: 0.08em; text-transform: uppercase;\n    text-decoration: none; font-weight: 700;\n    display: inline-block; transition: background 0.2s;\n  }\n  .ypp-quiz-btn:hover { background: #e03030; }\n  @media (max-width: 768px) {\n    .ypp-quiz { padding: 4rem 1.5rem; }\n  }\n</style>\n\n<section class=\"ypp-quiz\">\n  <div class=\"ypp-quiz-eyebrow\">Find your perfect match</div>\n  <h2 class=\"ypp-quiz-heading\">Not sure which planner is <em>right for you?</em></h2>\n  <p class=\"ypp-quiz-sub\">Answer a few quick questions and we'll match you with the perfect planner for your life.</p>\n  <a href=\"/pages/which-planner-is-best-for-you\" class=\"ypp-quiz-btn\">Take the quiz</a>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_nD3xFF": {
      "type": "custom-liquid",
      "name": "About Us",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-founder {\n    padding: 6rem 5rem; background: #ffffff;\n    display: grid; grid-template-columns: 1fr 2fr;\n    gap: 5rem; align-items: center;\n    box-sizing: border-box; width: 100%;\n  }\n  .ypp-founder-img {\n    aspect-ratio: 3/4; background: #fad8da; border-radius: 24px;\n    display: flex; align-items: center; justify-content: center;\n    border: 2px solid #f0d4d4; overflow: hidden;\n  }\n  .ypp-founder-img img { width: 100%; height: 100%; object-fit: cover; }\n  .ypp-founder-quote {\n    font-family: 'Wild Mango', cursive; font-size: clamp(1.7rem, 2.5vw, 1.9rem);\n    line-height: 1.4; color: #2d1f1f; margin-bottom: 1.5rem;\n  }\n  .ypp-founder-quote::before { content: '\\201C'; color: #ff9cae; }\n  .ypp-founder-quote::after { content: '\\201D'; color: #ff9cae; }\n  .ypp-founder-body {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.2rem; color: #7a5c5c; line-height: 1.85; font-weight: 300; margin-bottom: 1.5rem;\n  }\n  .ypp-founder-name {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.1rem; letter-spacing: 0.15em; text-transform: uppercase;\n    color: #ff4545; font-weight: 700;\n  }\n  @media (max-width: 768px) {\n    .ypp-founder { grid-template-columns: 1fr; padding: 4rem 1.5rem; gap: 2rem; }\n  }\n</style>\n\n<section class=\"ypp-founder\">\n  <div class=\"ypp-founder-img\">\n    <img src=\"https://cdn.shopify.com/s/files/1/0870/1021/4194/files/DSCF4132.jpg?v=1775898234\" alt=\"Jess, founder of Your Perfect Planner\" />\n  </div>\n  <div>\n    <div class=\"ypp-section-label\">Meet Jess</div>\n    <div class=\"ypp-founder-quote\">I started this business because I couldn't find a planner that perfectly suited my life.</div>\n    <p class=\"ypp-founder-body\">Every planner I tried had pages I didn't use and was missing pages I actually wanted. So I built one myself and then realised I probably wasn't the only one who felt this way.</p>\n    <p class=\"ypp-founder-body\">Your Perfect Planner exists so that nobody has to settle for a planner that's almost right. Because the right planner changes things. It quiets the mental noise, creates calm, and helps you show up as the best version of yourself.</p>\n    <div class=\"ypp-founder-name\">— Jess, Founder</div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
    "custom_liquid_CdUiri": {
      "type": "custom-liquid",
      "name": "CTA",
      "settings": {
        "custom_liquid": "<style>\n  .ypp-cta {\n    background: #fad8da; padding: 5rem;\n    display: grid; grid-template-columns: 1fr 1fr;\n    gap: 4rem; align-items: center;\n    border-top: 2px solid #f0d4d4; border-bottom: 2px solid #f0d4d4;\n    box-sizing: border-box; width: 100%;\n  }\n  .ypp-cta-heading {\n    font-family: 'Wild Mango', cursive; font-size: clamp(2.5rem, 3.5vw, 2.9rem);\n    color: #2d1f1f; line-height: 1.15; font-weight: normal;\n  }\n  .ypp-cta-heading em { font-style: normal; color: #ff4545; }\n  .ypp-cta-right { display: flex; flex-direction: column; gap: 1.25rem; }\n  .ypp-cta-body {\n    font-family: 'Poppins', sans-serif;\n    color: #7a5c5c; font-size: 1.3rem; line-height: 1.8; font-weight: 300;\n  }\n  .ypp-btn-red {\n    background: #ff4545; color: white; padding: 1rem 2.2rem; border-radius: 999px;\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.3rem; letter-spacing: 0.08em; text-transform: uppercase;\n    text-decoration: none; font-weight: 700;\n    display: inline-block; align-self: flex-start;\n    transition: background 0.2s;\n  }\n  .ypp-btn-red:hover { background: #e03030; }\n  .ypp-cta-guarantee {\n    font-family: 'Poppins', sans-serif;\n    font-size: 1.1rem; color: #7a5c5c; font-weight: 600;\n    display: flex; align-items: center; gap: 0.5rem;\n    text-transform: uppercase; letter-spacing: 0.08em;\n  }\n  .ypp-cta-guarantee::before { content: '✓'; color: #ff4545; }\n  @media (max-width: 768px) {\n    .ypp-cta { grid-template-columns: 1fr; padding: 4rem 1.5rem; gap: 2rem; }\n  }\n</style>\n\n<section class=\"ypp-cta\">\n  <div>\n    <h2 class=\"ypp-cta-heading\">Ready to stop settling for <em>almost right?</em></h2>\n  </div>\n  <div class=\"ypp-cta-right\">\n    <p class=\"ypp-cta-body\">Every single page in your planner should earn its place. Build one that fits your life perfectly in under 5 minutes.</p>\n    <a href=\"/collections/planners\" class=\"ypp-btn-red\">Build My Perfect Planner</a>\n    <div class=\"ypp-cta-guarantee\">30-day money back guarantee.</div>\n  </div>\n</section>",
        "color_scheme": "",
        "padding_top": 0,
        "padding_bottom": 0
      }
    },
