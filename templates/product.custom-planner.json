    "custom_liquid_WUCnkQ": {
      "type": "custom-liquid",
      "name": "How it works",
      "settings": {
        "custom_liquid": "<section class=\"ypp-how-it-works\">\n  <p class=\"ypp-section-label\">How It Works</p>\n  <h2 class=\"ypp-section-title\">Build It in 4 Simple Steps</h2>\n  <p class=\"ypp-section-sub\">Your planner, your rules. Completely customised to how your brain works.</p>\n\n  <div class=\"ypp-steps-grid\">\n\n    <div class=\"ypp-step\">\n      <div class=\"ypp-step-num\">1</div>\n      <h3 class=\"ypp-step-heading\">Choose Your Layout</h3>\n      <p class=\"ypp-step-text\">Select a layout that matches how you think and plan</p>\n      <span class=\"ypp-step-arrow\">→</span>\n    </div>\n\n    <div class=\"ypp-step\">\n      <div class=\"ypp-step-num\">2</div>\n      <h3 class=\"ypp-step-heading\">Set Your Date Range</h3>\n      <p class=\"ypp-step-text\">January – December, July – June, however you like to plan</p>\n      <span class=\"ypp-step-arrow\">→</span>\n    </div>\n\n    <div class=\"ypp-step\">\n      <div class=\"ypp-step-num\">3</div>\n      <h3 class=\"ypp-step-heading\">Add Extra Pages</h3>\n      <p class=\"ypp-step-text\">Habit trackers, meal planning, notes, finance pages &amp; more</p>\n      <span class=\"ypp-step-arrow\">→</span>\n    </div>\n\n    <div class=\"ypp-step\">\n      <div class=\"ypp-step-num\">4</div>\n      <h3 class=\"ypp-step-heading\">Pick Your Cover</h3>\n      <p class=\"ypp-step-text\">Choose a cover design that speaks to your style</p>\n    </div>\n\n  </div>\n</section>\n\n<style>\n.ypp-how-it-works {\n  background-color: #fdf1f0;\n  padding: 64px 40px;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-section-label {\n  font-size: 12px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n  color: #ff9cae;\n  text-align: center;\n  margin: 0 0 8px 0;\n}\n\n.ypp-section-title {\n  font-size: 30px;\n  font-weight: 700;\n  text-align: center;\n  color: #2d1a1a;\n  margin: 0 0 8px 0;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-section-sub {\n  font-size: 15px;\n  color: #7a5a5a;\n  text-align: center;\n  margin: 0 0 40px 0;\n}\n\n.ypp-steps-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 20px;\n}\n\n.ypp-step {\n  text-align: center;\n  position: relative;\n}\n\n.ypp-step-num {\n  width: 52px;\n  height: 52px;\n  border-radius: 999px;\n  background-color: #ff4545;\n  color: #ffffff;\n  font-size: 20px;\n  font-weight: 700;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 0 auto 16px auto;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-step-heading {\n  font-size: 13px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n  margin: 0 0 8px 0;\n  color: #2d1a1a;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-step-text {\n  font-size: 13px;\n  color: #7a5a5a;\n  line-height: 1.6;\n  margin: 0;\n}\n\n.ypp-step-arrow {\n  position: absolute;\n  right: -10px;\n  top: 14px;\n  color: #ff9cae;\n  font-size: 20px;\n  font-weight: 700;\n}\n\n/* Tablet — 2 columns, hide arrows */\n@media (max-width: 900px) {\n  .ypp-steps-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n  .ypp-step-arrow {\n    display: none;\n  }\n}\n\n/* Mobile — keep 2 columns, tighten padding */\n@media (max-width: 540px) {\n  .ypp-how-it-works {\n    padding: 48px 24px;\n  }\n  .ypp-steps-grid {\n    grid-template-columns: repeat(2, 1fr);\n    gap: 16px;\n  }\n  .ypp-section-title {\n    font-size: 24px;\n  }\n  .ypp-step-arrow {\n    display: none;\n  }\n}\n</style>",
        "color_scheme": "",
        "padding_top": 40,
        "padding_bottom": 52
      }
    },
    "custom_liquid_KQ36c6": {
      "type": "custom-liquid",
      "name": "Product quality",
      "settings": {
        "custom_liquid": "<section class=\"ypp-features\">\n  <p class=\"ypp-feat-label\">Product Quality</p>\n  <h2 class=\"ypp-feat-title\">Built to Last. Designed to Use.</h2>\n  <p class=\"ypp-feat-sub\">Every detail has been considered so your planner feels as good as it works.</p>\n\n  <div class=\"ypp-feat-grid\">\n\n    <div class=\"ypp-feat-card\">\n      <div class=\"ypp-feat-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ff4545\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\"></path>\n          <polyline points=\"14 2 14 8 20 8\"></polyline>\n          <line x1=\"16\" y1=\"13\" x2=\"8\" y2=\"13\"></line>\n          <line x1=\"16\" y1=\"17\" x2=\"8\" y2=\"17\"></line>\n          <polyline points=\"10 9 9 9 8 9\"></polyline>\n        </svg>\n      </div>\n      <h3 class=\"ypp-feat-heading\">Premium Paper</h3>\n      <p class=\"ypp-feat-text\">120gsm FSC-certified paper that's thick, smooth, and genuinely pen-friendly, no bleeding through </p>\n    </div>\n\n    <div class=\"ypp-feat-card\">\n      <div class=\"ypp-feat-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ff4545\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <path d=\"M21 6H3a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h18a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2z\"></path>\n          <line x1=\"7\" y1=\"10\" x2=\"7\" y2=\"14\"></line>\n          <line x1=\"11\" y1=\"11\" x2=\"11\" y2=\"13\"></line>\n          <line x1=\"15\" y1=\"10\" x2=\"15\" y2=\"14\"></line>\n        </svg>\n      </div>\n      <h3 class=\"ypp-feat-heading\">The Perfect Size</h3>\n      <p class=\"ypp-feat-text\">195 × 235mm - enough room to write freely, compact enough to take anywhere without a second thought</p>\n    </div>\n\n    <div class=\"ypp-feat-card\">\n      <div class=\"ypp-feat-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ff4545\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <polygon points=\"12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2\"></polygon>\n        </svg>\n      </div>\n      <h3 class=\"ypp-feat-heading\">Handmade in Australia</h3>\n      <p class=\"ypp-feat-text\">Every planner is handmade locally, supporting Australian makers and arriving at your door faster</p>\n    </div>\n\n    <div class=\"ypp-feat-card\">\n      <div class=\"ypp-feat-icon\">\n        <svg xmlns=\"http://www.w3.org/2000/svg\" width=\"28\" height=\"28\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"#ff4545\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\">\n          <line x1=\"4\" y1=\"21\" x2=\"4\" y2=\"14\"></line>\n          <line x1=\"4\" y1=\"10\" x2=\"4\" y2=\"3\"></line>\n          <line x1=\"12\" y1=\"21\" x2=\"12\" y2=\"12\"></line>\n          <line x1=\"12\" y1=\"8\" x2=\"12\" y2=\"3\"></line>\n          <line x1=\"20\" y1=\"21\" x2=\"20\" y2=\"16\"></line>\n          <line x1=\"20\" y1=\"12\" x2=\"20\" y2=\"3\"></line>\n          <line x1=\"1\" y1=\"14\" x2=\"7\" y2=\"14\"></line>\n          <line x1=\"9\" y1=\"8\" x2=\"15\" y2=\"8\"></line>\n          <line x1=\"17\" y1=\"16\" x2=\"23\" y2=\"16\"></line>\n        </svg>\n      </div>\n      <h3 class=\"ypp-feat-heading\">Only What You Need</h3>\n      <p class=\"ypp-feat-text\">Fully customisable so you only carry the pages you'll actually use and leave out everything you won't</p>\n    </div>\n\n  </div>\n</section>\n\n<style>\n.ypp-features {\n  background-color: #ffffff;\n  padding: 64px 40px;\n  font-family: 'Poppins', sans-serif;\n}\n\n.ypp-feat-label {\n  font-size: 12px;\n  font-weight: 700;\n  text-transform: uppercase;\n  letter-spacing: 2px;\n 