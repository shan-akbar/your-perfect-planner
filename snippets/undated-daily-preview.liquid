<script>

    function updateDiaryPages(){
        let start_date_element = document.getElementById("start_date");
        let end_date_element = document.getElementById("end_date");
        let start_date = start_date_element.value;
        let end_date = end_date_element.value;
     
        if(!start_date){
            start_date = document.querySelector('.planner-date__range').getAttribute('data-startdate');
        }

        if(!end_date){
            end_date = document.querySelector('.planner-date__range').getAttribute('data-enddate');
        }
        
        start_date = new Date(start_date);
        end_date = new Date(end_date);

        let updated_pages = [];
        let pages_length = diary_pages_backup.length;
        for(var i=0; i<pages_length; ++i){ 
            
            if(diary_pages_backup[i].page_type == 'day'){
                let current_page_date = new Date(diary_pages_backup[i].date);
                if(current_page_date >= start_date && current_page_date <= end_date){
                    updated_pages.push(diary_pages_backup[i]);
                }
            }else{
                updated_pages.push(diary_pages_backup[i]);
            }
        }

        diary_pages = updated_pages;

            let inputs = document.querySelectorAll('input[type=number].page-qty__input ');
 
            for (let i = 0; i < inputs.length; i++) {
                inputs[i].value = 0;
            }

        renderPages();

    }

    function handleDateRangeChange(){

        let target = this.event.target;
        let start_date_element = document.getElementById("start_date");
        let end_date_element = document.getElementById("end_date");
        let start_date = start_date_element.value;
        let end_date = end_date_element.value;

        let start_date_fixed = document.querySelector('.planner-date__range').getAttribute('data-startdate');
        let end_date_fixed = document.querySelector('.planner-date__range').getAttribute('data-enddate');

        let start_date_obj = new Date(start_date);
        let end_date_obj = new Date(end_date);
        let start_date_fixed_obj = new Date(start_date_fixed);
        let end_date_fixed_obj = new Date(end_date_fixed);
        
        let error__message = document.querySelector(".date-range-error__message");
        if(start_date_obj > end_date_obj || start_date_obj < start_date_fixed_obj || end_date_obj > end_date_fixed_obj || (!start_date || !end_date)){
            
            error__message.style.display = "block";
            if(target.isSameNode(start_date_element)){
                start_date_element.value = end_date_element.value;
                error__message.innerHTML = "Start Date canot be after the end date!"
            }else{
                end_date_element.value = start_date_element.value;
                error__message.innerHTML = "End Date canot be before the start date!"
            }

            if(start_date_obj < start_date_fixed_obj){
                start_date_element.value = start_date_fixed;
                error__message.innerHTML = "Start Date cannot be older then " + start_date_fixed;
            }

            if(end_date_obj > end_date_fixed_obj){
                end_date_element.value = end_date_fixed;
                error__message.innerHTML = "End Date cannot be larger then " + end_date_fixed;
            }

            if(!start_date || !end_date){
               error__message.innerHTML = "Invalid date selected.";
            }

            

            setTimeout(
                function(error__message) {
                    document.querySelector(".date-range-error__message").style.display = "none";
                }, 5000
            );

        }else{
            error__message.style.display = "none";
            updateDiaryPages();
        }

    }

    function isEvenNumber(number){
        if(number % 2 == 0) {
            return true;
        }else{
            return false;
        }
    }

    function remove_neutral_pages(){
        let pages_length = diary_pages.length;
        let updated_pages = [];
        for(var i=0;i<pages_length;++i){
            if(diary_pages[i].page_type != 'neutral_page' && diary_pages[i].page_type != 'copyright'){
                updated_pages.push(diary_pages[i]);
            }
        }

        diary_pages = updated_pages;
    }
    
    function neutralize_pages(){
       
        let new_updated_pages = [];
        let new_index = 0;
        let pages_length = diary_pages.length;
        
        for(var i=0; i<pages_length; ++i){
            
            if(isEvenNumber(new_index) && diary_pages[i].page_side == 1){
                new_updated_pages.push({
                    page_type: 'neutral_page', 
                    date: '' ,
                    year: diary_pages[i].year,
                    page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668"
                });

                ++new_index;
            }

            new_updated_pages.push(diary_pages[i]);
            ++new_index;
        }
        diary_pages = new_updated_pages;
    }

    // --- GLOBAL VIRTUAL ENGINE STATE ---
    let current_physical_page = 0; // Tracks active index (0 to diary_pages.length / 2)
    let is_animating = false;      // Animation block lock
    const FLIP_ANIMATION_SPEED = 600; // MUST match your CSS 3D flip duration in milliseconds!

    /**
 * Synchronizes the 5-page DOM window container with the main global diary_pages array
 */
function updateDOMWindow() {
    const domPages = document.querySelectorAll('.diary-flip_page');
    
    domPages.forEach((domPage, domSlotIndex) => {
        let targetPhysicalPageIndex = current_physical_page + (domSlotIndex - 2);
        let dataIndexFront = targetPhysicalPageIndex * 2;
        let dataIndexBack = dataIndexFront + 1;

        // Boundary Protection: Hide buffer boxes if out of data limits
        if (dataIndexFront < 0 || dataIndexFront >= diary_pages.length) {
            domPage.classList.add('display__none');
            domPage.style.zIndex = 0; // Drop stacking weight completely
            return;
        }

        const frontImg = domPage.querySelector('.front-page');
        const backImg = domPage.querySelector('.back-page');
        
        // Front Page Asset Sync
        if (diary_pages[dataIndexFront]) {
            frontImg.setAttribute('src', diary_pages[dataIndexFront].page_url);
            
            if (diary_pages[dataIndexFront].date) {
                frontImg.setAttribute('data-date', diary_pages[dataIndexFront].date);
            } else {
                frontImg.removeAttribute('data-date');
            }
            
            if (diary_pages[dataIndexFront].day_name) {
                frontImg.setAttribute('data-dayname', diary_pages[dataIndexFront].day_name);
            } else {
                frontImg.removeAttribute('data-dayname');
            }
        }
        
        // Back Page Asset Sync
        if (diary_pages[dataIndexBack]) {
            backImg.setAttribute('src', diary_pages[dataIndexBack].page_url);
            
            if (diary_pages[dataIndexBack].date) {
                backImg.setAttribute('data-date', diary_pages[dataIndexBack].date);
            } else {
                backImg.removeAttribute('data-date');
            }
            
            if (diary_pages[dataIndexBack].day_name) {
                backImg.setAttribute('data-dayname', diary_pages[dataIndexBack].day_name);
            } else {
                backImg.removeAttribute('data-dayname');
            }
        }

        // ========================================================
        // FIX: EXPLICIT 3D LAYER STACKING ENGINE (Z-INDEX)
        // ========================================================
        if (domSlotIndex < 2) {
            // Left Stack (Flipped): Higher slot numbers are closer to the center focus line
            domPage.classList.add('flipped');
            domPage.style.zIndex = 100 + domSlotIndex; // Slot 1 sits cleanly on top of Slot 0
            domPage.classList.remove('display__none');
        } else if (domSlotIndex === 2) {
            // Center Focus Layer: The active page being read or actively flipped mid-air
            domPage.style.zIndex = 200; // Always stays on top of both stacks
            domPage.classList.remove('display__none');
        } else {
            // Right Stack (Unflipped): Lower slot numbers are closer to the center focus line
            domPage.classList.remove('flipped');
            domPage.style.zIndex = 100 - domSlotIndex; // Slot 3 sits cleanly on top of Slot 4
            domPage.classList.remove('display__none');
        }
    });
}   

    function renderPages(){
    // 1. Data cleanup routines
    remove_neutral_pages();
    neutralize_pages();
    
    let current_year = 2026;

    // 2. Inject structural pages into the array safely
    diary_pages.splice(diary_pages.length-1, 0, {
        page_type: "copyright", 
        page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/COPYRIGHT_PAGE_2024.png?v=1732746669", 
        year: current_year
    });
    
    if(diary_pages.length % 2 != 0){
        diary_pages.splice(diary_pages.length-2, 0, {
            page_type: "blank", 
            page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668", 
            year: current_year 
        });
    }

    // --- VIRTUAL SLIDING WINDOW ENGINE HOOK ---
    // Resets the focus window pointer back to page 0 and updates the 5 layout elements
    current_physical_page = 0; 
    updateDOMWindow();
    // ------------------------------------------

    // 3. Page count limit check
    let pages_limit_div = document.querySelector('.pages-limit__description');
    let pages_limit = Number(pages_limit_div.getAttribute("data-pageslimit"));
    
    if(diary_pages.length > pages_limit){
        pages_limit_div.style.display = 'block';
        let pages_number_message = document.querySelector("#no_of_pages");
        pages_number_message.innerHTML = diary_pages.length;
    } else {
        pages_limit_div.style.display = 'none';
    }
    
    // 4. Update pricing calculation
    updatePrice(diary_pages.length);
}


  function splitDiary(){
        let checked = this.event.target.checked;
        let fixedprice = Number(document.querySelector(".custom-planner__price").getAttribute("data-fixedprice"));
        let pageLimitProperty = document.getElementById("pages_limit_property");
        pageLimitProperty.value = checked;
        let pages_limit_div = document.querySelector('.pages-limit__description');
        let split_price = Number(pages_limit_div.getAttribute("data-splitprice"));
        
        if(split_price > 0){
            if(checked){
                fixedprice = fixedprice + split_price;
            }else{
                fixedprice = fixedprice - split_price;
            }
        }
        
        document.querySelector(".custom-planner__price").setAttribute("data-fixedprice", fixedprice);
        updatePrice(diary_pages.length);
      

    }

    function updatePrice(noOfPages){
        
        const myInterval = setInterval(function (){
            let priceTarget = document.querySelector(".price__container .price-item.price-item--regular");
            if(priceTarget){
                let unitPrice = Number(document.querySelector(".custom-planner__price").getAttribute("data-unitprice"));
                let fixedAddedPrice = Number(document.querySelector(".custom-planner__price").getAttribute("data-fixedprice"));
                

                let diary_pages_final2 = [];
                diary_pages_final2 = structuredClone(diary_pages);
                    
               if(diary_pages_final2.length > 0){
                   noOfPages = diary_pages_final2.length;
                }
                let totalPrice = ((noOfPages * unitPrice) + fixedAddedPrice).toFixed(2);
                let globalPriceTarget = document.querySelector('.gp-price');
                priceTarget.innerHTML = "$" + totalPrice + " AUD";
                globalPriceTarget.innerHTML = "$" + totalPrice + " AUD";
                let customPriceProperty = document.getElementById("custom_price");
                customPriceProperty.value = totalPrice;
                let final_unit_price = totalPrice/noOfPages;
                let text_below_price =  document.querySelector(".text-below__price");
                text_below_price.innerHTML = "$" + final_unit_price.toFixed(2) + " per day";
                clearInterval(myInterval);
            }
        }, 100);

    }

    document.addEventListener("DOMContentLoaded", () => {
        renderPages();
        
    });

    function extraPages(){
        let page_type = this.event.target.closest(".planner-custom-pages_wrapper").getAttribute("data-pagetype");
        
        if(page_type == "front_cover"){
            frontCoverPages(this.event.target);
        }
        
        if(page_type == "between_week"){
            inBetweenWeekPages(this.event.target);
        }

        if(page_type == "between_month"){
            let element = this.event.target;
            let double_pages_index = Number(element.closest('.page_item').getAttribute('data-index'));
            let double_monthly_pages = all_monthly_double_pages[double_pages_index];
            
            if(double_monthly_pages){
                inBetweenMonthPagesDouble(this.event.target);
            }else{
                inBetweenMonthPages(this.event.target);
            }
            
        }

        if(page_type == "back_cover"){
            backCoverPages(this.event.target);
        }
    }


    function changePageLayout(){
        
        let target = this.event.target;
        let layout_position = Number(target.getAttribute("data-layoutposition"));
        if(layout_position != currently_selected_layout){
            const pageItem = target.closest('.page_item');
            const layoutImg = pageItem.querySelector('.extra-image');
            const layoutUrl = layoutImg.src;
            
            let diary_loading_spinner = document.querySelector('.diary-loading_spinner');
            diary_loading_spinner.classList.remove('diary-loading-spinner_hidden');
            
             // update all inner diary pages (skip first and last)
            for (let i = 1; i < diary_pages.length - 1; i++) {
              if(diary_pages[i].page_type == "day"){
                diary_pages[i].page_url = layoutUrl;
              }
            }

            renderPages();
          
            setTimeout(function(){
                let diary_loading_spinner = document.querySelector('.diary-loading_spinner');
                diary_loading_spinner.classList.add('diary-loading-spinner_hidden');
            }, 14000);
            
            currently_selected_layout = layout_position;
            
        }

    }

    function frontCoverPages(element){
        let page_wrapper = element.closest(".page_item");
        let main_page_wrapper = element.closest(".planner-custom-pages_wrapper");
        let current_year = Number(main_page_wrapper.getAttribute('data-defaultyear'));
        let image_front = element.closest(".page_item").querySelector(".extra-image").getAttribute("src");
        let image_back = element.closest(".page_item").querySelector(".preview-icon").getAttribute("data-backimage");
        let preview_icon = page_wrapper.querySelector(".preview-icon");
        let multiyear = preview_icon.getAttribute('data-multiyear');
        let pages_length = diary_pages.length;
        let updated_pages = [];
        let cover_added = false;
        let updateType = element.getAttribute('data-updatetype');
        if(updateType == 'plus'){
            for(var i=0; i<pages_length; ++i){
                
                if(diary_pages[i].page_type != "outer_cover" && diary_pages[i].page_type != "inner_cover_front" && !cover_added){
                      
            
                    cover_added = true;
                    updated_pages.push({page_type: "inner_cover_front", page_url: image_front, date: '' });
                    if(image_back){
                        updated_pages.push({page_type: "inner_cover_front", page_url: image_back, date: '' });
                    }
                }

                if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                    updated_pages.push(diary_pages[i]);
                }

            }
        }else{
            let noOfRemoved = 0;
            let needToRemove = 1;
            if(image_back){
                needToRemove = 2;
            }

            for(var i=0; i<pages_length; ++i){

               
                if((diary_pages[i].page_url == image_front || diary_pages[i].page_url == image_back)&& diary_pages[i].page_type == 'inner_cover_front' && noOfRemoved < needToRemove){
                     ++noOfRemoved;
                }else{
                    
                    if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                        updated_pages.push(diary_pages[i]);
                    }
                }
                
                
            }
        }

        diary_pages = updated_pages;
        renderPages();
    }

    function inBetweenWeekPages(element){
        let image_front = element.closest(".page_item").querySelector(".extra-image").getAttribute("src");
        let image_back = element.closest(".page_item").querySelector(".preview-icon").getAttribute("data-backimage");
        let page_wrapper = element.closest(".page_item");
        let main_page_wrapper = element.closest(".planner-custom-pages_wrapper");
        let current_year = Number(main_page_wrapper.getAttribute('data-defaultyear'));
        let preview_icon = page_wrapper.querySelector(".preview-icon");
        let multiyear = preview_icon.getAttribute('data-multiyear');
        let pages_length = diary_pages.length;
        let updateType = element.getAttribute('data-updatetype');
        let updated_pages = [];
        if(updateType == 'plus'){
            let day_page_counter = -1;
            for(var i=0 ; i < pages_length ; ++i){
                if(day_page_counter == 7 && diary_pages[i].page_type != "week"){
                    updated_pages.push({page_type: "week", page_url: image_front, year: diary_pages[i].year });
                    if(image_back){
                        updated_pages.push({page_type: "week", page_url: image_back, year: diary_pages[i].year });
                    }
                    day_page_counter = 0;
                }

                if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                    updated_pages.push(diary_pages[i]);
                }

                if(diary_pages[i].page_type == 'day'){
                    if(day_page_counter == -1){
                        let first_day_date = new Date(diary_pages[i].date);
                        day_page_counter = first_day_date.getDay();
                    }else{
                        ++day_page_counter; 
                    }
                }

            }
           
        }else{
