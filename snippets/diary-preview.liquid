    function changePageLayout(){
        
        let target = this.event.target;
        let layout_position = Number(target.getAttribute("data-layoutposition"));
        if(layout_position != currently_selected_layout){
            let diary_loading_spinner = document.querySelector('.diary-loading_spinner');
            diary_loading_spinner.classList.remove('diary-loading-spinner_hidden');
            let layout_pages = all_layouts[layout_position-1];
           
            let page_index = 0;
            let diary_pages_length = diary_pages.length;
          
            for(var i=0;i<diary_pages_length;++i){
                if(diary_pages[i].page_type == "day"){
                    diary_pages[i].page_url = layout_pages[page_index];
                   
                    ++page_index;
                }
            }

          
            
            page_index = 0;
            for(var i=0;i<diary_pages_backup.length;++i){
                if(diary_pages_backup[i].page_type == "day"){
                    diary_pages_backup[i].page_url = layout_pages[page_index];
                    ++page_index;
                }
            }

            let start_date_element = document.getElementById("start_date");
            let end_date_element = document.getElementById("end_date");
            let start_date = start_date_element.value;
            let end_date = end_date_element.value;

            if(start_date || end_date){
                updateDiaryPages();
            }else{
                renderPages();
            }

            setTimeout(function(){
                let diary_loading_spinner = document.querySelector('.diary-loading_spinner');
                diary_loading_spinner.classList.add('diary-loading-spinner_hidden');
            }, 14000);
            
            currently_selected_layout = layout_position;
        }

    }

    function frontCoverPages(element){
        let page_wrapper = element.closest(".page_item");
        let main_page_wrapper = element.closest(".planner-custom-pages_wrapper");
        let current_year = Number(main_page_wrapper.getAttribute('data-defaultyear'));
        let image_front = element.closest(".page_item").querySelector(".extra-image").getAttribute("src");
        let image_back = element.closest(".page_item").querySelector(".preview-icon").getAttribute("data-backimage");
        let preview_icon = page_wrapper.querySelector(".preview-icon");
        let multiyear = preview_icon.getAttribute('data-multiyear');
        let pages_length = diary_pages.length;
        let updated_pages = [];
        let cover_added = false;
        let updateType = element.getAttribute('data-updatetype');
        if(updateType == 'plus'){
            for(var i=0; i<pages_length; ++i){

                
                let page_year = diary_pages[i].year;

                if((multiyear == "true" && page_year && page_year != current_year) || (page_year && page_year != current_year)){
                    cover_added = false;
                }

                if(diary_pages[i].page_type != "outer_cover" && diary_pages[i].page_type != "inner_cover_front" && !cover_added){
                      
                    if(multiyear == "true" && page_year != current_year){
                        let page_number = preview_icon.getAttribute("data-pagenumber");
                        let page_type = preview_icon.getAttribute("data-pagetype");   
                        let target_object_index = multiyear_pages.findIndex((item)=> item.page_type==page_type && item.page_number==page_number && item.year==page_year);
                        image_front = multiyear_pages[target_object_index]?.front_image;
                        image_back = multiyear_pages[target_object_index]?.back_image;
                    }
                    current_year = page_year;
                    cover_added = true;
                    updated_pages.push({page_type: "inner_cover_front", page_url: image_front, date: '', year: page_year });
                    if(image_back){
                        updated_pages.push({page_type: "inner_cover_front", page_url: image_back, date: '', year: page_year });
                    }
                }

                if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                    updated_pages.push(diary_pages[i]);
                }

            }
        }else{
            let noOfRemoved = 0;
            let needToRemove = 1;
            if(image_back){
                needToRemove = 2;
            }

            for(var i=0; i<pages_length; ++i){

                let page_year = diary_pages[i].year;

                if((multiyear == "true" && page_year && page_year != current_year) || (page_year && page_year != current_year)){
                    needToRemove += 1;
                    
                    if(image_back){
                        needToRemove += 1;
                    }
                }
              
                if(multiyear == "true" && page_year && page_year != current_year){
                    let page_number = preview_icon.getAttribute("data-pagenumber");
                    let page_type = preview_icon.getAttribute("data-pagetype");   
                    let target_object_index = multiyear_pages.findIndex((item)=> item.page_type==page_type && item.page_number==page_number && item.year==page_year);
                    image_front = multiyear_pages[target_object_index].front_image;
                    image_back = multiyear_pages[target_object_index].back_image;
                }
            
                if((diary_pages[i].page_url == image_front || diary_pages[i].page_url == image_back)&& diary_pages[i].page_type == 'inner_cover_front' && noOfRemoved < needToRemove){
                     ++noOfRemoved;
                }else{
                    
                    if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                        updated_pages.push(diary_pages[i]);
                    }
                }
                current_year = page_year;
                
            }
        }

        diary_pages = updated_pages;
        renderPages();
    }

    function inBetweenWeekPages(element){
        let image_front = element.closest(".page_item").querySelector(".extra-image").getAttribute("src");
        let image_back = element.closest(".page_item").querySelector(".preview-icon").getAttribute("data-backimage");
        let page_wrapper = element.closest(".page_item");
