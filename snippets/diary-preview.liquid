    function updatePrice(noOfPages){
        
        const myInterval = setInterval(function (){
            let priceTarget = document.querySelector(".price__container .price-item.price-item--regular");
            if(priceTarget){
                let unitPrice = Number(document.querySelector(".custom-planner__price").getAttribute("data-unitprice"));
                let fixedAddedPrice = Number(document.querySelector(".custom-planner__price").getAttribute("data-fixedprice"));
                let excludeWeekends = document.getElementById("exclude_weekends").checked;
                let switch_weekends = document.getElementById("switch_weekends").checked;

                let diary_pages_final2 = [];
                
                    if(excludeWeekends){
                        diary_pages_final2 = structuredClone(diary_pages_no_weekends);
                    }else if(switch_weekends){
                        diary_pages_final2 = structuredClone(diary_pages_half_weekends);
                    }else{
                        diary_pages_final2 = structuredClone(diary_pages);
                    }
               if(diary_pages_final2.length > 0){
                   noOfPages = diary_pages_final2.length;
                }
                let totalPrice = ((noOfPages * unitPrice) + fixedAddedPrice).toFixed(2);
                let globalPriceTarget = document.querySelector('.gp-price');
                priceTarget.innerHTML = "$" + totalPrice + " AUD";
                globalPriceTarget.innerHTML = "$" + totalPrice + " AUD";
                let customPriceProperty = document.getElementById("custom_price");
                customPriceProperty.value = totalPrice;
                let final_unit_price = totalPrice/noOfPages;
                let text_below_price =  document.querySelector(".text-below__price");
                text_below_price.innerHTML = "$" + final_unit_price.toFixed(2) + " per day";
                clearInterval(myInterval);
            }
        }, 100);

    }

