        let multiyear = preview_icon.getAttribute('data-multiyear');
        let pages_length = diary_pages.length;
        let updateType = element.getAttribute('data-updatetype');
        let updated_pages = [];
        if(updateType == 'plus'){
            let day_page_counter = -1;
            for(var i=0 ; i < pages_length ; ++i){
                if(day_page_counter == 7 && diary_pages[i].page_type != "week"){
                    updated_pages.push({page_type: "week", page_url: image_front, year: diary_pages[i].year });
                    if(image_back){
                        updated_pages.push({page_type: "week", page_url: image_back, year: diary_pages[i].year });
                    }
                    day_page_counter = 0;
                }

                if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                    updated_pages.push(diary_pages[i]);
                }

                if(diary_pages[i].page_type == 'day'){
                    if(day_page_counter == -1){
                        let first_day_date = new Date(diary_pages[i].date);
                        day_page_counter = first_day_date.getDay();
                    }else{
                        ++day_page_counter; 
                    }
                }

            }
           
        }else{
            let noOfRemoved = 0;
            let needToRemove = 1;
            if(image_back){
                needToRemove = 2;
            }
           
                for(var i=0; i<pages_length; ++i){
                    if(noOfRemoved < needToRemove){
                        if((diary_pages[i].page_url == image_front || diary_pages[i].page_url == image_back)&& diary_pages[i].page_type == 'week'){
                            ++noOfRemoved;
                        }else{
                            if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                                updated_pages.push(diary_pages[i]);
                            }
                        }
                    }else{
                        if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                            updated_pages.push(diary_pages[i]);
                        }
                        if(diary_pages[i].page_type != "week"){
                            noOfRemoved = 0;
                        }
                    }
                }
        }
        diary_pages = updated_pages;
        renderPages();
    }

    function daysInMonth(month, year) {
        return new Date(year, month, 0).getDate();
    }

    function inBetweenMonthPages(element){
        let image_front = element.closest(".page_item").querySelector(".extra-image").getAttribute("src");
        let image_back = element.closest(".page_item").querySelector(".preview-icon").getAttribute("data-backimage");
        let pages_length = diary_pages.length;
        let updateType = element.getAttribute('data-updatetype');
        let updated_pages = [];
        if(updateType == "plus"){
            let current_month = 1;
            let day_counter = -1;
            let days_in_current_month = 30;
            let current_year = 0;
            for(var i=0; i<pages_length; ++i){
                
                if(day_counter == days_in_current_month){
                    if(diary_pages[i].page_type != "week" && diary_pages[i].page_type != "month"){
                        updated_pages.push({page_type: "month", page_url: image_front, year: diary_pages[i].year });
                        if(image_back){
                            updated_pages.push({page_type: "month", page_url: image_back, year: diary_pages[i].year });
                        }
                        
                        ++current_month
                        days_in_current_month = daysInMonth(current_month, current_year);
                        day_counter = 0
                    }
                }

                if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                    updated_pages.push(diary_pages[i]);
                }

                if(diary_pages[i].page_type == 'day'){
                    let current_date = new Date(diary_pages[i].date);
                    current_year = current_date.getFullYear();
                    if(day_counter == -1){
                        current_month = current_date.getMonth() + 1;
                        days_in_current_month = daysInMonth(current_month, current_date.getFullYear());
                        day_counter = current_date.getDate();
                    }else{
                        ++day_counter;
                        current_year = current_date.getFullYear();
                    }

                }
            }
        }else{
            let noOfRemoved = 0;
            let needToRemove = 1;
            if(image_back){
                needToRemove = 2;
            }
            
            for(var i=0; i<pages_length; ++i){
                if(noOfRemoved < needToRemove){
                    if((diary_pages[i].page_url == image_front || diary_pages[i].page_url == image_back)&& diary_pages[i].page_type == 'month'){
                        ++noOfRemoved;
                    }else{
                        if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                            updated_pages.push(diary_pages[i]);
                        }
                    }
                }else{
                    if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                        updated_pages.push(diary_pages[i]);
                    }
                    if(diary_pages[i].page_type != "month"){
                        noOfRemoved = 0;
                    }
                }
            }
        }
        diary_pages = updated_pages;
        renderPages(); 
    }

    function inBetweenMonthPagesDouble(element){
        let double_pages_index = Number(element.closest('.page_item').getAttribute('data-index'));
        let double_monthly_pages = all_monthly_double_pages[double_pages_index];
        
        let diary_pages_days = diary_pages.filter((page) => page.page_type == "day");
        let start_date = new Date(diary_pages_days[0].date);
        let start_date_month = start_date.getMonth();
        let date_year = start_date.getFullYear();
        let year_gap = 0;
        if(date_year == 2027){
            year_gap = 24;
        }
        let access_index = start_date_month * 2 + year_gap;
        
        if(start_date.getDate() != 1){
            access_index += 2;
        }

        
        let image_front = element.closest(".page_item").querySelector(".extra-image").getAttribute("src");
        let image_back = element.closest(".page_item").querySelector(".preview-icon").getAttribute("data-backimage");
        let pages_length = diary_pages.length;
        let updateType = element.getAttribute('data-updatetype');
        let updated_pages = [];
        if(updateType == "plus"){
            let current_month = start_date_month;
            let day_counter = 1;
            let days_in_current_month = 30;
            let current_year = 0;
            for(var i=0; i<pages_length; ++i){
                let current_date = new Date(diary_pages[i].date);
                day_counter = current_date.getDate();
                if(day_counter == 1){
                   
                        image_front = double_monthly_pages[access_index];
                        image_back = double_monthly_pages[access_index + 1];
                        access_index = access_index + 2;
                        updated_pages.push({page_type: "month", page_url: image_front, page_side: 1, year: diary_pages[i].year });
                        if(image_back){
                            updated_pages.push({page_type: "month", page_url: image_back, page_side: 2, year: diary_pages[i].year });
                        }
                        
                    
                }

                if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                    updated_pages.push(diary_pages[i]);
                }

            }
        }else{
            let front_removed = false;
            let back_removed = false;
            for(var i=0; i<pages_length; ++i){
                    
                    image_front = double_monthly_pages[access_index];
                    image_back = double_monthly_pages[access_index + 1];

                    if((diary_pages[i].page_url == image_front && diary_pages[i+1].page_url == image_back) && diary_pages[i].page_type == 'month'){
                        access_index = access_index + 2;
                        ++i;
                    }else{
                        if(diary_pages[i].page_type != "blank" && diary_pages[i].page_type != "copyright"){
                            updated_pages.push(diary_pages[i]);
                        }
                    }
            }
        }
        diary_pages = updated_pages;
        renderPages();
    }

    function backCoverPages(element){
        let page_wrapper = element.closest(".page_item");
        let main_page_wrapper = element.closest(".planner-custom-pages_wrapper");
        let current_year = '2026';
        let image_front = element.closest(".page_item").querySelector(".extra-image").getAttribute("src");
        let image_back = element.closest(".page_item").querySelector(".preview-icon").getAttribute("data-backimage");
        let preview_icon = page_wrapper.querySelector(".preview-icon");
