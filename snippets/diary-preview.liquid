        if(updateType == "plus"){
            let page_added = true;
            let page_added_2 = false;
            let year_was_changed = false;
            for(var i=0;i<pages_length;++i){
                
                let page_year = diary_pages[i].year;
              
                
                    if((multiyear == "true" && page_year && page_year != current_year) || (page_year && page_year != current_year) || i == diary_pages.length - 1 ){
                        page_added = false;
                        year_was_changed = true;
                    }
                

                if(!page_added){
