<script>
    const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));
   
   function getCurrentPageIndex(isBackward = false) {
        if (isBackward) {
            // When traveling reverse, the truest indicator of where we are 
            // is the very last page that is currently flipped open.
            const lastFlipped = $('.diary-flip_page.flipped').last();
            if (lastFlipped.length) {
                return Number(lastFlipped.data('pageindex'));
            }
            return 1; // If nothing is flipped, we are at the cover
        }

        // Standard Forward Tracking: Look at visible, unflipped pages
        const activePages = $('.diary-flip_page:not(.display__none):not(.flipped)');
        
        if (!activePages.length) {
            return Number($('.diary-flip_page.flipped').last().data('pageindex')) || 1;
        }

        let targetPage = activePages.first();
        let highestZ = parseInt(targetPage.css('z-index'), 10) || 0;

        activePages.each(function () {
            const zIndex = parseInt($(this).css('z-index'), 10) || 0;
            if (zIndex > highestZ) {
                highestZ = zIndex;
                targetPage = $(this);
            }
        });

        return Number(targetPage.data('pageindex'));
    }

   async function flipToPage(targetIndex) {
        let isBackward = targetIndex < getCurrentPageIndex(false);
        let currentIndex = getCurrentPageIndex(isBackward);

        if (currentIndex === targetIndex) {
            return;
        }

        // --- SHOW LOADER ---
        // Use flex so alignment classes inside CSS kick in perfectly
        $('#diaryLoader').css('display', 'flex'); 
        await sleep(1000);
        if (!isBackward) {
            // Moving forward
            while (currentIndex < targetIndex) {
                const availablePages = $('.diary-flip_page:not(.display__none):not(.flipped)');
                let targetPage = null;

                if (availablePages.length === 0) break;
                
                if (availablePages.length === 1) {
                    targetPage = availablePages.first();
                } else {
                    let highestZ = -1;
                    availablePages.each(function() {
                        const zIndex = parseInt($(this).css('z-index'), 10) || 0;
                        if (zIndex > highestZ) {
                            highestZ = zIndex;
                            targetPage = $(this);
                        }
                    });
                }

                if (targetPage && targetPage.find('.diary-flip_next-btn').length) {
                    targetPage.find('.diary-flip_next-btn').trigger('click');
                } else {
                    break;
                }

                let previousIndex = currentIndex;
                currentIndex = getCurrentPageIndex(false);
                if (currentIndex === previousIndex) break; 
            }
        } else {
            // Moving backward
            while (currentIndex > targetIndex) {
                const lastFlippedPage = $('.diary-flip_page.flipped').last();

                if (lastFlippedPage.length && lastFlippedPage.find('.diary-flip_back-btn').length) {
                    lastFlippedPage.find('.diary-flip_back-btn').trigger('click');
                } else {
                    break;
                }

                let previousIndex = currentIndex;
                currentIndex = getCurrentPageIndex(true);
                if (currentIndex === previousIndex) break; 
            }
        }

        // --- HIDE LOADER ---
        // Delay slightly (e.g., 200ms) for visual smoothness if desired, or hide instantly:
        $('#diaryLoader').hide();
    }

    function jumpToDate() {
        // 1. Grab the date string from the input field
        const dateString = $('#jumpDate').val();

        // 2. Alert the user if they clicked "Go" without picking a date
        if (!dateString) {
            alert('Please select a date first.');
            return;
        }

        // 3. Find the page that matches the selected date
        const page = $('.diary-flip_page').filter(function () {
            return $(this).find(`img[data-date="${dateString}"]`).length > 0;
        }).first();

        // 4. Handle case where the date doesn't exist in the diary
        if (!page.length) {
            alert('Date not found');
            return;
        }

        // 5. Flip to the page (ensuring the index is a number)
        flipToPage(Number(page.data('pageindex')));
    }

    

  function jumpToPageNumber() {
        // 1. Grab the closest input value relative to the nav-group layout
        const targetPageInput = $('.nav-group input[type="number"]').val();
        const targetIndex = Number(targetPageInput);

        // 2. Alert the user if they clicked "Go" without entering a number
        if (!targetPageInput || isNaN(targetIndex) || targetIndex <= 0) {
            alert('Please enter a valid page number first.');
            return;
        }

        // 3. Look for the page element matching the page index
        const targetPage = $(`.diary-flip_page[data-pageindex="${targetIndex}"]`);

        // 4. Handle case where the page number doesn't exist in the DOM
        if (!targetPage.length) {
            alert(`Page ${targetIndex} not found in the diary.`);
            return;
        }

        // 5. Trigger the automated navigation loop until the target is reached
        flipToPage(targetIndex);
    }

    /**
 * Skips N pages forward or backward relative to the current active page
 * @param {string} direction - Either 'forward' or 'backward'
 */
    function skipPages(direction) {
        // 1. Grab the raw value from the skip input
        const skipValue = $('#skipPageCount').val();
        const pagesToSkip = parseInt(skipValue, 10);

        // 2. Validate the user actually put a proper positive number
        if (!skipValue || isNaN(pagesToSkip) || pagesToSkip <= 0) {
            alert('Please enter a valid number of pages to skip.');
            return;
        }

        // 3. Find out exactly where the diary is positioned right now
        // We use false here to look at the forward-facing page profile baseline
        const currentIndex = getCurrentPageIndex(false);
        let targetIndex = currentIndex;

        // 4. Calculate the target page index based on direction
        if (direction === 'forward') {
            targetIndex = currentIndex + pagesToSkip;
        } else if (direction === 'backward') {
            targetIndex = currentIndex - pagesToSkip;
        }

        // 5. Constrain the target index so it doesn't try to go past the actual pages available
        const totalPages = $('.diary-flip_page').length;
        
        if (targetIndex > totalPages) {
            targetIndex = totalPages; // Snap to the final page
        }
        if (targetIndex < 1) {
            targetIndex = 1; // Snap to the cover page
        }

        // 6. If the calculated destination is different from where we are, travel!
        if (targetIndex === currentIndex) {
            alert(direction === 'forward' ? 'You are already at the end.' : 'You are already at the beginning.');
            return;
        }

        flipToPage(targetIndex);
    }

    function updateDiaryPages(){
        let start_date_element = document.getElementById("start_date");
        let end_date_element = document.getElementById("end_date");
        let start_date = start_date_element.value;
        let end_date = end_date_element.value;
     
