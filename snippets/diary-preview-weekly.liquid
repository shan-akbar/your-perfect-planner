}

.diary-flip{
    align-self: flex-end;
}

.diary-wrapper{
    align-items: center;
    flex-direction: column;
}

/* The background dim layer */
.diary-travel-loader {
    display: none; /* Hidden by default */
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(255, 255, 255, 0.7); /* Light white tint */
    backdrop-filter: blur(4px); /* Sleek modern blur effect */
    z-index: 99999; /* Ensure it covers everything */
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 12px;
    font-family: inherit;
    transition: opacity 0.3s ease;
}

/* Elegant CSS Spinner */
.diary-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(0, 0, 0, 0.1);
    border-top-color: #000; /* Match your diary's accent color here */
    border-radius: 50%;
    animation: diarySpin 0.8s linear infinite;
}

.diary-loader-text {
    font-size: 14px;
    color: #333;
    font-weight: 500;
    letter-spacing: 0.5px;
}

