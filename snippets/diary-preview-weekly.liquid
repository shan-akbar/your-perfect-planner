<script>

   const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));

/**
 * Returns the active 1-based physical page leaf index.
 * With our virtual engine, our global pointer is the source of absolute truth!
 */
function getCurrentPageIndex(isBackward = false) {
    return current_physical_page + 1;
}

/**
 * Sweeps to a target 1-based physical page spread cleanly using data references
 * @param {number} targetIndex - 1-based physical leaf index destination
 */
async function flipToPage(targetIndex) {
    const targetPhysicalPage = targetIndex - 1;
    
    // Safety check: if already positioned at destination, exit early
    if (targetPhysicalPage === current_physical_page) return;

    // --- 1. SHOW LOADER ---
    const $loader = $('#diaryLoader, .diary-loading_spinner');
    $loader.css('display', 'flex').removeClass('diary-loading-spinner_hidden'); 

    await sleep(1000); // Shorter, crisper load delay for virtual execution
    await new Promise(resolve => requestAnimationFrame(resolve));

    // --- 2. UPDATE ENGINE STATE DIRECTLY ---
    current_physical_page = targetPhysicalPage;
    updateDOMWindow();

    // --- 3. FORCE DOM LAYOUT RE-PAINT AND CLEANUP ---
    void document.body.offsetHeight; 
    await sleep(1000);
    
    // --- HIDE LOADER ---
    $loader.hide().addClass('diary-loading-spinner_hidden');
}

/**
 * Weekly Proximity Engine: Evaluates dates entirely inside the data array 
 * to find and navigate to the nearest active week page.
 */
function jumpToDate() {
    // 1. Grab the date string from the input field
    const dateString = $('#jumpDate').val();

    if (!dateString) {
        alert('Please select a date first.');
        return;
    }

    const userDate = new Date(dateString + 'T00:00:00');

    // 2. Extract all valid dates from the data array to find the true bounds
    const validDates = diary_pages
        .filter(page => page.date)
        .map(page => new Date(page.date + 'T00:00:00'))
        .filter(d => !isNaN(d.getTime()));

    if (!validDates.length) {
        alert('No dated layouts found in this planner configuration.');
        return;
    }

    // 3. Find the absolute minimum and maximum dates available
    const minDate = new Date(Math.min(...validDates));
    const maxDate = new Date(Math.max(...validDates));

    // 4. FIX: Strict Out-of-Bounds Check
    if (userDate < minDate || userDate > maxDate) {
        alert("Selected date is out of the planner's range.");
        return;
    }

    // 5. Proximity Search (Only runs if the date passes the boundary check)
    let closestDataIndex = -1;
    let closestDiff = Infinity;

    diary_pages.forEach((page, index) => {
        if (page.date) {
            const pageDate = new Date(page.date + 'T00:00:00');
            
            if (!isNaN(pageDate.getTime())) {
                const diff = Math.abs(userDate - pageDate);
                
                if (diff < closestDiff) {
                    closestDiff = diff;
                    closestDataIndex = index;
                }
            }
        }
    });

    // 6. Convert structural array index into a 1-based physical leaf number and turn pages
    if (closestDataIndex !== -1) {
        const targetIndex = Math.floor(closestDataIndex / 2) + 1;
        flipToPage(targetIndex);
    }
}

/**
 * Navigates directly to a specific page number entered by the user
 */
function jumpToPageNumber() {
    // 1. Grab the user value and convert to 1-based physical leaf index
    const targetPageInput = $('.nav-group input[type="number"]').val();
    const targetIndex = Math.ceil(Number(targetPageInput) / 2);

    if (!targetPageInput || isNaN(targetIndex)) {
        alert('Please enter a valid page number first.');
        return;
    }

    // 2. Dynamic Min/Max bounds check using data array length
    const minPage = 1;
    const maxPage = Math.ceil(diary_pages.length / 2);

    if (targetIndex < minPage) {
        alert(`Invalid page number. The minimum page number you can enter is ${minPage}.`);
        return;
    }

    if (targetIndex > maxPage) {
        alert(`Invalid page number. The maximum page number available in this diary is ${maxPage * 2}.`);
        return;
    }

    // 3. Trigger the automated navigation pipeline
    flipToPage(targetIndex);
}

/**
 * Skips N pages forward or backward relative to the current active position
 * @param {string} direction - Either 'forward' or 'backward'
 */
function skipPages(direction) {
    // 1. Grab value and calculate requested physical leaf skip distance
    const skipValue = $('#skipPageCount').val();
    const pagesToSkip = Math.ceil(parseInt(skipValue, 10) / 2);

    if (!skipValue || isNaN(pagesToSkip) || pagesToSkip <= 0) {
        alert('Please enter a valid number of pages to skip.');
        return;
    }

    // 2. Find internal position and compute target
    const currentIndex = getCurrentPageIndex(false);
    let targetIndex = currentIndex;

    if (direction === 'forward') {
        targetIndex = currentIndex + pagesToSkip;
    } else if (direction === 'backward') {
        targetIndex = currentIndex - pagesToSkip;
    }

    // 3. Boundary validation limits against data arrays
    const minPage = 1;
    const maxPage = Math.ceil(diary_pages.length / 2);

    if (direction === 'forward' && targetIndex > maxPage) {
        alert(`Cannot skip forward. This jump exceeds the maximum page number (${maxPage * 2}).`);
        return;
    }

    if (direction === 'backward' && targetIndex < minPage) {
        alert(`Cannot skip backward. This jump drops below the minimum page number (${minPage}).`);
        return;
    }

    if (targetIndex === currentIndex) {
        alert(direction === 'forward' ? 'You are already at the end.' : 'You are already at the beginning.');
        return;
    }

    flipToPage(targetIndex);
}
    // --- GLOBAL VIRTUAL ENGINE STATE ---
    let current_physical_page = 0; // Tracks active index (0 to diary_pages.length / 2)
    let is_animating = false;      // Animation block lock
    const FLIP_ANIMATION_SPEED = 600; // MUST match your CSS 3D flip duration in milliseconds!

    /**
     * Re-indexes, formats, stacks, and assigns values to the 5 DOM elements 
     * based on the position of current_physical_page.
     */
    function updateDOMWindow() {
        let pages_preview = document.querySelectorAll(".diary-flip_page");
        let total_physical_pages = Math.ceil(diary_pages.length / 2);

        // 1. Turn off CSS transition parameters so swapping structural values is invisible
        pages_preview.forEach(page => { page.style.transition = 'none'; });

        // 2. Loop through the 5 DOM frames and arrange them relative to our center point
        pages_preview.forEach((page, domIndex) => {
            // domIndex 2 (the middle item) behaves as our active right-side container
            let logical_index = current_physical_page + (domIndex - 2);

            // Hide containers out of boundaries
            if (logical_index < 0 || logical_index >= total_physical_pages) {
                page.classList.add('display__none');
                return;
            }

            page.classList.remove('display__none');
            page.setAttribute('data-pageindex', logical_index + 1);

            // Set structural conditional classes dynamically
            page.classList.remove('last__page', 'second_last__page');
            if (logical_index === total_physical_pages - 1) {
                page.classList.add('last__page');
            } else if (logical_index === total_physical_pages - 2) {
                page.classList.add('second_last__page');
            }

            // 3. Stacking Calculations (z-index) & Spatial state assignment
            if (logical_index < current_physical_page) {
                // Already turned pages (Left stack)
                page.classList.add('flipped');
                page.style.zIndex = logical_index + 1; 
            } else {
                // Remaining pages (Right stack)
                page.classList.remove('flipped');
                page.style.zIndex = total_physical_pages - logical_index; 
            }

            // 4. Update image assets and semantic attributes
            let side_index = logical_index * 2;
            let front_data = diary_pages[side_index] || { page_url: '' };
            let back_data = diary_pages[side_index + 1] || { page_url: '' };

            page.querySelector(".front-page").setAttribute("src", front_data.page_url);
            page.querySelector(".back-page").setAttribute("src", back_data.page_url);

            if (front_data.page_type === 'day') {
                page.querySelector(".front-page").setAttribute("data-date", front_data.date);
                page.querySelector(".front-page").setAttribute("data-dayname", front_data.day_name);
            } else {
                page.querySelector(".front-page").removeAttribute("data-date");
                page.querySelector(".front-page").removeAttribute("data-dayname");
            }

            if (back_data.page_type === 'day') {
                page.querySelector(".back-page").setAttribute("data-date", back_data.date);
                page.querySelector(".back-page").setAttribute("data-dayname", back_data.day_name);
            } else {
                page.querySelector(".back-page").removeAttribute("data-date");
                page.querySelector(".back-page").removeAttribute("data-dayname");
            }
        });

        // 5. Hard repaint flush so values adapt instantly before transitions restore
        void document.body.offsetHeight;

        // 6. Restore normal CSS animations
        pages_preview.forEach(page => { page.style.transition = ''; });
    }


    function updateDiaryPages(){
        let start_date_element = document.getElementById("start_date");
        let end_date_element = document.getElementById("end_date");
        let start_date = start_date_element.value;
        let end_date = end_date_element.value;
        if(!start_date){
            start_date = document.querySelector('.planner-date__range').getAttribute('data-startdate');
        }

        if(!end_date){
            end_date = document.querySelector('.planner-date__range').getAttribute('data-enddate');
        }
        
        start_date = new Date(start_date);
        end_date = new Date(end_date);

        let updated_pages = [];
        let pages_length = diary_pages_backup.length;
        for(var i=0; i<pages_length; ++i){ 
            
            if(diary_pages_backup[i].page_type == 'day'){
                let current_page_date = new Date(diary_pages_backup[i].date);
                if(current_page_date >= start_date && current_page_date <= end_date){
                    updated_pages.push(diary_pages_backup[i]);
                }
            }else{
                let cloneObj = JSON.parse(JSON.stringify(diary_pages_backup[i]));
                cloneObj.year = start_date.getFullYear();
                updated_pages.push(cloneObj);
            }
        }

        diary_pages = updated_pages;

    

        let inputs = document.querySelectorAll('input[type=number].page-qty__input ');
 
        for (let i = 0; i < inputs.length; i++) {
            inputs[i].value = 0;
        }

        renderPages();

    }

    function handleDateRangeChange(){

        let target = this.event.target;
        let start_date_element = document.getElementById("start_date");
        let end_date_element = document.getElementById("end_date");
        let start_date = start_date_element.value;
        let end_date = end_date_element.value;

        let start_date_fixed = document.querySelector('.planner-date__range').getAttribute('data-startdate');
        let end_date_fixed = document.querySelector('.planner-date__range').getAttribute('data-enddate');

        let start_date_obj = new Date(start_date);
        let end_date_obj = new Date(end_date);
        let start_date_fixed_obj = new Date(start_date_fixed);
        let end_date_fixed_obj = new Date(end_date_fixed);
        
        let error__message = document.querySelector(".date-range-error__message");
        if(start_date_obj > end_date_obj || start_date_obj < start_date_fixed_obj || end_date_obj > end_date_fixed_obj || (!start_date || !end_date)){
            
            error__message.style.display = "block";
            if(target.isSameNode(start_date_element)){
                start_date_element.value = end_date_element.value;
                error__message.innerHTML = "Start Date canot be after the end date!"
            }else{
                end_date_element.value = start_date_element.value;
                error__message.innerHTML = "End Date canot be before the start date!"
            }

            if(start_date_obj < start_date_fixed_obj){
                start_date_element.value = start_date_fixed;
                error__message.innerHTML = "Start Date cannot be older then " + start_date_fixed;
            }

            if(end_date_obj > end_date_fixed_obj){
                end_date_element.value = end_date_fixed;
                error__message.innerHTML = "End Date cannot be larger then " + end_date_fixed;
            }

             if(!start_date || !end_date){
               error__message.innerHTML = "Invalid date selected.";
            }

            

            setTimeout(
                function(error__message) {
                    document.querySelector(".date-range-error__message").style.display = "none";
                }, 5000
            );

        }else{
            error__message.style.display = "none";
            updateDiaryPages();
        }

    }

    function isEvenNumber(number){
        if(number % 2 == 0) {
            return true;
        }else{
            return false;
        }
    }

    function remove_neutral_pages(){
        let pages_length = diary_pages.length;
        let updated_pages = [];
        for(var i=0;i<pages_length;++i){
            if(diary_pages[i].page_type != 'neutral_page' && diary_pages[i].page_type != 'copyright'){
                updated_pages.push(diary_pages[i]);
            }
        }

        diary_pages = updated_pages;
    }
    
    function neutralize_pages(){
        let updated_pages = [];
        let pages_length = diary_pages.length;
        let page_step = 1;
        let new_index = 0;
        let current_layout = all_layouts[currently_selected_layout - 1];
        let current_layout_pages_length_half = current_layout.length / 2;
        if(current_layout_pages_length_half > 40){
            for(var i=0; i<pages_length; ++i){
                if(diary_pages[i].page_type == 'day'){
                    
                    if(isEvenNumber(new_index) && page_step == 1){
                        
                        updated_pages.push({
                            page_type: 'neutral_page', 
                            date: '' ,
                            year: diary_pages[i].year,
                            page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668"
                        });

                        ++new_index;
                    }

                    ++page_step;

                    if(page_step == 3){
                        page_step = 1;
                    }
                }
                    if(isEvenNumber(new_index) && diary_pages[i].page_side == 1){
                
                        updated_pages.push({
                            page_type: 'neutral_page', 
                            date: '' ,
                            year: diary_pages[i].year,
                            page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668"
                        });

                        ++new_index;
                    }
                    updated_pages.push(diary_pages[i]);
                    ++new_index;
            }

            diary_pages = updated_pages;

        }else{
            let new_updated_pages = [];
            new_index = 0;
            pages_length = diary_pages.length;
            for(var i=0; i<pages_length; ++i){
                
                if(isEvenNumber(new_index) && diary_pages[i].page_side == 1){
                    
                    new_updated_pages.push({
                        page_type: 'neutral_page', 
                        date: '' ,
                        year: diary_pages[i].year,
                        page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668"
                    });

                    ++new_index;
                }

                new_updated_pages.push(diary_pages[i]);
                ++new_index;
            }
            diary_pages = new_updated_pages;
        }

       
    }

    function renderPages() {
        // 1. Core data cleanup routines
        remove_neutral_pages();
        neutralize_pages();
        
        let end_date_3 = document.querySelector('#end_date').value;
        let end_date_obj_3 = new Date(end_date_3);
        let current_year = end_date_obj_3.getFullYear().toString();
        
        // 2. Inject structural pages into data array
        diary_pages.splice(diary_pages.length - 1, 0, {
            page_type: "copyright", 
            page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/COPYRIGHT_PAGE_2024.png?v=1732746669",
            year: current_year 
        });
        
        if (diary_pages.length % 2 != 0) {
            diary_pages.splice(diary_pages.length - 2, 0, {
                page_type: "blank", 
                page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668",
                year: current_year 
            });
        }

        // --- VIRTUAL SLIDING WINDOW ENGINE HOOK ---
        // Resets the virtual active pointer back to the starting page and refreshes the 5 DOM layers
        current_physical_page = 0; 
        updateDOMWindow();
        // ------------------------------------------

        // 3. Evaluate total layout thresholds and limitations safely using array sizes
        let pages_limit_div = document.querySelector('.pages-limit__description');
        let pages_limit = Number(pages_limit_div.getAttribute("data-pageslimit"));
        
        if (diary_pages.length > pages_limit) {
            pages_limit_div.style.display = 'block';
            let pages_number_message = document.querySelector("#no_of_pages");
            pages_number_message.innerHTML = diary_pages.length;
        } else {
            pages_limit_div.style.display = 'none';
        }

        // 4. Update pricing properties
        updatePrice(diary_pages.length);

        // 5. Calculate navigation bounds from data limits instead of a physical DOM crawl
        let last_page_index = diary_pages.length;
        let pn_label = document.querySelector('.pn-label');
        pn_label.innerHTML = `Page Number (1-${last_page_index})`;
    }

    function splitDiary(){
        let checked = this.event.target.checked;
        let fixedprice = Number(document.querySelector(".custom-planner__price").getAttribute("data-fixedprice"));
        let pageLimitProperty = document.getElementById("pages_limit_property");
        pageLimitProperty.value = checked;
        let pages_limit_div = document.querySelector('.pages-limit__description');
        let split_price = Number(pages_limit_div.getAttribute("data-splitprice"));
        
        if(split_price > 0){
            if(checked){
                fixedprice = fixedprice + split_price;
            }else{
                fixedprice = fixedprice - split_price;
            }
        }
        
        document.querySelector(".custom-planner__price").setAttribute("data-fixedprice", fixedprice);
        updatePrice(diary_pages.length);
    }

    function updatePrice(noOfPages){
    
        const myInterval = setInterval(function (){
            let priceTarget = document.querySelector(".price__container .price-item.price-item--regular");
            if(priceTarget){
                
                let unitPrice = Number(document.querySelector(".custom-planner__price").getAttribute("data-unitprice"));
                let fixedAddedPrice = Number(document.querySelector(".custom-planner__price").getAttribute("data-fixedprice"));
                
                let totalPrice = ((noOfPages * unitPrice) + fixedAddedPrice).toFixed(2);
                priceTarget.innerHTML = "$" + totalPrice + " AUD";
                let globalPriceTarget = document.querySelector('.gp-price');
                globalPriceTarget.innerHTML = "$" + totalPrice + " AUD";
                let customPriceProperty = document.getElementById("custom_price");
                customPriceProperty.value = totalPrice;
                let final_unit_price = totalPrice/noOfPages;
                let text_below_price =  document.querySelector(".text-below__price");
                text_below_price.innerHTML = "$" + final_unit_price.toFixed(2) + " per day";
                clearInterval(myInterval);
            }
        }, 100);

    }

