<script>

   const sleep = (ms) => new Promise(resolve => setTimeout(resolve, ms));
   
   function getCurrentPageIndex(isBackward = false) {
        if (isBackward) {
            // When traveling reverse, the truest indicator of where we are 
            // is the very last page that is currently flipped open.
            const lastFlipped = $('.diary-flip_page.flipped').last();
            if (lastFlipped.length) {
                return Number(lastFlipped.data('pageindex'));
            }
            return 1; // If nothing is flipped, we are at the cover
        }

        // Standard Forward Tracking: Look at visible, unflipped pages
        const activePages = $('.diary-flip_page:not(.display__none):not(.flipped)');
        
        if (!activePages.length) {
            return Number($('.diary-flip_page.flipped').last().data('pageindex')) || 1;
        }

        let targetPage = activePages.first();
        let highestZ = parseInt(targetPage.css('z-index'), 10) || 0;

        activePages.each(function () {
            const zIndex = parseInt($(this).css('z-index'), 10) || 0;
            if (zIndex > highestZ) {
                highestZ = zIndex;
                targetPage = $(this);
            }
        });

        return Number(targetPage.data('pageindex'));
    }

  async function flipToPage(targetIndex) {
        let isBackward = targetIndex < getCurrentPageIndex(false);
        let currentIndex = getCurrentPageIndex(isBackward);

        if (currentIndex === targetIndex) return;

        // --- 1. SHOW LOADER ---
        $('#diaryLoader').css('display', 'flex'); 

        await sleep(1000);

        // Drop out of the current execution frame to let the mobile browser cleanly render the spinner
        await new Promise(resolve => requestAnimationFrame(resolve));

        const $diaryContainer = $('.diary-flip');
    
        // --- 2. KILL 3D/TRANSITIONS INSTANTLY VIA PARENT ---
        $diaryContainer.addClass('diary-flip--instant-jump');

        const $allPages = $('.diary-flip_page');

        // --- 3. RUN THE FLIP LOGIC DIRECTLY IN MEMORY (NO CLICKS) ---
        if (!isBackward) {
            // Moving Forward: Loop through the pages that need to be flipped
            $allPages.each(function() {
                const pageIdx = Number($(this).data('pageindex'));
                
                if (pageIdx >= currentIndex && pageIdx < targetIndex) {
                    // This page needs to be flipped forward
                    if (!$(this).hasClass('flipped')) {
                        $(this).addClass('flipped');
                        // Replicate the zIndex switch logic directly
                        let current_zindex = parseInt($(this).css('z-index'), 10) || 0;
                        $(this).css('z-index', 6000 - current_zindex);
                    }
                }
            });
        } else {
            // Moving Backward: Loop through the pages that need to be unflipped
            // Process in reverse order to cleanly mimic un-flipping stack behavior
            $($allPages.get().reverse()).each(function() {
                const pageIdx = Number($(this).data('pageindex'));
                
                if (pageIdx >= targetIndex && pageIdx < currentIndex) {
                    // This page needs to be flipped backward
                    if ($(this).hasClass('flipped')) {
                        $(this).removeClass('flipped');
                        // Replicate the zIndex switch logic directly
                        let current_zindex = parseInt($(this).css('z-index'), 10) || 0;
                        $(this).css('z-index', 6000 - current_zindex);
                    }
                }
            });
        }

        // --- 4. BULK FIX VISIBILITY (.display__none) ---
        // Instead of sequentially toggling neighboring pages step-by-step, 
        // we calculate the ultimate visibility states based on the final targetIndex.
        let target_prev = targetIndex - 3;
        let target_next = targetIndex + 2;

        $allPages.each(function() {
            const pageIdx = Number($(this).data('pageindex'));

            // Replicate your visibility boundaries instantly
            if (pageIdx <= target_prev) {
                $(this).addClass('display__none');
            } else if (pageIdx >= target_next) {
                $(this).addClass('display__none');
            } else {
                // Keep the active view window visible
                if (!($(this).hasClass("second_last__page") || $(this).hasClass("last__page") && pageIdx === target_next)) {
                    $(this).removeClass('display__none');
                }
            }
        });

        // --- 5. CLEAN UP & RESTORE ---
        // Force a minor DOM layout flush so the browser processes the updates in one clean layout sweep
        void document.body.offsetHeight; 
        await sleep(1000);
        // Remove the safety class so single manual page clicks still work smoothly
        $diaryContainer.removeClass('diary-flip--instant-jump');
    
        // --- HIDE LOADER ---
        $('#diaryLoader').hide();
    }

    function jumpToDate() {
        // 1. Grab the date string from the input field
        const dateString = $('#jumpDate').val();

        // 2. Alert the user if they clicked "Go" without picking a date
        if (!dateString) {
            alert('Please select a date first.');
            return;
        }

        // Convert user input to a Date object (set to midnight for clean comparison)
        const userDate = new Date(dateString + 'T00:00:00');

        // 3. Find all elements that have a data-date attribute
        const allDateElements = $('.diary-flip_page img[data-date]');

        if (!allDateElements.length) {
            alert('No planner dates found.');
            return;
        }

        // 4. Get the boundary dates (First and Last elements)
        const firstDateStr = allDateElements.first().attr('data-date');
        const lastDateStr = allDateElements.last().attr('data-date');

        const firstDate = new Date(firstDateStr + 'T00:00:00');
        const lastDate = new Date(lastDateStr + 'T00:00:00');

        // 5. Check if the user's date is within the bounds
        if (userDate < firstDate || userDate > lastDate) {
            alert('Selected date is out of the planner\'s range.');
            return;
        }

        // 6. Find the closest weekly page
        let targetPage = null;
        let closestDiff = Infinity;

        $('.diary-flip_page').each(function () {
            const pageImg = $(this).find('img[data-date]');
            if (pageImg.length) {
                const pageDateStr = pageImg.attr('data-date');
                const pageDate = new Date(pageDateStr + 'T00:00:00');

                // Calculate absolute difference in milliseconds
                const diff = Math.abs(userDate - pageDate);

                // Track the page with the smallest difference (nearest date)
                if (diff < closestDiff) {
                    closestDiff = diff;
                    targetPage = $(this);
                }
            }
        });

        // 7. Flip to the page if found
        if (targetPage && targetPage.length) {
            flipToPage(Number(targetPage.data('pageindex')));
        } else {
            alert('Date not found');
        }
    }

    

  function jumpToPageNumber() {
        // 1. Grab the closest input value relative to the nav-group layout
        const targetPageInput = $('.nav-group input[type="number"]').val();
        const targetIndex = Number(targetPageInput);

        // 2. Alert the user if they clicked "Go" without entering a number
        if (!targetPageInput || isNaN(targetIndex) || targetIndex <= 0) {
            alert('Please enter a valid page number first.');
            return;
        }

        // 3. Look for the page element matching the page index
        const targetPage = $(`.diary-flip_page[data-pageindex="${targetIndex}"]`);

        // 4. Handle case where the page number doesn't exist in the DOM
        if (!targetPage.length) {
            alert(`Page ${targetIndex} not found in the diary.`);
            return;
        }

        // 5. Trigger the automated navigation loop until the target is reached
        flipToPage(targetIndex);
    }

    /**
 * Skips N pages forward or backward relative to the current active page
 * @param {string} direction - Either 'forward' or 'backward'
 */
    function skipPages(direction) {
        // 1. Grab the raw value from the skip input
        const skipValue = $('#skipPageCount').val();
        const pagesToSkip = parseInt(skipValue, 10);

        // 2. Validate the user actually put a proper positive number
        if (!skipValue || isNaN(pagesToSkip) || pagesToSkip <= 0) {
            alert('Please enter a valid number of pages to skip.');
            return;
        }

        // 3. Find out exactly where the diary is positioned right now
        // We use false here to look at the forward-facing page profile baseline
        const currentIndex = getCurrentPageIndex(false);
        let targetIndex = currentIndex;

        // 4. Calculate the target page index based on direction
        if (direction === 'forward') {
            targetIndex = currentIndex + pagesToSkip;
        } else if (direction === 'backward') {
            targetIndex = currentIndex - pagesToSkip;
        }

        // 5. Constrain the target index so it doesn't try to go past the actual pages available
        const totalPages = $('.diary-flip_page').length;
        
        if (targetIndex > totalPages) {
            targetIndex = totalPages; // Snap to the final page
        }
        if (targetIndex < 1) {
            targetIndex = 1; // Snap to the cover page
        }

        // 6. If the calculated destination is different from where we are, travel!
        if (targetIndex === currentIndex) {
            alert(direction === 'forward' ? 'You are already at the end.' : 'You are already at the beginning.');
            return;
        }

        flipToPage(targetIndex);
    }

    function updateDiaryPages(){
        let start_date_element = document.getElementById("start_date");
        let end_date_element = document.getElementById("end_date");
        let start_date = start_date_element.value;
        let end_date = end_date_element.value;
        if(!start_date){
            start_date = document.querySelector('.planner-date__range').getAttribute('data-startdate');
        }

        if(!end_date){
            end_date = document.querySelector('.planner-date__range').getAttribute('data-enddate');
        }
        
        start_date = new Date(start_date);
        end_date = new Date(end_date);

        let updated_pages = [];
        let pages_length = diary_pages_backup.length;
        for(var i=0; i<pages_length; ++i){ 
            
            if(diary_pages_backup[i].page_type == 'day'){
                let current_page_date = new Date(diary_pages_backup[i].date);
                if(current_page_date >= start_date && current_page_date <= end_date){
                    updated_pages.push(diary_pages_backup[i]);
                }
            }else{
                let cloneObj = JSON.parse(JSON.stringify(diary_pages_backup[i]));
                cloneObj.year = start_date.getFullYear();
                updated_pages.push(cloneObj);
            }
        }

        diary_pages = updated_pages;

    

        let inputs = document.querySelectorAll('input[type=number].page-qty__input ');
 
        for (let i = 0; i < inputs.length; i++) {
            inputs[i].value = 0;
        }

        renderPages();

    }

    function handleDateRangeChange(){

        let target = this.event.target;
        let start_date_element = document.getElementById("start_date");
        let end_date_element = document.getElementById("end_date");
        let start_date = start_date_element.value;
        let end_date = end_date_element.value;

        let start_date_fixed = document.querySelector('.planner-date__range').getAttribute('data-startdate');
        let end_date_fixed = document.querySelector('.planner-date__range').getAttribute('data-enddate');

        let start_date_obj = new Date(start_date);
        let end_date_obj = new Date(end_date);
        let start_date_fixed_obj = new Date(start_date_fixed);
        let end_date_fixed_obj = new Date(end_date_fixed);
        
        let error__message = document.querySelector(".date-range-error__message");
        if(start_date_obj > end_date_obj || start_date_obj < start_date_fixed_obj || end_date_obj > end_date_fixed_obj || (!start_date || !end_date)){
            
            error__message.style.display = "block";
            if(target.isSameNode(start_date_element)){
                start_date_element.value = end_date_element.value;
                error__message.innerHTML = "Start Date canot be after the end date!"
            }else{
                end_date_element.value = start_date_element.value;
                error__message.innerHTML = "End Date canot be before the start date!"
            }

            if(start_date_obj < start_date_fixed_obj){
                start_date_element.value = start_date_fixed;
                error__message.innerHTML = "Start Date cannot be older then " + start_date_fixed;
            }

            if(end_date_obj > end_date_fixed_obj){
                end_date_element.value = end_date_fixed;
                error__message.innerHTML = "End Date cannot be larger then " + end_date_fixed;
            }

             if(!start_date || !end_date){
               error__message.innerHTML = "Invalid date selected.";
            }

            

            setTimeout(
                function(error__message) {
                    document.querySelector(".date-range-error__message").style.display = "none";
                }, 5000
            );

        }else{
            error__message.style.display = "none";
            updateDiaryPages();
        }

    }

    function isEvenNumber(number){
        if(number % 2 == 0) {
            return true;
        }else{
            return false;
        }
    }

    function remove_neutral_pages(){
        let pages_length = diary_pages.length;
        let updated_pages = [];
        for(var i=0;i<pages_length;++i){
            if(diary_pages[i].page_type != 'neutral_page' && diary_pages[i].page_type != 'copyright'){
                updated_pages.push(diary_pages[i]);
            }
        }

        diary_pages = updated_pages;
    }
    
    function neutralize_pages(){
        let updated_pages = [];
        let pages_length = diary_pages.length;
        let page_step = 1;
        let new_index = 0;
        let current_layout = all_layouts[currently_selected_layout - 1];
        let current_layout_pages_length_half = current_layout.length / 2;
        if(current_layout_pages_length_half > 40){
            for(var i=0; i<pages_length; ++i){
                if(diary_pages[i].page_type == 'day'){
                    
                    if(isEvenNumber(new_index) && page_step == 1){
                        
                        updated_pages.push({
                            page_type: 'neutral_page', 
                            date: '' ,
                            year: diary_pages[i].year,
                            page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668"
                        });

                        ++new_index;
                    }

                    ++page_step;

                    if(page_step == 3){
                        page_step = 1;
                    }
                }
                    if(isEvenNumber(new_index) && diary_pages[i].page_side == 1){
                
                        updated_pages.push({
                            page_type: 'neutral_page', 
                            date: '' ,
                            year: diary_pages[i].year,
                            page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668"
                        });

                        ++new_index;
                    }
                    updated_pages.push(diary_pages[i]);
                    ++new_index;
            }

            diary_pages = updated_pages;

        }else{
            let new_updated_pages = [];
            new_index = 0;
            pages_length = diary_pages.length;
            for(var i=0; i<pages_length; ++i){
                
                if(isEvenNumber(new_index) && diary_pages[i].page_side == 1){
                    
                    new_updated_pages.push({
                        page_type: 'neutral_page', 
                        date: '' ,
                        year: diary_pages[i].year,
                        page_url: "//cdn.shopify.com/s/files/1/0870/1021/4194/files/BLANK_LINES.png?v=1732746668"
                    });

                    ++new_index;
                }

                new_updated_pages.push(diary_pages[i]);
                ++new_index;
            }
            diary_pages = new_updated_pages;
        }

       
    }

